# Swagger / OpenAPI configuration for Swashbuckle.AspNetCore
# Set to true to enable Swagger UI at /swagger
SWAGGER_ENABLED=true

# Specify the document title for Swagger UI
SWAGGER_TITLE=My API

# API version to display in Swagger UI
SWAGGER_VERSION=v1

# Base path for Swagger endpoint (if app is not hosted at root)
# SWAGGER_BASE_PATH=/api

# Restrict Swagger UI to certain environments (comma-separated, e.g. Development,Staging)
SWAGGER_ENVIRONMENTS=Development

# Optional: Require authentication for accessing Swagger UI
# SWAGGER_REQUIRE_AUTH=false

# Optional: Bearer token for pre-filling Authorize button in Swagger UI
# SWAGGER_BEARER_TOKEN=