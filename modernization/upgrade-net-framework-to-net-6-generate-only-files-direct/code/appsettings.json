appsettings.json
{
  // Configuration for JWT authentication
  "Jwt": {
    "Key": "YourSuperSecretKey", // Secret key for signing tokens
    "Issuer": "YourIssuer", // The issuer of the token
    "Audience": "YourAudience", // The intended audience of the token
    "ExpiryMinutes": 60 // Duration in minutes until the token expires
  },
  // New environment-specific configurations
  "ASPNETCORE_ENVIRONMENT": "Development" // Set environment type for the application
}