# ASP.NET Core uses appsettings.json for configuration by default.
# If using environment variables, the prefix "ASPNETCORE_" is often used.
# Here are the common configuration keys added/changed for ASP.NET Core upgrade.

# Environment (Development/Production/Staging)
ASPNETCORE_ENVIRONMENT=Development  # Set the environment name

# Port the app should run on (for Kestrel web server)
ASPNETCORE_URLS=http://localhost:5000  # Listening URLs, comma-separated

# Logging level (uses Microsoft logging category names)
Logging__LogLevel__Default=Information  # Default logging level

# For enabling detailed errors in Development (optional)
ASPNETCORE_DETAILEDERRORS=true

# For enabling application insights or other telemetry integrations (optional/new)
ApplicationInsights__InstrumentationKey=

# Connection strings (replace 'DefaultConnection' with your name)
ConnectionStrings__DefaultConnection=Server=localhost;Database=MyDb;User Id=myuser;Password=mypassword;

# JWT or authentication-related settings (if used; new style)
Jwt__Issuer=
Jwt__Audience=
Jwt__Key=

# CORS policy (new/optional)
AllowedHosts=*  # Allows any host, restrict in production

# Other keys would be migrated/added as needed for third-party middleware or features.