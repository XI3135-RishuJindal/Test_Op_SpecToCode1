# .env.example

# CI/CD Configuration
CI_CD_ENABLED=true                # Enable CI/CD pipeline for application
CI_CD_TOOLCHAIN=latest_stable     # Specify the CI/CD toolchain version
DOCKER_IMAGE_NAME=your-image-name # Name of the Docker image to be used for deployment
DOCKER_IMAGE_TAG=latest           # Tag for the Docker image
KUBERNETES_DEPLOYMENT=true        # Set to true if using Kubernetes for deployment
BUILD_CACHE=true                   # Enable caching for build optimization during CI/CD process
SECRET_KEY_BASE=your_secret_key   # Secure key for production environments (must be kept secret)

# Note: Ensure to replace placeholder values with actual project-specific values.