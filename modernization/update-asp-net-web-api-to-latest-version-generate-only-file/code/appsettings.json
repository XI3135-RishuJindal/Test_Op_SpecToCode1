appsettings.json
{
  "JwtSettings": {
    "Issuer": "your-issuer-here", // Issuer of the JWT token
    "Audience": "your-audience-here", // Audience for whom the JWT is intended
    "Key": "your-secret-key-here" // Secret key for signing JWT tokens
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information", // Log level for the application
      "Microsoft": "Warning", // Log level for Microsoft libraries
      "Microsoft.Hosting.Lifetime": "Information" // Log level for hosting events
    }
  },
  "AllowedHosts": "*"
}