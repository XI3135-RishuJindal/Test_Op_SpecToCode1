# .env.example

# Test coverage configuration
TEST_COVERAGE_ENABLED=true  # Enables test coverage collection during tests
COVERAGE_REPORT_OUTPUT=coverage/  # Directory for storing coverage reports
COVERAGE_FORMAT=html  # Format of the coverage report (e.g., 'html', 'xml', 'text')
COVERAGE_MIN_THRESHOLD=80  # Minimum coverage percentage threshold for the project
COVERAGE_EXCLUDE_PATTERN=tests/*  # Pattern to exclude from coverage reports
TEST_RUNNER_COMMAND=npm test  # Command to run the tests (update based on your project)