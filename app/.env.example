# ──────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
APP_VERSION=1.0.0
LOG_LEVEL=info

# ──────────────────────────────────────────────
# Kong Gateway
# ──────────────────────────────────────────────
KONG_ADMIN_URL=http://kong:8001
KONG_PROXY_URL=http://kong:8000
KONG_ADMIN_TOKEN=

# ──────────────────────────────────────────────
# Tyk Gateway
# ──────────────────────────────────────────────
TYK_GATEWAY_URL=http://tyk:8080
TYK_DASHBOARD_URL=http://tyk-dashboard:3000
TYK_SECRET=tyk-secret-key
TYK_ORG_ID=default

# ──────────────────────────────────────────────
# Nginx
# ──────────────────────────────────────────────
NGINX_UPSTREAM_HOST=localhost
NGINX_UPSTREAM_PORT=8080
NGINX_WORKER_PROCESSES=auto
NGINX_WORKER_CONNECTIONS=1024

# ──────────────────────────────────────────────
# Security
# ──────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_SECONDS=3600
API_KEY_HEADER=X-API-Key

# ──────────────────────────────────────────────
# Rate Limiting
# ──────────────────────────────────────────────
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200

# ──────────────────────────────────────────────
# CORS
# ──────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*

# ──────────────────────────────────────────────
# Metrics / Monitoring
# ──────────────────────────────────────────────
METRICS_ENABLED=true
METRICS_PATH=/metrics
PROMETHEUS_PORT=9090
