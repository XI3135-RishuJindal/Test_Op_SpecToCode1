# ──────────────────────────────────────────────────────────────────────────────
# User Role Management Service — environment variables
# Copy this file to .env and fill in the values for your environment.
# ──────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
SERVER_PORT=8080

# ── Database ──────────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/userroledb
DB_USERNAME=postgres
DB_PASSWORD=changeme

# ── JPA / Hibernate ───────────────────────────────────────────────────────────
# Options: validate | update | create | create-drop
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

# ── Flyway ────────────────────────────────────────────────────────────────────
FLYWAY_ENABLED=true

# ── Logging ───────────────────────────────────────────────────────────────────
# Options: TRACE | DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO
