# Application
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# OTP Configuration
OTP_TTL_SECONDS=300

# Twilio (required when NODE_ENV=production or USE_TWILIO=true)
USE_TWILIO=false
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+15005550006
