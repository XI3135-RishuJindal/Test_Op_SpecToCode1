# Configuration Template File

# This configuration file externalizes internal settings that were previously hardcoded in the source code.
# These settings are read from this file at runtime, enabling changes without needing to redeploy code.

# Uncomment and set the appropriate values for your environment.

[General]
# The current working environment ("development", "staging", "production").
# This generally dictates how the application will behave under different conditions.
environment = "development"  # Default is "development"

[Database]
# Database connection settings.
# The database.hostname value represents the host address of your database server.
hostname = "localhost"

# Port on which the database service is listening.
port = 5432

# Database user credentials.
username = "db_user"
password = "db_password"

# The name of the database you are connecting to.
database_name = "example_db"

[Logging]
# Logging level used by the application. 
# Valid options: "DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL".
level = "INFO"

# Logging output location: can be a file path or a logging service endpoint.
output = "/var/log/application.log"

[Security]
# Toggle to enable or disable secure connections (HTTPS/TLS)
enable_https = false

# Path to the SSL certificate file for secure connections.
ssl_certificate = "/path/to/certificate.pem"

[FeatureToggle]
# Features at different stages of rollout. Set to false to disable.
newFeatureX = false

# More feature toggles can be added as necessary.

# Comments or deprecated configurations should be kept here for reference but not used.
# previousFeatureY = true  # No longer used, replaced by newFeatureX

# Ensure this file is kept secure, as it contains sensitive information like database credentials.
# Consider environment specific versions of this file or environment variables to manage sensitive data securely.