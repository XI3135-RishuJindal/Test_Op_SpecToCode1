TESTING_ENABLED=true # Enables extensive testing for the application after upgrades
TESTING_FRAMEWORK=latest-stable-testing-framework # Specifies the latest stable version of the testing framework to be used
CODE_COVERAGE=true # Enables code coverage reports to ensure thorough testing coverage
MAX_TEST_EXECUTION_TIME=300 # Sets a maximum execution time for tests in seconds to avoid long running tests
TEST_REPORTS_DIR=/var/test-reports # Directory to store generated test reports after execution
ENABLE_CONTINUOUS_INTEGRATION=true # Enable CI for continuous testing and integration flow