# SQLAlchemy 2.x introduces several important changes to engine and session configuration.
# Update or add any relevant environment variables as shown below.

# DATABASE_URL now should use the new SQLAlchemy 2.x URL style (if not already using)
DATABASE_URL=postgresql+psycopg://user:password@localhost/dbname
# If using SQLite, for example: sqlite:///./test.db

# SQLALCHEMY_ECHO enables detailed SQL logging, OFF by default
SQLALCHEMY_ECHO=false  # Set to 'true' to enable SQL logging for debugging

# SQLALCHEMY_FUTURE is deprecated; migration to 2.x requires full adoption of 2.0 API
# Remove SQLALCHEMY_FUTURE if present in the old config. No replacement needed.

# SQLALCHEMY_ENGINE_OPTIONS allows passing options such as pool settings with JSON (if your app parses it)
# Example: '{"pool_pre_ping": true, "pool_recycle": 1800}'
# SQLALCHEMY_ENGINE_OPTIONS={"pool_pre_ping": true, "pool_recycle": 1800}  # Uncomment and edit as needed

# SQLALCHEMY_SESSION_OPTIONS for session-level changes in 2.x
# SQLALCHEMY_SESSION_OPTIONS={"autoflush": false, "expire_on_commit": false}  # Uncomment and configure if needed

# NOTE: Make sure to update your application code to use the new SQLAlchemy 2.x Query API.