.github/workflows/ci.yml

# GitHub Actions CI Pipeline
# Introduced by upgrade: automated build, test, and SAST workflow
# Triggers on push to main/master and on all pull requests targeting those branches.
# TODO: Review and fill in all TODO placeholders before merging this workflow.

name: CI

on:
  # Trigger on pushes to the primary integration branches
  push:
    branches:
      - main
      - master
  # Trigger on pull requests targeting the primary integration branches
  pull_request:
    branches:
      - main
      - master

# Limit concurrent runs on the same ref to avoid redundant work.
# New runs cancel in-progress runs on the same branch/PR.
concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:

  # ---------------------------------------------------------------------------
  # BUILD JOB
  # Compiles / assembles the project so that downstream jobs can verify
  # artefacts exist and are well-formed.
  # TODO: Replace the placeholder steps below with the real build commands
  #       once the language, runtime, and build tool are confirmed.
  # ---------------------------------------------------------------------------
  build:
    name: Build
    runs-on: ubuntu-latest  # TODO: change runner if a specific OS is required

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4  # pins to the latest stable major version

      # TODO: Add a language/runtime setup step here, for example:
      #   - uses: actions/setup-node@v4        (Node.js)
      #   - uses: actions/setup-python@v5      (Python)
      #   - uses: actions/setup-java@v4        (Java / Kotlin)
      #   - uses: actions/setup-go@v5          (Go)
      #   - uses: actions/setup-dotnet@v4      (.NET)
      # Example (Node.js — remove or replace as appropriate):
      # - name: Set up runtime
      #   uses: actions/setup-node@v4
      #   with:
      #     node-version: 'lts/*'  # TODO: pin to the project's required version
      #     cache: 'npm'           # TODO: change cache key to match build tool (npm/yarn/pnpm)

      # TODO: Replace with the real dependency installation command, e.g.:
      #   npm ci | yarn install --frozen-lockfile | pip install -r requirements.txt | mvn dependency:resolve
      - name: Install dependencies
        run: |
          echo "TODO: replace this step with the real dependency installation command"
          # Example: npm ci

      # TODO: Replace with the real build command, e.g.:
      #   npm run build | mvn package -DskipTests | go build ./... | dotnet build
      - name: Build
        run: |
          echo "TODO: replace this step with the real build command"
          # Example: npm run build

      # Cache or upload build artefacts so the test job can reuse them
      # without rebuilding from scratch.
      # TODO: Adjust path to match the actual output directory.
      - name: Upload build artefacts
        uses: actions/upload-artifact@v4  # new key: artefact sharing between jobs
        with:
          name: build-artefacts
          path: |
            # TODO: replace with the real build output path, e.g. dist/ build/ target/ out/
            dist/
          retention-days: 1  # short retention; artefacts are only needed within this workflow run
          if-no-files-found: warn  # warn rather than fail while placeholder paths are in use

  # ---------------------------------------------------------------------------
  # TEST JOB
  # Runs the project's automated test suite against the built artefacts.
  # Depends on the build job so tests only run when the build succeeds.
  # TODO: Replace placeholder steps with real test commands.
  # ---------------------------------------------------------------------------
  test:
    name: Test
    runs-on: ubuntu-latest  # TODO: change runner if a specific OS is required
    needs: build  # new key: enforces build-before-test ordering

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      # TODO: Add the same runtime setup step used in the build job.
      # - name: Set up runtime
      #   uses: actions/setup-node@v4
      #   with:
      #     node-version: 'lts/*'
      #     cache: 'npm'

      # TODO: Replace with the real dependency installation command (same as build job).
      - name: Install dependencies
        run: |
          echo "TODO: replace this step with the real dependency installation command"

      # Download the artefacts produced by the build job
      - name: Download build artefacts
        uses: actions/download-artifact@v4  # new key: retrieve artefacts from build job
        with:
          name: build-artefacts
          path: dist/  # TODO: align with the upload path set in the build job

      # TODO: Replace with the real test command, e.g.:
      #   npm test | pytest | mvn test | go test ./... | dotnet test
      - name: Run tests
        run: |
          echo "TODO: replace this step with the real test command"
          # Example: npm test

      # Optional: publish test results as a workflow summary
      # TODO: Uncomment and configure if the test runner produces JUnit XML reports.
      # - name: Publish test results
      #   uses: actions/upload-artifact@v4
      #   if: always()  # upload even when tests fail so results are always available
      #   with:
      #     name: test-results
      #     path: test-results/**/*.xml  # TODO: adjust to actual report output path
      #     retention-days: 7

  # ---------------------------------------------------------------------------
  # SAST JOB (Static Application Security Testing)
  # Uses CodeQL — GitHub's built-in SAST engine — to scan source code for
  # security vulnerabilities. Runs in parallel with the test job.
  #
  # CodeQL is free for public repositories and available via GitHub Advanced
  # Security for private repositories.
  #
  # TODO: Set the correct language value in the matrix below.
  #       Supported values: c-cpp, csharp, go, java-kotlin, javascript-typescript,
  #                         python, ruby, swift
  # ---------------------------------------------------------------------------
  sast:
    name: SAST (CodeQL)
    runs-on: ubuntu-latest
    # CodeQL requires these permissions to upload results to the Security tab
    permissions:
      security-events: write   # new key: allows uploading SARIF results to GitHub Security
      actions: read            # new key: required for private repos to read workflow metadata
      contents: read           # new key: required to check out the repository

    strategy:
      fail-fast: false  # new key: continue scanning other languages if one matrix entry fails
      matrix:
        # TODO: Replace 'javascript-typescript' with the language(s) actually used in this repo.
        # Add multiple entries if the repo contains more than one supported language.
        language:
          - javascript-typescript  # TODO: update to the correct CodeQL language identifier

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      # Initialise the CodeQL analysis tools and create a database for the target language
      - name: Initialize CodeQL
        uses: github/codeql-action/init@v3  # new key: sets up CodeQL for the specified language
        with:
          languages: ${{ matrix.language }}  # driven by the matrix defined above
          # queries: security-extended  # TODO: uncomment to enable a broader query suite
          #                             # default is 'security-and-quality'

      # For compiled languages (C/C++, C#, Go, Java/Kotlin, Swift) CodeQL needs to
      # observe the build. Replace the autobuild step with your real build command
      # if autobuild fails or produces incomplete results.
      - name: Autobuild
        uses: github/codeql-action/autobuild@v3  # new key: attempts to build compiled languages automatically
        # TODO: For compiled languages, if autobuild does not work, replace this step with:
        # - name: Manual build for CodeQL
        #   run: |
        #     <your real build command here>

      # Run the CodeQL analysis and upload results to the GitHub Security tab
      - name: Perform CodeQL Analysis
        uses: github/codeql-action/analyze@v3  # new key: executes queries and uploads SARIF results
        with:
          category: "/language:${{ matrix.language }}"  # new key: labels results by language in the Security tab