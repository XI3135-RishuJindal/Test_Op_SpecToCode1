<?xml version="1.0" encoding="utf-8"?>
<!--
  Integration Test Project File
  Generated for: xUnit integration test project with WebApplicationFactory
  Framework: Microsoft.AspNetCore.Mvc.Testing (in-process integration testing)

  IMPORTANT TODOs before this project is usable:
    1. Replace "YourApp.Api" in <ProjectReference> with the actual API/web project name.
    2. Replace "YourApp.Api" in the assembly reference within test classes with the actual
       entry-point assembly (the TEntryPoint type used with WebApplicationFactory<T>).
    3. Confirm the TargetFramework matches the application project (e.g., net8.0, net9.0).
    4. Add this project to the solution file:
         dotnet sln YourSolution.sln add tests/YourApp.IntegrationTests/YourApp.IntegrationTests.csproj
    5. Verify CI pipeline picks up the new project (typically automatic with `dotnet test`
       run from the solution root, but confirm with your CI configuration).
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Target framework: must match the application project being tested.
         Update to net8.0 or net9.0 (latest stable) as appropriate. -->
    <TargetFramework>net8.0</TargetFramework>

    <!-- Nullable reference types: enabled to align with modern ASP.NET Core conventions. -->
    <Nullable>enable</Nullable>

    <!-- Implicit usings: reduces boilerplate; includes System, System.Linq, etc. -->
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- IsPackable=false: integration test projects should never be published as NuGet packages. -->
    <IsPackable>false</IsPackable>

    <!-- IsTestProject=true: signals to the SDK, IDEs, and CI runners that this is a test project.
         Enables test discovery and `dotnet test` support. -->
    <IsTestProject>true</IsTestProject>

    <!-- RootNamespace: update to match your solution's naming convention. -->
    <RootNamespace>YourApp.IntegrationTests</RootNamespace>

    <!-- AssemblyName: update to match your solution's naming convention. -->
    <AssemblyName>YourApp.IntegrationTests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- xunit: core xUnit v2 testing framework.
         NEW — required for test discovery and assertions. -->
    <PackageReference Include="xunit" Version="2.9.0" />

    <!-- xunit.runner.visualstudio: enables test discovery in Visual Studio and
         `dotnet test` via VSTest adapter.
         NEW — required for IDE and CLI test execution. -->
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <!-- PrivateAssets=all: runner is a build-time tool, not a runtime dependency. -->
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!-- Microsoft.NET.Test.Sdk: MSBuild integration for `dotnet test`.
         NEW — required for the test host and result reporting. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />

    <!-- Microsoft.AspNetCore.Mvc.Testing: provides WebApplicationFactory<TEntryPoint>
         for in-process integration testing of ASP.NET Core applications.
         NEW — the core dependency introduced by this upgrade. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.0" />

    <!-- coverlet.collector: optional code coverage collection via `dotnet test --collect`.
         NEW — included by default in test project templates; remove if not needed. -->
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- ProjectReference: points to the ASP.NET Core application under test.
         NEW — WebApplicationFactory<TEntryPoint> requires a direct project reference
         so it can locate and boot the application's entry point in-process.
         TODO: Replace "YourApp.Api" with the actual relative path to your web project. -->
    <ProjectReference Include="..\..\src\YourApp.Api\YourApp.Api.csproj" />
  </ItemGroup>

</Project>