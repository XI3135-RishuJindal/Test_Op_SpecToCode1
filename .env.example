.github/workflows/ci.yml

# CI pipeline: lint, SAST, dependency scan, and test stages
# Triggered on every push and pull_request targeting the main branch.
# Adjust the language-specific steps (marked TODO) once the runtime and
# build tool are confirmed for this repository.

name: CI

on:
  push:
    branches:
      - main
  pull_request:
    branches:
      - main

# Cancel in-progress runs for the same ref to avoid redundant work.
concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:

  # ---------------------------------------------------------------------------
  # Stage 1 — Lint
  # Runs a linter appropriate to the project language.
  # TODO: Replace the placeholder step below with the linter for this repo
  #       (e.g., eslint, flake8/ruff, golangci-lint, rubocop, etc.).
  # The job fails the pipeline if any lint error is reported.
  # ---------------------------------------------------------------------------
  lint:
    name: Lint
    runs-on: ubuntu-latest

    steps:
      - name: Checkout source
        uses: actions/checkout@v4

      # TODO: Add language/runtime setup step here, for example:
      #   - uses: actions/setup-node@v4
      #     with:
      #       node-version: 'lts/*'
      #   - uses: actions/setup-python@v5
      #     with:
      #       python-version: '3.x'

      # TODO: Add dependency installation step here, for example:
      #   - run: npm ci
      #   - run: pip install -r requirements.txt

      # TODO: Replace this placeholder with the actual lint command, e.g.:
      #   - run: npm run lint
      #   - run: ruff check .
      #   - run: golangci-lint run
      - name: Run linter (TODO — replace with project linter)
        run: |
          echo "TODO: replace this step with the project linter command"
          echo "The job must exit non-zero on lint errors to fail the pipeline."

  # ---------------------------------------------------------------------------
  # Stage 2 — SAST (Static Application Security Testing)
  # Uses CodeQL, GitHub's built-in SAST engine, which requires no external
  # credentials and supports most common languages automatically.
  # The 'language' matrix value must be set to the CodeQL language identifier
  # for this repository (e.g., javascript-typescript, python, go, java,
  # csharp, ruby, swift, cpp).
  # See: https://docs.github.com/en/code-security/code-scanning/automatically-scanning-your-code-for-vulnerabilities-and-errors/configuring-code-scanning-for-a-repository
  # ---------------------------------------------------------------------------
  sast:
    name: SAST — CodeQL
    runs-on: ubuntu-latest
    # Required permissions for CodeQL to upload results to the Security tab.
    permissions:
      security-events: write
      actions: read
      contents: read

    steps:
      - name: Checkout source
        uses: actions/checkout@v4

      # Initialise CodeQL tooling and select the language to analyse.
      # TODO: Set the 'languages' input to the correct CodeQL language
      #       identifier for this repository.
      - name: Initialise CodeQL
        uses: github/codeql-action/init@v3
        with:
          # TODO: replace 'javascript-typescript' with the correct language
          # identifier, e.g. python, go, java, csharp, ruby, cpp, swift.
          languages: javascript-typescript

      # Auto-build attempts to compile the code automatically.
      # For interpreted languages this step is a no-op and can be removed.
      # For compiled languages (Java, C#, Go, C/C++, Swift) it is required
      # unless you supply a manual build command via the 'build-command' input.
      - name: Auto-build (compiled languages only)
        uses: github/codeql-action/autobuild@v3

      # Run the CodeQL analysis and upload results.
      - name: Perform CodeQL analysis
        uses: github/codeql-action/analyze@v3
        with:
          # Upload SARIF results to GitHub Advanced Security.
          # 'always' ensures results are visible even when the step fails.
          upload: always

  # ---------------------------------------------------------------------------
  # Stage 3 — Dependency Scan
  # Uses the Dependency Review Action to detect newly introduced vulnerable
  # dependencies on pull requests.  On push events the action is skipped
  # automatically (it only operates on pull_request events).
  # For deeper scanning (all existing deps, not just diff), consider adding
  # a secondary tool such as Trivy or OWASP Dependency-Check.
  # ---------------------------------------------------------------------------
  dependency-scan:
    name: Dependency Scan
    runs-on: ubuntu-latest
    # Required for the Dependency Review Action to read the dependency graph.
    permissions:
      contents: read
      pull-requests: write  # allows the action to post a PR comment summary

    steps:
      - name: Checkout source
        uses: actions/checkout@v4

      # Dependency Review Action: fails the job if any newly added dependency
      # has a known vulnerability (GHSA / CVE) at the configured severity.
      # Only meaningful on pull_request events; on push it exits cleanly.
      - name: Dependency review
        uses: actions/dependency-review-action@v4
        with:
          # Fail the job for vulnerabilities rated HIGH or CRITICAL.
          # Accepted values: critical, high, moderate, low.
          # TODO: Adjust the threshold to match your organisation's policy.
          fail-on-severity: high

          # Optionally allow specific advisories that are accepted risks:
          # allow-ghsas: GHSA-xxxx-xxxx-xxxx

  # ---------------------------------------------------------------------------
  # Stage 4 — Tests
  # Runs the project's automated test suite.
  # TODO: Replace the placeholder step below with the actual test command
  #       for this repository (e.g., npm test, pytest, go test ./..., etc.).
  # The job fails the pipeline if any test exits non-zero.
  # ---------------------------------------------------------------------------
  test:
    name: Test
    runs-on: ubuntu-latest
    # Tests run after lint passes to avoid wasting runner minutes on broken code.
    needs: lint

    steps:
      - name: Checkout source
        uses: actions/checkout@v4

      # TODO: Add language/runtime setup step here (same as in the lint job).

      # TODO: Add dependency installation step here (same as in the lint job).

      # TODO: Replace this placeholder with the actual test command, e.g.:
      #   - run: npm test
      #   - run: pytest --tb=short
      #   - run: go test ./...
      #   - run: bundle exec rspec
      - name: Run tests (TODO — replace with project test command)
        run: |
          echo "TODO: replace this step with the project test command"
          echo "The job must exit non-zero on test failures to fail the pipeline."