# SQLAlchemy 2.x compatibility configuration updates

# Enables SQLAlchemy 2.x style execution and deprecations
SQLALCHEMY_ENGINE_OPTIONS={"future": true}  # Set SQLAlchemy engine in 'future' mode for 2.x compatibility

# Use strict mode for Session operations, to enforce 2.x behaviors (if applicable)
SQLALCHEMY_SESSION_OPTIONS={"future": true}  # Optional: Use session in 'future' mode for 2.x

# Uncomment below if using the new 2.x style connection pool or related settings
# SQLALCHEMY_POOL_CLASS=QueuePool  # Explicit pool class, adjust as needed for SQLAlchemy 2.x APIs