# log4j2.xml
# Complete Log4j 2 configuration file updated for log4j-core 2.17.2+
# Remediates CVE-2021-44228 (Log4Shell), CVE-2021-45046, CVE-2021-45105, CVE-2021-44832
#
# IMPORTANT: This file must be used alongside log4j-core 2.17.2+ on the runtime classpath.
# The mitigations below are defence-in-depth; the primary fix is the version upgrade itself.
#
# Place this file at the root of your classpath (e.g. src/main/resources/log4j2.xml)
# or point to it via the system property: -Dlog4j2.configurationFile=path/to/log4j2.xml

<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN"
               monitorInterval="30"
               name="ApplicationLogging">

  <!--
    ============================================================
    SECURITY PROPERTIES — Log4Shell remediation (2.17.2+)
    ============================================================

    CVE-2021-44228 / CVE-2021-45046 mitigation:
      log4j2.formatMsgNoLookups is honoured in 2.14.1 as a partial
      workaround, but is INSUFFICIENT on its own. In 2.17.2+ the JNDI
      Lookup plugin is disabled by default. The property below makes
      the intent explicit and provides defence-in-depth should the JAR
      version ever regress.

    CVE-2021-45105 mitigation:
      Self-referential lookups that caused infinite recursion are fixed
      in 2.17.0+. No configuration knob is required; the fix is in the
      library code.

    CVE-2021-44832 mitigation:
      Attacker-controlled JDBC Appender RCE is fixed in 2.17.1+.
      Avoid using JdbcAppender with externally-supplied connection
      strings. The JDBC appender example below is commented out.
  -->
  <Properties>

    <!-- [SECURITY - CVE-2021-44228]
         Disable message pattern lookups globally.
         In 2.17.2+ this defaults to true; set explicitly for clarity.
         Prevents ${jndi:...}, ${env:...}, etc. from being resolved
         inside log message bodies. -->
    <Property name="log4j2.formatMsgNoLookups">true</Property>

    <!-- [SECURITY - CVE-2021-44228 / CVE-2021-45046]
         Disable the JNDI Lookup plugin entirely.
         In 2.17.0+ JNDI is disabled by default unless this is set to true.
         Never set this to true unless you have an explicit, audited need. -->
    <Property name="log4j2.enableJndiLookup">false</Property>

    <!-- [SECURITY - CVE-2021-44228]
         Disable JNDI for JMS Appender (separate toggle introduced in 2.17.0). -->
    <Property name="log4j2.enableJndiJms">false</Property>

    <!-- [SECURITY - CVE-2021-44228]
         Disable JNDI for JNDI Manager (separate toggle introduced in 2.17.0). -->
    <Property name="log4j2.enableJndiContextSelector">false</Property>

    <!-- Application-level properties — adjust to suit your environment -->
    <Property name="LOG_PATTERN">%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n</Property>
    <Property name="LOG_DIR">logs</Property>
    <Property name="APP_LOG_FILE">${LOG_DIR}/application.log</Property>
    <Property name="ROOT_LOG_LEVEL">INFO</Property>

  </Properties>

  <!--
    ============================================================
    APPENDERS
    ============================================================
  -->
  <Appenders>

    <!-- Console appender — safe for all versions -->
    <Console name="ConsoleAppender" target="SYSTEM_OUT">
      <!--
        PatternLayout: %msg is the raw message.
        In 2.17.2+ lookups inside %msg are disabled by default.
        The 'disableAnsi' attribute avoids terminal injection risks.
      -->
      <PatternLayout pattern="${LOG_PATTERN}" disableAnsi="false"/>
    </Console>

    <!-- Rolling file appender — safe for all versions -->
    <RollingFile name="RollingFileAppender"
                 fileName="${APP_LOG_FILE}"
                 filePattern="${LOG_DIR}/application-%d{yyyy-MM-dd}-%i.log.gz">
      <PatternLayout pattern="${LOG_PATTERN}"/>
      <Policies>
        <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
        <SizeBasedTriggeringPolicy size="100 MB"/>
      </Policies>
      <DefaultRolloverStrategy max="30"/>
    </RollingFile>

    <!--
      [SECURITY - CVE-2021-44832]
      JDBC Appender is intentionally commented out.
      If you must use JdbcAppender, upgrade to 2.17.1+ (included in 2.17.2)
      and ensure the connection string is fully controlled by your
      configuration — never derived from user input or external sources.

    <JDBC name="JdbcAppender" tableName="application_log">
      <ConnectionFactory class="com.example.logging.ConnectionFactory"
                         method="getConnection"/>
      <Column name="event_date"  isEventTimestamp="true"/>
      <Column name="level"       pattern="%level"/>
      <Column name="logger"      pattern="%logger"/>
      <Column name="message"     pattern="%message"/>
      <Column name="throwable"   pattern="%ex{full}"/>
    </JDBC>
    -->

  </Appenders>

  <!--
    ============================================================
    LOGGERS
    ============================================================
  -->
  <Loggers>

    <!--
      Example: suppress overly verbose third-party library logging.
      Add additional <Logger> entries for your own packages as needed.
    -->
    <Logger name="org.apache.http" level="WARN" additivity="false">
      <AppenderRef ref="ConsoleAppender"/>
    </Logger>

    <Logger name="org.springframework" level="WARN" additivity="false">
      <AppenderRef ref="ConsoleAppender"/>
    </Logger>

    <!--
      Root logger — catches everything not matched by a named logger above.
      Level is driven by the LOG_LEVEL property; override at deployment time
      via -Dlog4j2.level=DEBUG or by changing ROOT_LOG_LEVEL above.
    -->
    <Root level="${ROOT_LOG_LEVEL}">
      <AppenderRef ref="ConsoleAppender"/>
      <AppenderRef ref="RollingFileAppender"/>
    </Root>

  </Loggers>

</Configuration>