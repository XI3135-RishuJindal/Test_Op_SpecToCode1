# Test Suite Configuration File
# This configuration template enables hardened, reliable unit and integration testing with improved coverage enforcement.
# Adapt key values (e.g. source paths, thresholds) as necessary for your environment.

test:
  discovery:
    patterns:
      - "tests/unit/**/test_*.py"        # Pattern for discovering unit tests
      - "tests/integration/**/test_*.py" # Pattern for discovering integration tests
    fail_on_missing: true                # Fail if test directories/patterns yield zero discovered tests

  execution:
    parallel: true                       # Enable parallel test execution to reduce flakiness due to test order/dependencies
    max_retries: 2                       # (New) Automatically retry failed tests up to 2 times to minimize transient/flaky failures
    timeout_per_test: 120                # (New) Enforce a 120 second timeout per test for clarity on hung or long-running cases

  results:
    verbose: true                        # (New) Enable verbose output for clearer test failure messages and tracebacks
    show_stacktraces: true               # (New) Always display stack traces for failed tests for faster debugging
    summary_on_failure: true             # (New) Print a summary of failed tests at the end of the run

  assertions:
    strict_assertions: true              # (New) Fail if any assertion in any test is ambiguous or suppressed

  coverage:                              # Coverage reporting and enforcement
    enabled: true                        # (New) Enable test coverage measurement
    source_paths:
      - "src/"                           # Path(s) to source code for coverage measurement
    fail_under: 85                       # (New) Minimum total coverage percentage, fail the test suite if under this value
    html_report: "reports/coverage_html" # (New) Generate an HTML coverage report at this path
    xml_report: "reports/coverage.xml"   # (New) Generate an XML coverage report for CI analysis

  reporting:
    junitxml: "reports/junit_results.xml" # (New) Generate machine-readable test report for CI dashboards/analytics

  flakiness_detection:
    enabled: true                        # (New) Enable tracking of flaky (non-deterministic) tests across multiple runs
    quarantine_tag: "quarantined"        # (New) Automatically tag and quarantine identified flaky tests

  logging:
    log_level: INFO                      # (New) Set the default log level during test runs for clearer context

# End of Test Suite Configuration File