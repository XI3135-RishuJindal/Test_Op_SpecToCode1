# ── Application ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database (PostgreSQL) ──────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=changeme
DB_NAME=identity_db
# Set to true only in development to auto-sync schema (never in production)
DB_SYNCHRONIZE=false
# Set to true when connecting to a TLS-enabled PostgreSQL instance
DB_SSL=false

# ── Verification Token ─────────────────────────────────────────────────────────
# Time-to-live for email verification tokens (minutes)
VERIFICATION_TOKEN_TTL_MINUTES=60

# ── Redis (optional — for ephemeral idempotency references) ───────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── OpenTelemetry ──────────────────────────────────────────────────────────────
OTEL_SERVICE_NAME=identity-registration-verification-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
