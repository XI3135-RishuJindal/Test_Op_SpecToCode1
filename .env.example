# Example secrets and sensitive configuration are now managed via environment variables
# Replace values below with your actual environment variables in your own .env file

# Database credentials
DB_USERNAME=${DB_USERNAME}
DB_PASSWORD=${DB_PASSWORD}

# API keys
API_KEY=${API_KEY}

# Secret keys
SECRET_KEY_BASE=${SECRET_KEY_BASE}

# Third-party service credentials
THIRD_PARTY_CLIENT_ID=${THIRD_PARTY_CLIENT_ID}
THIRD_PARTY_CLIENT_SECRET=${THIRD_PARTY_CLIENT_SECRET}

# JWT secret for token signing
JWT_SECRET=${JWT_SECRET}