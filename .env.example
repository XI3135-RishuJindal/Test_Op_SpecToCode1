# ── Flask ──────────────────────────────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=change-me-in-production

# ── Server ─────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=5000

# ── Security ───────────────────────────────────────────────────────────────────
# bcrypt work factor (higher = slower hashing, more secure; 12 is a safe default)
BCRYPT_ROUNDS=12

# ── Database (future) ──────────────────────────────────────────────────────────
# DATABASE_URL=postgresql://user:password@localhost:5432/auth_db
