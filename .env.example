      # Examples (uncomment the one that applies):
      #
      # - name: Install dependencies
      #   run: |
      #     # npm ci                  # Node.js
      #     # pip install -r requirements.txt   # Python
      #     # mvn dependency:resolve  # Maven (optional, handled by build)
      #     echo "TODO: replace with your dependency install command"

      - name: Build project
        # TODO: Replace the echo command below with your actual build command.
        # Examples:
        #   npm run build
        #   mvn package -DskipTests
        #   gradle assemble
        #   go build ./...
        #   cargo build --release
        #   dotnet build --configuration Release
        #   make build
        run: |
          echo "TODO: replace with your build command"

      # TODO: Configure artifact upload if build outputs should be retained.
      # Uncomment and configure if needed:
      #
      # - name: Upload build artifacts
      #   uses: actions/upload-artifact@v4
      #   with:
      #     name: build-output          # TODO: name your artifact bundle
      #     path: ./dist                # TODO: set the path to your build output directory
      #     retention-days: 7           # TODO: adjust retention period per your policy

  # ----------------------------------------------------------
  # TEST STAGE
  # Runs the automated test suite after a successful build.
  # This stage depends on the build job completing successfully.
  # TODO: Replace the placeholder steps with your actual test
  #       runner commands (e.g., `npm test`, `mvn test`,
  #       `pytest`, `go test ./...`, `cargo test`, etc.)
  # ----------------------------------------------------------
  test:
    name: Test
    runs-on: ubuntu-latest   # TODO: match the runner OS used in the build job above
    needs: build              # Ensures test stage only runs after build succeeds

    steps:
      - name: Checkout source code
        uses: actions/checkout@v4

      # TODO: Repeat the same runtime setup step used in the build job above.
      # The test job runs in a fresh environment and requires the same toolchain.

      # TODO: Repeat the same dependency installation step used in the build job above.

      - name: Run tests
        # TODO: Replace the echo command below with your actual test command.
        # Examples:
        #   npm test
        #   npm run test:ci
        #   mvn test
        #   gradle test
        #   pytest --tb=short
        #   go test ./... -v
        #   cargo test
        #   dotnet test --no-build
        #   make test
        run: |
          echo "TODO: replace with your test command"

      # TODO: If your test runner produces a report (JUnit XML, coverage, etc.),
