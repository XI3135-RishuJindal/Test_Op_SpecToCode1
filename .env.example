.github/workflows/ci.yml

name: CI

on:
  push:
    branches:
      - main
      - master
  pull_request:
    branches:
      - main
      - master

# Cancel in-progress runs for the same branch/PR to avoid redundant work
concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:

  # ------------------------------------------------------------
  # LINT
  # Runs code style and static analysis checks.
  # TODO: Replace the placeholder step below with the linter
  #       appropriate for your language/runtime once confirmed.
  #       Examples:
  #         - JavaScript/TypeScript: eslint, prettier
  #         - Python:                flake8, ruff, pylint
  #         - Go:                    golangci-lint
  #         - Java:                  checkstyle, spotbugs
  #         - Ruby:                  rubocop
  # ------------------------------------------------------------
  lint:
    name: Lint
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      # TODO: Add language-specific setup step here.
      # Example for Node.js:
      #   - uses: actions/setup-node@v4
      #     with:
      #       node-version: 'lts/*'
      #       cache: 'npm'
      # Example for Python:
      #   - uses: actions/setup-python@v5
      #     with:
      #       python-version: '3.x'

      # TODO: Add dependency installation step here if required.
      # Example: run: npm ci
      # Example: run: pip install -r requirements.txt

      # TODO: Replace this placeholder with your actual lint command.
      - name: Run linter
        run: |
          echo "TODO: replace with real lint command, e.g. 'npm run lint' or 'ruff check .'"
          exit 0

  # ------------------------------------------------------------
  # SAST (Static Application Security Testing)
  # Scans source code for security vulnerabilities.
  # CodeQL is used here as a language-agnostic default supported
  # natively by GitHub Actions. It supports C/C++, C#, Go, Java,
  # JavaScript/TypeScript, Python, Ruby, and Swift.
  # TODO: Confirm the language value for the CodeQL matrix below.
  #       Valid values: 'c-cpp', 'csharp', 'go', 'java-kotlin',
  #       'javascript-typescript', 'python', 'ruby', 'swift'
  # ------------------------------------------------------------
  sast:
    name: SAST (CodeQL)
    runs-on: ubuntu-latest
    permissions:
      # Required for CodeQL to upload results to the Security tab
      security-events: write
      actions: read
      contents: read
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      # TODO: Set the correct language for your repository.
      #       Replace 'TODO-language' with one of the valid values
      #       listed in the job comment above.
      - name: Initialize CodeQL
        uses: github/codeql-action/init@v3
        with:
          languages: TODO-language
          # Optional: specify a custom query suite for stricter checks.
          # queries: security-extended

      # For compiled languages (C/C++, C#, Go, Java) CodeQL needs to
      # observe the build. Replace the autobuild step with your actual
      # build command if autobuild fails.
      - name: Autobuild
        uses: github/codeql-action/autobuild@v3

      - name: Perform CodeQL analysis
        uses: github/codeql-action/analyze@v3

  # ------------------------------------------------------------
  # DEPENDENCY SCANNING
  # Checks third-party dependencies for known CVEs.
  # Trivy is used here as a language-agnostic scanner that covers
  # npm, pip, Maven, Gradle, Go modules, Cargo, Gemfile, and more.
  # Results are uploaded to the GitHub Security tab (SARIF format).
  # ------------------------------------------------------------
  dependency-scan:
    name: Dependency Scan (Trivy)
    runs-on: ubuntu-latest
    permissions:
      # Required to upload SARIF results to the Security tab
      security-events: write
      contents: read
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      # Scan the repository filesystem for vulnerable dependencies.
      # 'fs' mode inspects lock files and manifests in the working tree.
      - name: Run Trivy vulnerability scanner
        uses: aquasecurity/trivy-action@0.20.0
        with:
          scan-type: fs
          scan-ref: .
          # Report only CRITICAL and HIGH severity findings by default.
          # TODO: Adjust severity threshold to match your risk tolerance.
          severity: CRITICAL,HIGH
          # Exit with a non-zero code if vulnerabilities are found,
          # causing the job to fail and block the PR.
          exit-code: '1'
          # Upload results to GitHub Security tab for visibility.
          format: sarif
          output: trivy-results.sarif
          # Ignore unfixed vulnerabilities to reduce noise.
          # TODO: Set to 'false' if you want to surface all findings.
          ignore-unfixed: true

      - name: Upload Trivy SARIF results to GitHub Security tab
        uses: github/codeql-action/upload-sarif@v3
        # Upload even if the scan step failed so results are always visible
        if: always()
        with:
          sarif_file: trivy-results.sarif

  # ------------------------------------------------------------
  # TESTS
  # Runs the project's automated test suite.
  # TODO: Replace the placeholder step below with the test runner
  #       appropriate for your language/runtime once confirmed.
  #       Examples:
  #         - JavaScript/TypeScript: jest, vitest, mocha
  #         - Python:                pytest, unittest
  #         - Go:                    go test ./...
  #         - Java:                  mvn test / gradle test
  #         - Ruby:                  bundle exec rspec
  # ------------------------------------------------------------
  test:
    name: Test
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      # TODO: Add language-specific setup step here (same as lint job).

      # TODO: Add dependency installation step here if required.

      # TODO: Replace this placeholder with your actual test command.
      - name: Run tests
        run: |
          echo "TODO: replace with real test command, e.g. 'npm test' or 'pytest'"
          exit 0

      # TODO: (Optional) Upload test coverage or results as an artifact.
      # - name: Upload test results
      #   if: always()
      #   uses: actions/upload-artifact@v4
      #   with:
      #     name: test-results
      #     path: TODO-path-to-test-results