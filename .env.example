# Application Configuration Template
# Updated for: HTTPS enforcement, health-check endpoint, and DataAnnotations input validation
# All new or changed keys are annotated with inline comments.

# ---------------------------------------------------------------------------
# SERVER / TRANSPORT SETTINGS
# ---------------------------------------------------------------------------

server:
  # The primary HTTP port (used only to redirect to HTTPS)
  http_port: 80

  # The HTTPS port for all encrypted traffic
  # NEW: Required for HTTPS enforcement — all HTTP requests redirect here
  https_port: 443

  # Enable HTTPS enforcement; HTTP requests are permanently redirected (301)
  # NEW: Set to true to activate the HTTPS redirect middleware
  enforce_https: true

  # HSTS (HTTP Strict Transport Security) settings
  # NEW: Instructs browsers to only contact this service over HTTPS
  hsts:
    # Enable HSTS header on all HTTPS responses
    enabled: true

    # Duration (in seconds) browsers should remember the HSTS policy
    # 31536000 = 1 year (recommended minimum for production)
    max_age_seconds: 31536000

    # Include subdomains in the HSTS policy
    include_subdomains: true

    # Allow preloading into browser HSTS preload lists
    preload: false

  # TLS certificate configuration
  # NEW: Required when enforce_https is true
  tls:
    # Path to the TLS certificate file (PEM or PFX depending on runtime)
    cert_file: "/etc/ssl/certs/app.crt"

    # Path to the TLS private key file
    key_file: "/etc/ssl/private/app.key"

    # Minimum TLS protocol version to accept
    # Reject TLS 1.0 and 1.1 as they are deprecated
    min_version: "TLS1_2"

# ---------------------------------------------------------------------------
# HEALTH-CHECK ENDPOINT
# ---------------------------------------------------------------------------

health_check:
  # Enable the dedicated health-check endpoint
  # NEW: Exposes a route for load balancers and orchestrators to probe
  enabled: true

  # URL path at which the health-check endpoint is served
  # NEW: Standard path expected by most orchestrators (Kubernetes, ECS, etc.)
  path: "/health"

  # Separate liveness and readiness probes if the runtime supports them
  # NEW: Liveness indicates the process is alive; readiness indicates it can serve traffic
  liveness_path: "/health/live"
  readiness_path: "/health/ready"

  # HTTP status code returned when the service is healthy
  healthy_status_code: 200

  # HTTP status code returned when the service is unhealthy
  unhealthy_status_code: 503

  # Whether to include detailed diagnostic information in the response body
  # Set to false in production to avoid leaking internal state
  include_details: false

  # Timeout (in milliseconds) for each individual health probe check
  timeout_ms: 5000

  # Optional: restrict health-check access to specific source IP ranges
  # Leave empty to allow all sources (typical for orchestrator probes)
  allowed_ips: []

# ---------------------------------------------------------------------------
# INPUT VALIDATION (DataAnnotations)
# ---------------------------------------------------------------------------

validation:
  # Enable automatic model/request validation using DataAnnotations
  # NEW: When true, requests with invalid input are rejected before reaching handlers
  enabled: true

  # Return HTTP 400 Bad Request automatically on validation failure
  # NEW: Prevents invalid data from reaching business logic
  auto_reject_invalid_requests: true

  # HTTP status code returned when validation fails
  validation_failure_status_code: 400

  # Include field-level validation error details in the error response body
  # Useful for API consumers; review before enabling in sensitive environments
  include_validation_errors_in_response: true

  # Format of the validation error response body
  # Options: "json", "xml"
  error_response_format: "json"

  # Maximum allowed length for generic string fields when no explicit
  # [MaxLength] annotation is present on the model
  # NEW: Acts as a global safety ceiling to prevent oversized payloads
  default_max_string_length: 1024

  # Maximum allowed request body size in bytes (e.g., 1 MB = 1048576)
  # NEW: Complements annotation-level validation with a transport-layer limit
  max_request_body_bytes: 1048576

# ---------------------------------------------------------------------------
# LOGGING
# ---------------------------------------------------------------------------

logging:
  level: "info"

  # NEW: Log HTTPS redirect events for audit and debugging
  log_https_redirects: true

  # NEW: Log validation failures (field name and constraint violated)
  # Avoid logging raw field values to prevent credential leakage in logs
  log_validation_failures: true

  # NEW: Log health-check probe requests
  # Set to false in high-traffic environments to reduce log noise
  log_health_check_requests: false