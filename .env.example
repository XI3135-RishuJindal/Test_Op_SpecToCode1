# If using Flask 3.x, the following new or updated keys may be required based on deprecated/removed features.

# FLASK_ENV is deprecated in Flask 2.3+; prefer FLASK_DEBUG and FLASK_RUN_ENV
# FLASK_ENV=development  # Removed/deprecated, use the following instead:

FLASK_DEBUG=0  # Set to 1 to enable debug mode, 0 to disable

FLASK_RUN_ENV=production  # Explicitly set the run environment to 'development' or 'production'

# For blueprint import compatibility in Flask 3.x, you may need to define the Flask application entrypoint explicitly
# FLASK_APP=your_app_module:create_app  # If using the application factory pattern

# If using deprecated JSON configuration or settings, migrate to standard JSON handling as required by Flask 3.x