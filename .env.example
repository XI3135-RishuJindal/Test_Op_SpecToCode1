# No base configuration file was provided and the upgrade context/spec does not identify:
# - language/runtime/build tool
# - package manager / dependency manifest type
# - CI/CD platform
# - specific vulnerable dependencies or target versions
# Therefore, a concrete dependency-upgrade configuration cannot be derived without inventing tool-specific keys.
#
# To proceed conservatively without inventing keys, this template captures ONLY the upgrade intent and required
# human inputs needed to generate a tool-specific config in a follow-up step.

upgrade:
  goal: "Remediate critical/high CVEs with patch/minor dependency bumps" # New: explicit statement of upgrade goal from spec
  strategy: "conservative" # New: per spec, patch/minor upgrades only (no major bumps)
  constraints:
    allow_major_version_bumps: false # New: enforces "patch/minor only" constraint from spec
    allow_minor_version_bumps: true # New: patch/minor allowed per spec
    allow_patch_version_bumps: true # New: patch/minor allowed per spec
  scope:
    direct_dependencies: true # New: acceptance criteria requires no Critical/High in direct deps
    transitive_dependencies: true # New: acceptance criteria targets transitive deps too (or dispositioned)
  verification:
    require_ci_green: true # New: acceptance criteria requires all existing CI checks pass
    require_build_success: true # New: acceptance criteria requires build completes and artifacts produced
    require_no_caller_changes: true # New: acceptance criteria requires no required changes to callers
  disposition_policy:
    enabled: true # New: acceptance criteria allows remaining findings only if explicitly dispositioned
    record_location: "TODO" # New: spec leaves where/how dispositions recorded as TODO; must be defined
    allowed_disposition_types:
      - "false_positive" # New: placeholder category; must be confirmed for chosen vuln tool
      - "acceptable_risk" # New: placeholder category; must be confirmed for chosen vuln tool
      - "not_exploitable" # New: placeholder category; must be confirmed for chosen vuln tool
      - "fix_unavailable" # New: placeholder category; must be confirmed for chosen vuln tool

inputs_required:
  repository_language: "TODO" # New: required to select correct dependency manifest and upgrade tooling
  runtime: "TODO" # New: required for selecting compatible patch/minor upgrades
  build_tool: "TODO" # New: required to ensure builds remain consistent
  package_manager: "TODO" # New: required to apply dependency bumps safely
  dependency_manifests:
    - "TODO" # New: e.g., list of manifest files (unknown); needed to apply upgrades
  ci_platform: "TODO" # New: needed to wire vulnerability scan into CI acceptance criteria
  vulnerability_scanner: "TODO" # New: tool that produces Critical/High findings and supports dispositions

reporting:
  outputs:
    dependency_upgrade_plan: "TODO" # New: path/name for generated plan artifact (tool-specific, TBD)
    vulnerability_scan_report: "TODO" # New: path/name for scan output artifact (tool-specific, TBD)
    dispositions_file: "TODO" # New: path/name for disposition record (must be defined)

# Deprecated/Not applicable:
# - No deprecated keys to remove/comment because no prior config was provided.