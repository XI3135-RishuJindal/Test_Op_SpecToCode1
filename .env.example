# CI Pipeline Configuration
# Generated for: CI pipeline setup with build and test stages
# Spec: Automated Build and Test pipeline triggered on push and pull requests
#
# NOTE: This is a template configuration. You MUST update the following
# placeholders before committing:
#   - <YOUR_BUILD_COMMAND>   : e.g. "npm run build", "mvn package", "go build ./..."
#   - <YOUR_TEST_COMMAND>    : e.g. "npm test", "mvn test", "pytest", "go test ./..."
#   - <YOUR_RUNTIME_IMAGE>   : e.g. "node:20", "python:3.12", "eclipse-temurin:21"
#   - <YOUR_INSTALL_COMMAND> : e.g. "npm ci", "pip install -r requirements.txt", "mvn dependency:resolve"
#
# CI/CD platform: GitHub Actions (default choice — replace with your platform's syntax if using
# GitLab CI, CircleCI, Bitbucket Pipelines, Jenkins, etc. See platform notes at bottom of file.)

name: CI  # Human-readable name shown in the GitHub Actions UI

# ── Triggers ──────────────────────────────────────────────────────────────────
# Run the pipeline on every push to any branch and on every pull request
# targeting the default branch. Adjust branch filters to match your workflow.
on:
  push:
    branches:
      - "**"          # All branches — narrow this down once branch strategy is confirmed
  pull_request:
    branches:
      - main          # TODO: confirm default/protected branch name (main vs master vs develop)

# ── Concurrency ───────────────────────────────────────────────────────────────
# Cancel in-progress runs for the same branch/PR when a new commit is pushed,
# avoiding redundant work and queue buildup.
concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

# ── Jobs ──────────────────────────────────────────────────────────────────────
jobs:

  # ── Stage 1: Build ──────────────────────────────────────────────────────────
  # Checks out source, installs dependencies, and compiles/assembles the project.
  # Artifacts produced here are passed to the test stage to avoid rebuilding.
  build:
    name: Build
    runs-on: ubuntu-latest   # TODO: change runner if a self-hosted or OS-specific runner is required

    steps:
      # Step 1 — Check out the full repository at the triggering commit
      - name: Checkout source code
        uses: actions/checkout@v4   # v4 is the current stable release of the checkout action

      # Step 2 — Set up the project runtime/SDK
      # Replace this block with the appropriate setup action for your stack, e.g.:
      #   actions/setup-node@v4      (Node.js)
      #   actions/setup-python@v5    (Python)
      #   actions/setup-java@v4      (Java/Kotlin)
      #   actions/setup-go@v5        (Go)
      #   actions/setup-dotnet@v4    (.NET)
      - name: Set up runtime
        # EXAMPLE (Node.js — replace entirely for your language):
        # uses: actions/setup-node@v4
        # with:
        #   node-version: "20"        # TODO: pin to your required runtime version
        #   cache: "npm"              # TODO: set cache key to your package manager (npm/yarn/pnpm/pip/maven/gradle)
        run: |
          echo "TODO: Replace this step with the correct runtime setup action for your stack."
          echo "See the comment block above for examples."

      # Step 3 — Install project dependencies
      # Caching is handled by the setup action above (where supported).
      - name: Install dependencies
        run: <YOUR_INSTALL_COMMAND>   # e.g. npm ci | pip install -r requirements.txt | mvn dependency:resolve -q

      # Step 4 — Compile / assemble the project
      - name: Build project
        run: <YOUR_BUILD_COMMAND>     # e.g. npm run build | mvn package -DskipTests | go build ./...

      # Step 5 — Upload build output so the test job can consume it without rebuilding
      # Adjust the 'path' to match your actual build output directory.
      - name: Upload build artifacts
        uses: actions/upload-artifact@v4   # v4 is the current stable release
        with:
          name: build-output              # Artifact bundle name referenced by the test job
          path: |
            dist/                         # TODO: replace with your actual build output path(s)
            build/                        # e.g. target/ for Maven, out/ for Gradle, dist/ for JS
          if-no-files-found: warn         # Warn (not fail) if no files match — tighten to 'error' once paths are confirmed
          retention-days: 1               # Short retention — artifacts are only needed within this pipeline run

  # ── Stage 2: Test ───────────────────────────────────────────────────────────
  # Downloads the build artifacts produced above and executes the test suite.
  # This job only starts after 'build' completes successfully (needs: build).
  test:
    name: Test
    runs-on: ubuntu-latest   # Must match (or be compatible with) the build runner
    needs: build              # Enforces sequential Build → Test ordering; test is skipped if build fails

    steps:
      # Step 1 — Check out source code (test configuration/scripts may live in the repo)
      - name: Checkout source code
        uses: actions/checkout@v4

      # Step 2 — Set up the same runtime as the build job
      # Keep this in sync with the setup step in the build job above.
      - name: Set up runtime
        run: |
          echo "TODO: Replace this step with the same runtime setup action used in the build job."

      # Step 3 — Install dependencies required to run tests
      # If your test runner is included in the main dependency install, reuse the same command.
      - name: Install dependencies
        run: <YOUR_INSTALL_COMMAND>   # Same command as build job, or a test-only subset

      # Step 4 — Download the build artifacts produced by the build job
      - name: Download build artifacts
        uses: actions/download-artifact@v4   # v4 matches the upload action version above
        with:
          name: build-output                 # Must match the 'name' used in upload-artifact above

      # Step 5 — Execute the test suite
      # TODO: confirm test runner, test directory locations, and any required environment variables.
      - name: Run tests
        run: <YOUR_TEST_COMMAND>      # e.g. npm test | pytest | mvn test | go test ./... | dotnet test

      # Step 6 (optional) — Publish test results for visibility in the GitHub UI
      # Uncomment and configure once test report format is known.
      # - name: Publish test report
      #   uses: actions/upload-artifact@v4
      #   if: always()               # Upload even on test failure so results are always available
      #   with:
      #     name: test-results
      #     path: |
      #       test-results/          # TODO: replace with your test runner's report output path
      #       coverage/              # TODO: include coverage reports if generated
      #     retention-days: 7

# ── Open Items (from spec) ─────────────────────────────────────────────────────
# The following items are flagged as TODO in the spec and must be resolved before
# this pipeline is considered production-ready:
#
#   1. Confirm runtime/language version and replace placeholder setup steps.
#   2. Confirm build command and replace <YOUR_BUILD_COMMAND>.
#   3. Confirm test runner and replace <YOUR_TEST_COMMAND>.
#   4. Confirm dependency install command and replace <YOUR_INSTALL_COMMAND>.
#   5. Confirm build output path(s) and update the upload-artifact 'path' list.
#   6. Confirm default/protected branch name and update the pull_request trigger.
#   7. Decide on branch protection enforcement: require this workflow to pass before merge.
#   8. Narrow the push trigger branch filter once a branching strategy is established.
#
# ── Platform Alternatives ──────────────────────────────────────────────────────
# If you are NOT using GitHub Actions, replace this file with the equivalent for
# your platform. Structural equivalents:
#
#   GitLab CI (.gitlab-ci.yml):
#     stages: [build, test]
#     build-job: { stage: build, script: [...], artifacts: { paths: [...] } }
#     test-job:  { stage: test,  script: [...], dependencies: [build-job] }
#
#   CircleCI (.circleci/config.yml):
#     workflows > jobs: [build, { test: { requires: [build] } }]
#
#   Bitbucket Pipelines (bitbucket-pipelines.yml):
#     pipelines > default: [step: build, step: test]
#
#   Jenkins (Jenkinsfile — declarative):
#     pipeline { stages { stage('Build') {...} stage('Test') {...} } }