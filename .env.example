# Added for enhanced automated test coverage and refactoring

# Enable detailed test logging
TEST_LOG_LEVEL=debug

# Directory where test coverage reports will be stored
TEST_COVERAGE_OUTPUT=coverage/

# Specify test runner (e.g., jest, pytest, mocha)
TEST_RUNNER=jest

# Enable collecting coverage from all files
TEST_COVERAGE_ALL=true

# Thresholds for test coverage enforcement
TEST_COVERAGE_THRESHOLDS_LINES=80
TEST_COVERAGE_THRESHOLDS_FUNCTIONS=80
TEST_COVERAGE_THRESHOLDS_BRANCHES=75

# Pattern for test files
TEST_FILE_PATTERN=**/*.test.js

# Timeout for each test (in milliseconds)
TEST_TIMEOUT=30000