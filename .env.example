# EF Core + SQLite/PostgreSQL Persistent Store — Configuration Template
#
# This file was generated to support the replacement of the static in-memory
# store with an EF Core persistent store (SQLite for dev/test, PostgreSQL for
# production). No original configuration file was present in the base source,
# so a complete, working template is provided here.
#
# ── HOW TO USE ────────────────────────────────────────────────────────────────
# 1. Copy this file to appsettings.json (and appsettings.Development.json, etc.)
#    in your project root, or merge the relevant sections into your existing
#    appsettings files.
# 2. Fill in every value marked  <REPLACE_...> before running the application.
# 3. Never commit secrets (passwords, connection strings with credentials) to
#    source control — use environment variables, dotnet user-secrets, or a
#    secrets manager instead.
# ─────────────────────────────────────────────────────────────────────────────

{
  # ── Database provider selection ──────────────────────────────────────────────
  # NEW KEY (upgrade): Tells the application which EF Core provider to activate.
  # Accepted values:
  #   "Sqlite"     — lightweight file-based database; recommended for local
  #                  development and automated tests.
  #   "PostgreSQL" — full relational server; required for production and any
  #                  multi-instance / load-balanced deployment.
  # The application startup code must read this key and register the correct
  # DbContext options (UseSqlite / UseNpgsql) accordingly.
  "DatabaseProvider": "Sqlite",

  # ── Connection strings ────────────────────────────────────────────────────────
  # NEW SECTION (upgrade): Connection strings were not required by the previous
  # static in-memory store. Both entries are provided so the correct one is
  # already present when switching environments; only the active provider's
  # string is used at runtime.
  "ConnectionStrings": {

    # NEW KEY (upgrade): SQLite connection string used when DatabaseProvider = "Sqlite".
    # "Data Source" is the path to the .db file, relative to the working directory
    # (typically the project root during development, or the app base path in
    # production containers).
    # Change the filename to match your application's domain (e.g., "myapp.db").
    "Sqlite": "Data Source=app.db",

    # NEW KEY (upgrade): PostgreSQL / Npgsql connection string used when
    # DatabaseProvider = "PostgreSQL".
    # Replace every <REPLACE_...> placeholder with real values.
    # For production, supply this string via an environment variable or secrets
    # manager rather than storing credentials in this file.
    #
    # Minimum required parameters:
    #   Host     — hostname or IP of the PostgreSQL server
    #   Port     — default PostgreSQL port is 5432
    #   Database — name of the target database (must exist or migrations must
    #              be allowed to create it)
    #   Username — database user with CREATE / ALTER / SELECT / INSERT /
    #              UPDATE / DELETE privileges on the target database
    #   Password — credential for the above user
    #
    # Optional but recommended for production:
    #   Pooling=true;MinPoolSize=1;MaxPoolSize=20
    #   SslMode=Require;TrustServerCertificate=false
    "PostgreSQL": "Host=<REPLACE_HOST>;Port=5432;Database=<REPLACE_DATABASE>;Username=<REPLACE_USERNAME>;Password=<REPLACE_PASSWORD>"
  },

  # ── EF Core migration behaviour ───────────────────────────────────────────────
  # NEW SECTION (upgrade): Controls how EF Core database migrations are applied
  # at application startup. These keys replace the previous "no-op" initialisation
  # that was implicit in the static in-memory store.
  "EFCore": {

    # NEW KEY (upgrade): When true, the application calls
    # dbContext.Database.MigrateAsync() on startup, automatically applying any
    # pending EF Core migrations to the target database.
    # Recommended value:
    #   true  — development and CI environments (convenient, low risk)
    #   false — production (prefer running migrations as an explicit deployment
    #           step via `dotnet ef database update` or a migration job/init
    #           container to avoid race conditions in multi-instance deployments)
    "ApplyMigrationsOnStartup": true,

    # NEW KEY (upgrade): When true AND DatabaseProvider = "Sqlite", the application
    # will delete and recreate the SQLite database file on every startup.
    # Useful for integration tests or demo resets.
    # MUST be false in any environment where data durability is required.
    "RecreateDatabaseOnStartup": false,

    # NEW KEY (upgrade): Enables EF Core's detailed query logging (SQL statements,
    # parameter values, execution times). Set to true only in development or when
    # diagnosing query performance issues. Produces verbose output and may expose
    # sensitive parameter values in logs.
    "EnableDetailedErrors": false,

    # NEW KEY (upgrade): Enables EF Core sensitive data logging, which includes
    # actual parameter values in log output. Never enable in production.
    "EnableSensitiveDataLogging": false,

    # NEW KEY (upgrade): EF Core command timeout in seconds. Applies to all
    # database commands executed through the DbContext. Increase for long-running
    # migration or bulk-operation scenarios. Default EF Core value is 30 s.
    "CommandTimeoutSeconds": 30
  },

  # ── Logging ───────────────────────────────────────────────────────────────────
  # Updated section (upgrade): Added Microsoft.EntityFrameworkCore log categories
  # so EF Core SQL output is visible at the appropriate level without flooding
  # application logs. Adjust levels per environment.
  "Logging": {
    "LogLevel": {
      "Default": "Information",

      # Shows EF Core informational messages (migrations applied, connection
      # opened, etc.) without showing individual SQL statements.
      "Microsoft.EntityFrameworkCore": "Warning",

      # Shows the SQL generated by EF Core for every query/command.
      # Set to "Information" or "Debug" only when diagnosing query issues.
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",

      # Logs migration activity (which migrations are pending / applied).
      "Microsoft.EntityFrameworkCore.Migrations": "Information"
    }
  }
}