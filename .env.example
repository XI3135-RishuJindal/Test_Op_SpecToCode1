# SQLALCHEMY_ENGINE_ECHO enables SQL statement logging in SQLAlchemy 2.x
SQLALCHEMY_ENGINE_ECHO=false

# SQLALCHEMY_ENGINE_FUTURE ensures future-style engine (required in SQLAlchemy 2.x)
SQLALCHEMY_ENGINE_FUTURE=true

# SQLALCHEMY_DATABASE_URI should be explicitly provided in the updated format (if not already)
SQLALCHEMY_DATABASE_URI=sqlite:///example.db  # Update URI as appropriate for your environment