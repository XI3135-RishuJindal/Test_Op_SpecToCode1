# Application configuration template for Flask + SQLAlchemy compatibility
# This file provides the necessary configuration keys for a Flask web application
# utilizing SQLAlchemy as its ORM.

# --- FLASK CORE SETTINGS ---

# The import path for the Flask app (used by WSGI/ASGI servers or Flask CLI)
FLASK_APP = "app.py"  # New key: entrypoint for Flask application

# Enable or disable Flask debugging (set to True only in development)
DEBUG = False  # New key: standard Flask debugging switch

# The secret key used for Flask session signing and CSRF (should be overridden in production)
SECRET_KEY = "replace-this-secret"  # New key: required for Flask security features

# --- SQLALCHEMY SETTINGS ---

# Database connection string (must be customized for production)
SQLALCHEMY_DATABASE_URI = "sqlite:///app.db"  # New key: SQLAlchemy connection string (default: local SQLite database)

# If True, Flask-SQLAlchemy will track object modifications (disable for performance)
SQLALCHEMY_TRACK_MODIFICATIONS = False  # New key: recommended for SQLAlchemy integration

# Optional: SQLAlchemy engine echo (set to True for verbose SQL query logging)
SQLALCHEMY_ECHO = False  # New key: enables SQL statement logging for debugging

# --- ADDITIONAL FLASK / SQLALCHEMY OPTIONS (May be extended as needed) ---

# Optionally, customize default Flask server host and port
# FLASK_RUN_HOST = "127.0.0.1"  # Uncomment and set as needed
# FLASK_RUN_PORT = 5000         # Uncomment and set as needed

# Placeholders for further extensions:
# For example, authentication provider settings, blueprint registrations, or
# SQLALCHEMY_POOL_SIZE, etc., can be added below as requirements are defined.