# ──────────────────────────────────────────────────────────────────────────────
# Pharmacy Microservice — Environment Variables
# Copy this file to .env and fill in the values before running the service.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# JDBC connection URL for PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/pharmacy_db

# Database credentials
DB_USERNAME=pharmacy_user
DB_PASSWORD=change_me_in_production

# ── Server ────────────────────────────────────────────────────────────────────
# HTTP port the service listens on
SERVER_PORT=8080

# ── Logging ───────────────────────────────────────────────────────────────────
# Application log level: TRACE | DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# ── JPA / Hibernate ───────────────────────────────────────────────────────────
# Set to true to print SQL statements (development only)
JPA_SHOW_SQL=false
