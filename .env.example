{
  // ASP.NET Core application settings
  // Migrated from ASP.NET Web API 2 (System.Web stack) to ASP.NET Core

  // Logging configuration — replaces System.Web trace/diagnostics
  // ASP.NET Core uses a structured logging abstraction (Microsoft.Extensions.Logging)
  "Logging": {
    "LogLevel": {
      // Default minimum log level for all categories
      "Default": "Information",
      // ASP.NET Core infrastructure logs — set to Warning to reduce noise
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // Kestrel replaces IIS/System.Web as the primary HTTP server in ASP.NET Core
  // Configure endpoint bindings here; override per environment in appsettings.{Environment}.json
  "Kestrel": {
    "Endpoints": {
      "Http": {
        // Default HTTP endpoint — adjust port as needed
        "Url": "http://localhost:5000"
      },
      "Https": {
        // Default HTTPS endpoint — adjust port as needed
        "Url": "https://localhost:5001"
      }
    }
  },

  // AllowedHosts replaces System.Web host header validation
  // "*" permits all hosts; restrict in production (e.g., "api.example.com;localhost")
  "AllowedHosts": "*",

  // JSON serialization options — ASP.NET Core uses System.Text.Json by default
  // (replaces Json.NET/Newtonsoft defaults wired in WebApiConfig)
  // To switch back to Newtonsoft, add Microsoft.AspNetCore.Mvc.NewtonsoftJson and
  // call builder.Services.AddControllers().AddNewtonsoftJson() in Program.cs
  "JsonOptions": {
    // Preserve camelCase property naming consistent with Web API 2 default serializer behaviour
    "PropertyNamingPolicy": "CamelCase",
    // Do not serialize null values — mirrors common Web API 2 Newtonsoft default
    "DefaultIgnoreCondition": "WhenWritingNull"
  },

  // Model validation behaviour — replaces Web API 2 ModelState + HttpError responses
  // ASP.NET Core's built-in ApiBehaviorOptions handles automatic 400 responses
  // when [ApiController] is applied and ModelState is invalid
  "ApiBehavior": {
    // Automatically return HTTP 400 with validation problem details on invalid ModelState
    // Mirrors Web API 2 behaviour driven by ApiController.ModelState checks
    "SuppressModelStateInvalidFilter": false,
    // Return RFC 7807 ProblemDetails format for client/server errors
    "SuppressMapClientErrors": false
  },

  // Routing — replaces HttpRouteCollection / WebApiConfig.Register convention routes
  // Attribute routing ([Route], [HttpGet], etc.) is the recommended approach in ASP.NET Core
  // Convention-based routes can be added in Program.cs via app.MapControllerRoute(...)
  "Routing": {
    // Lowercase URLs — recommended for REST APIs; not enforced by default in Web API 2
    "LowercaseUrls": true,
    // Lowercase query strings
    "LowercaseQueryStrings": true
  },

  // CORS — replaces Web API 2 Microsoft.AspNet.WebApi.Cors configuration
  // Define named policies here and reference them in Program.cs via app.UseCors("PolicyName")
  "Cors": {
    "DefaultPolicy": {
      // Restrict to known origins in production
      "AllowedOrigins": [ "*" ],
      "AllowedMethods": [ "GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS" ],
      "AllowedHeaders": [ "*" ]
    }
  },

  // Dependency injection is built into ASP.NET Core — no IDependencyResolver shim required
  // Register services in Program.cs using builder.Services.Add*()
  // The section below is a placeholder for any service-lifetime configuration
  // that was previously expressed in a custom IDependencyResolver implementation
  "DependencyInjection": {
    // ServiceLifetime options: Singleton | Scoped | Transient
    // Document per-service lifetime decisions here for reference
    "DefaultControllerLifetime": "Scoped"
  },

  // Authentication/Authorization — replaces Web API 2 message handler or OWIN middleware
  // Configure schemes in Program.cs via builder.Services.AddAuthentication(...)
  "Authentication": {
    // Scheme used when [Authorize] is applied without an explicit scheme
    // Common values: "Bearer" (JWT), "Cookies", "ApiKey"
    "DefaultScheme": "Bearer",
    "JwtBearer": {
      // Issuer and audience must match the token producer
      "Authority": "",
      "Audience": "",
      // Validate issuer signing key — always true in production
      "ValidateIssuerSigningKey": true
    }
  },

  // Health checks — new in ASP.NET Core; no Web API 2 equivalent
  // Enable via builder.Services.AddHealthChecks() and app.MapHealthChecks("/health")
  "HealthChecks": {
    "Enabled": true,
    "Path": "/health"
  }
}