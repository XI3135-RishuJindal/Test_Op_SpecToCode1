.github/dependabot.yml

# Dependabot configuration for automated dependency update PRs.
# Documentation: https://docs.github.com/en/code-security/dependabot/dependabot-version-updates/configuration-options-for-the-dependabot.yml-file

version: 2

updates:
  # --- GitHub Actions ---
  # Keeps workflow action versions (e.g. actions/checkout@v3) up to date.
  - package-ecosystem: "github-actions"
    # Dependabot scans the .github/workflows directory automatically for this ecosystem.
    directory: "/"
    schedule:
      # Run version checks every Monday at 09:00 UTC.
      interval: "weekly"
      day: "monday"
      time: "09:00"
      timezone: "UTC"
    # Limit the number of open PRs at any one time to avoid PR queue flooding.
    open-pull-requests-limit: 5
    # Group all GitHub Actions updates into a single PR to reduce noise.
    groups:
      github-actions-all:
        patterns:
          - "*"
    # Label PRs for easy filtering and triage.
    labels:
      - "dependencies"
      - "github-actions"
    # Commit message prefix for changelogs and filtering.
    commit-message:
      prefix: "chore(deps)"

