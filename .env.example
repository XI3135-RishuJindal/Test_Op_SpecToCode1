# ---- BEGIN GITLAB CI YAML ---------------------------------------------------
#
# # NEW: Define the three pipeline stages in execution order.
# # Each stage must complete successfully before the next begins.
# stages:
#   - test    # NEW: Stage 1 — automated test execution
#   - lint    # NEW: Stage 2 — code style and static analysis
#   - sast    # NEW: Stage 3 — security scanning
#
# # NEW: Default settings inherited by all jobs unless overridden.
# default:
#   # TODO: Replace with the correct Docker image for your language/runtime, e.g.:
#   #   node:20-alpine          (Node.js 20)
#   #   python:3.12-slim        (Python 3.12)
#   #   maven:3.9-eclipse-temurin-21  (Java 21 / Maven)
#   #   golang:1.22-alpine      (Go 1.22)
#   #   mcr.microsoft.com/dotnet/sdk:8.0  (.NET 8)
#   image: TODO-language-runtime-image:TODO-version
#
#   # NEW: Cache dependencies between jobs to speed up the pipeline.
#   # TODO: Adjust the cache key and paths to match your build tool's dependency directory.
#   cache:
#     key:
#       files:
#         - TODO-lockfile-path   # e.g. package-lock.json, requirements.txt, go.sum, pom.xml
#     paths:
#       - TODO-dependency-cache-dir   # e.g. node_modules/, .pip-cache/, .m2/repository/
#
# # ---------------------------------------------------------------------------
# # STAGE 1 — TEST
# # ---------------------------------------------------------------------------
# run-tests:
#   stage: test
#   script:
#     # TODO: Replace with the correct install and test commands for your build tool.
#     - TODO-install-command   # e.g. npm ci, pip install -r requirements.txt, mvn dependency:resolve
#     - TODO-test-command      # e.g. npm test, pytest, mvn test, go test ./...
#   # NEW: Collect test result artifacts for review in the GitLab UI.
#   artifacts:
#     when: always   # NEW: upload even on failure for diagnosability
#     reports:
#       # NEW: JUnit XML report enables inline test result display in merge requests.
#       # TODO: Set the path to where your test runner writes JUnit XML output.
#       # Remove this block if your runner does not produce JUnit XML.
#       junit: TODO-junit-xml-path   # e.g. test-results/junit.xml, target/surefire-reports/*.xml
#     paths:
#       - TODO-test-results-path   # e.g. coverage/, test-results/
#     expire_in: 14 days   # NEW: retain artifacts for 14 days; adjust as needed
#
# # ---------------------------------------------------------------------------
# # STAGE 2 — LINT
# # ---------------------------------------------------------------------------
# run-lint:
#   stage: lint
#   script:
#     # TODO: Replace with the correct install and lint commands for your build tool.
#     - TODO-install-command   # same install command as the test job
#     - TODO-lint-command      # e.g. npx eslint ., flake8 ., golangci-lint run
#
# # ---------------------------------------------------------------------------
# # STAGE 3 — SAST
# # GitLab provides a built-in SAST template that auto-detects the language.
# # NEW: Include the GitLab-managed SAST template (requires GitLab Ultimate for
# #      full MR widget integration; findings are still reported on all tiers).
# # ---------------------------------------------------------------------------
# include:
#   - template: Security/SAST.gitlab-ci.yml   # NEW: GitLab-native SAST auto-detection
#
# # NEW: Override SAST job variables to customise behaviour.
# # See https://docs.gitlab.com/ee/user/application_security/sast/ for all variables.
# variables:
#   # NEW: Disable specific analysers if they are not relevant to your language.
#   # TODO: Set to "true" to disable analysers you do not need, reducing scan time.
#   SAST_EXCLUDED_ANALYZERS: ""   # e.g. "bandit, eslint" — leave empty to run all
#
#   # NEW: Fail the pipeline if findings at or above this severity are detected.
#   # TODO: Adjust threshold to match your security policy (Critical, High, Medium, Low, Info).
#   SAST_SEVERITY_LEVEL: "High"
#
#   # NEW: Exclude paths that should not be scanned (e.g. vendored code, generated files).
#   # TODO: Add comma-separated glob patterns for paths to exclude, or leave empty.
#   SAST_EXCLUDED_PATHS: "spec, test, tests, tmp"   # TODO: adjust to your project layout
#
# ---- END GITLAB CI YAML -----------------------------------------------------


