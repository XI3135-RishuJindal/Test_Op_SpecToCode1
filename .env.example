# ─────────────────────────────────────────────────────────────────────────────
# Identity Registration & Verification Service — Environment Variables
# Copy this file to .env and fill in the values before running the service.
# ─────────────────────────────────────────────────────────────────────────────

# Application
NODE_ENV=development
PORT=3000

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=changeme
DB_NAME=identity_db
# Set to true only in development to auto-sync schema (never in production)
DB_SYNCHRONIZE=false
# Set to true when connecting to a managed PostgreSQL instance with TLS
DB_SSL=false

# ─── Security ─────────────────────────────────────────────────────────────────
# Secret used for signing internal JWTs (min 32 chars, high entropy)
JWT_SECRET=replace-with-a-long-random-secret-value

# ─── Verification Token ───────────────────────────────────────────────────────
# How long (in minutes) a verification token remains valid
VERIFICATION_TOKEN_TTL_MINUTES=60

# ─── Redis (optional — for ephemeral idempotency references) ─────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# ─── OpenTelemetry ────────────────────────────────────────────────────────────
OTEL_SERVICE_NAME=identity-registration-verification-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
