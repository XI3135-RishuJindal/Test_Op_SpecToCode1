# .env.example
# Configuration template for upgraded runtime (Python 3.12+) with Flask 3.x and SQLAlchemy 2.x.
# Copy to ".env" for local development and set real values in your deployment environment.
# Do not commit secrets.

# --- Runtime / Flask ---
FLASK_ENV=production  # CHANGED/DEPRECATED: Flask 3.x no longer uses FLASK_ENV to control environment; keep only for legacy tooling compatibility (safe to remove once confirmed unused).
FLASK_DEBUG=0         # NEW: Use FLASK_DEBUG=1 to enable debug mode locally; Flask 3.x prefers explicit debug flag over FLASK_ENV.

# Flask application entrypoint (for `flask --app ...` style usage)
FLASK_APP=app:create_app  # NEW: Flask 3.x recommends the application factory pattern (module:function).

# --- Server ---
PORT=8000  # NEW: Externalized listen port for WSGI server / deployment runtime.

# --- Database (SQLAlchemy 2.x) ---
# Replaces any hardcoded DATABASE_URL in code. Must be provided via environment.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/app  # NEW: SQLAlchemy 2.x engine URL; externalized and required.

# SQLAlchemy 2.x defaults favor "future" style; code should create engine/session explicitly.
SQLALCHEMY_ECHO=0  # NEW: If set to 1, SQLAlchemy will log SQL statements (useful for debugging).

# --- Migrations (Alembic) ---
# Alembic reads the DB URL from config; standardize via env var so env.py can reference it.
ALEMBIC_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/app  # NEW: Explicit Alembic DB URL source (can be set equal to DATABASE_URL).

# --- Secrets / Security ---
SECRET_KEY=changeme  # NEW: Flask SECRET_KEY must come from environment (do not hardcode). Use a strong random value in production.

# --- Deprecated keys (kept as commented references) ---
# DATABASE_URI=  # DEPRECATED: Use DATABASE_URL (SQLAlchemy engine URL) instead.
# SQLALCHEMY_DATABASE_URI=  # DEPRECATED: Flask-SQLAlchemy style key; prefer explicit engine/session creation in SQLAlchemy 2.x.