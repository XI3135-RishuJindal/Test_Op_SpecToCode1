name: CI

on:
  push:
  pull_request:

jobs:
  sbom:
    name: Generate SBOM (CycloneDX)
    runs-on: ubuntu-latest
    permissions:
      contents: read # NEW: required to checkout repository contents for SBOM generation
    steps:
      - name: Checkout
        uses: actions/checkout@v4 # NEW: ensures repository sources are available to the SBOM tool

      - name: Generate SBOM
        uses: CycloneDX/gh-action-generate-sbom@v2 # NEW: generates a CycloneDX SBOM from the repository/build context
        with:
          output: sbom.cdx.json # NEW: standardizes the SBOM output filename for downstream retrieval
          format: json # NEW: explicitly sets CycloneDX JSON output to meet acceptance criteria

      - name: Upload SBOM artifact
        uses: actions/upload-artifact@v4 # NEW: publishes the SBOM as a retrievable CI output associated with the run
        with:
          name: sbom-cyclonedx # NEW: stable artifact name for consumers to find the SBOM
          path: sbom.cdx.json # NEW: uploads the generated SBOM file from the previous step
          if-no-files-found: error # NEW: fails the job if SBOM was not produced, enforcing acceptance criteria