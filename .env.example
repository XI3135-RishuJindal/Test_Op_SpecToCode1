# Test configuration template
# This configuration expands and hardens both unit and integration test coverage as per upgrade goal.

[tests]
# Enable both unit and integration tests for expanded coverage
enable_unit_tests = true                   # New: Ensure unit tests are run to expand coverage
enable_integration_tests = true            # New: Ensure integration tests are run and coverage is measured

# Specify minimum required coverage thresholds (upgrade requires at least 80% total)
min_coverage = 80                          # New: Fail if test coverage is below 80%

# Optionally, enforce coverage on critical modules (names unknown, template structure provided)
# critical_modules = ["module1", "module2"]   # New: (uncomment and fill as needed) List of modules requiring full coverage

# Hardened (reliable, deterministic) test suite
fail_on_flaky_tests = true                 # New: Make tests fail if flakiness is detected

# Parallel execution to improve reliability and speed (if supported)
parallel_execution = true                  # New: Run tests in parallel where possible to surface concurrency issues

# Test result reporting
report_format = "summary"                  # New: Standardized report for CI/CD systems

# All other configuration keys or settings are left to project defaults or to be filled as discovered.