# SQLALCHEMY_ENGINE_OPTIONS: JSON string for engine settings (SQLAlchemy 2.x recommended)
# Example: '{"future": true, "pool_pre_ping": true}'
SQLALCHEMY_ENGINE_OPTIONS= # JSON string, enable new 2.x engine features

# SQLALCHEMY_WARN_20: Set to '1' to enable 2.0 API deprecation warnings (optional, for upgrade assistance)
SQLALCHEMY_WARN_20=0

# SQLALCHEMY_ECHO: Set to 'True' for verbose SQL logging in 2.x (optional)
SQLALCHEMY_ECHO=False