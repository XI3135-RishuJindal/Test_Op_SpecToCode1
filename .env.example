# Configuration File Template
# All secrets must now be sourced from environment variables as per upgraded security standards.

database:
  # Remove static password and user fields; replaced by environment variable references.
  host: localhost
  port: 5432
  name: app_db
  user: ${DB_USER}       # Username for database; now sourced from 'DB_USER' environment variable.
  password: ${DB_PASSWORD} # Database password; now sourced from 'DB_PASSWORD' environment variable.

api:
  # Remove static API key; replaced by environment variable reference.
  url: https://api.example.com
  token: ${API_TOKEN}     # API token now sourced from 'API_TOKEN' environment variable.

security:
  secret_key: ${SECRET_KEY} # Application secret key now sourced from 'SECRET_KEY' environment variable.

# Deprecated fields (do not use; shown for upgrade context):
# database:
#   user: "app_user"
#   password: "hardcoded_password"
# api:
#   token: "hardcoded_token"
# security:
#   secret_key: "hardcoded_secret"

# All applications and scripts must obtain secrets above from their respective environment variables.
# Example: export DB_USER=myuser; export DB_PASSWORD=mypass; export API_TOKEN=abcd; export SECRET_KEY=s3cr3t