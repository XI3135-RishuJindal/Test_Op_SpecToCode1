#     name: Test
#     runs-on: ubuntu-latest
#     needs: build   # NEW: 'needs' enforces stage ordering; test runs only after build succeeds
#     steps:
#       - name: Checkout source
#         uses: actions/checkout@v4
#
#       - name: Download build artifacts
#         uses: actions/download-artifact@v4   # NEW: retrieve artifacts produced by build stage
