# RuntimeConfig: .NET 8 upgrade
# Update the TargetFramework for .NET 8 runtime if in applicable configuration files (e.g., launchSettings.json, appsettings.json, or .env files usually do not hold the TFM; project file should be updated separately.)
# Below are commonly relevant environment variables for .NET 8

# Set DOTNET environment version for runtime binding
DOTNET_ENVIRONMENT=Production # Set to 'Development' or 'Staging' as appropriate

# Optional: Enable improved assembly load tracing (new in .NET 8)
DOTNET_EnableAssemblyLoadTracing=false # Set to 'true' to enable detailed trace logging for assembly loads

# Specify GC Heap Hard Limit if you want deterministic memory management (recommended in .NET 8 for containerized/cloud scenarios)
DOTNET_GCHeapHardLimit= # e.g., 2147483648 for 2GB; uncomment and set if needed

# Enable ReadyToRun images by default, enhances startup on .NET 8
DOTNET_ReadyToRun=true

# Configure Dynamic PGO tiered compilation (more effective in .NET 8)
DOTNET_TieredPGO=1 # Set to '0' to disable, '1' to enable (default)

# Optional: Enable startup hooks, more extensible in .NET 8
DOTNET_STARTUP_HOOKS= # Path to custom startup hooks assembly, if used

# If using ASP.NET Core on .NET 8:
ASPNETCORE_ENVIRONMENT=Production # or 'Development'
ASPNETCORE_URLS=http://localhost:5000 # Set appropriate URLs

# If using minimal hosting APIs, set host builder options explicitly (New in .NET 8)
DOTNET_HOSTBUILDER__RELOADCONFIGONCHANGE=true

# All other existing appsettings/environment config remains unchanged.