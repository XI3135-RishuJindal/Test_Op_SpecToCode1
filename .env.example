name: CI

on:
  push:
    branches:
      - "**" # NEW: ensure SBOM and security scan artifacts are produced on all branch pushes (adjust if your repo restricts CI to specific branches)
    tags:
      - "*" # NEW: ensure release/tag builds also publish SBOM and security scan artifacts
  pull_request:
    branches:
      - "**" # NEW: ensure PR validation runs publish SBOM and security scan artifacts for auditability

permissions:
  contents: read # NEW: least-privilege default required for checkout; scanners may require additional permissions depending on tool choice

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      # NEW: Create placeholder artifact outputs.
      # Rationale: The spec requires SBOM and security scan artifacts to be "consistently generated, retained, and accessible"
      # even when language/build tool and scanner choices are unknown at this stage.
      - name: Generate SBOM and security scan artifacts (placeholder)
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p artifacts/sbom artifacts/security

          # Placeholder SBOM artifact (replace with real SBOM generation, e.g., CycloneDX/SPDX tooling, in your project later).
          cat > artifacts/sbom/sbom.json <<'EOF'
          {
            "note": "PLACEHOLDER SBOM - replace with real SBOM generation output (e.g., CycloneDX or SPDX).",
            "generatedBy": "CI placeholder step",
            "spec": "SBOM artifact publication requirement"
          }
          EOF

          # Placeholder security scan artifact (replace with real scanner output later).
          cat > artifacts/security/security-scan.json <<'EOF'
          {
            "note": "PLACEHOLDER security scan report - replace with real scanner output.",
            "generatedBy": "CI placeholder step",
            "spec": "Security scan artifact publication requirement"
          }
          EOF

      # NEW: Upload SBOM artifacts so they are retained and accessible after CI runs.
      - name: Upload SBOM artifact
        uses: actions/upload-artifact@v4
        with:
          name: sbom # NEW: stable artifact name for downstream/audit consumption
          path: artifacts/sbom/** # NEW: standard path where SBOM outputs are expected to be written
          if-no-files-found: error # NEW: enforce consistent artifact presence per spec (fail if SBOM is missing)
          retention-days: 90 # NEW: explicit retention to support audit readiness (adjust to your compliance needs)

      # NEW: Upload security scan artifacts so they are retained and accessible after CI runs.
      - name: Upload security scan artifact
        uses: actions/upload-artifact@v4
        with:
          name: security-scan # NEW: stable artifact name for downstream/audit consumption
          path: artifacts/security/** # NEW: standard path where security scan outputs are expected to be written
          if-no-files-found: error # NEW: enforce consistent artifact presence per spec (fail if report is missing)
          retention-days: 90 # NEW: explicit retention to support audit readiness (adjust to your compliance needs)