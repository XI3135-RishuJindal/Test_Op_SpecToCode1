# Flask configuration file for Flask 3.x
# Generated as part of Flask 1.x → 3.x migration.
# All fields have inline comments documenting any upgrade-impacting changes.

DEBUG = False
TESTING = False

# SECRET_KEY is required for session management and should be unique.
SECRET_KEY = 'your-production-secret-key'

# SESSION_COOKIE_HTTPONLY is still supported.
SESSION_COOKIE_HTTPONLY = True

# SESSION_COOKIE_SECURE should be True in production.
SESSION_COOKIE_SECURE = True

# JSON_SORT_KEYS is deprecated in Flask 3.x.
# JSON_SORT_KEYS = True  # Deprecated: Do not use in Flask 3.x

# JSON_AS_ASCII is deprecated and removed in Flask 3.x.
# JSON_AS_ASCII = False  # Deprecated: Do not use in Flask 3.x

# TEMPLATES_AUTO_RELOAD triggers template reloads.
TEMPLATES_AUTO_RELOAD = False

# SERVER_NAME can be used for subdomain support.
# SERVER_NAME = "example.com"  # Uncomment and set as needed

# PERMANENT_SESSION_LIFETIME control (now expects Python timedelta object in Flask 3.x)
from datetime import timedelta
PERMANENT_SESSION_LIFETIME = timedelta(days=31)  # Changed: Should use timedelta

# PROPAGATE_EXCEPTIONS behavior unchanged.
PROPAGATE_EXCEPTIONS = None

# JSONIFY_PRETTYPRINT_REGULAR is deprecated and has no effect as of Flask 3.x.
# JSONIFY_PRETTYPRINT_REGULAR = False  # Deprecated: Remove in Flask 3.x

# The SESSION_COOKIE_SAMESITE default is 'Lax' in Flask 3.x (was None/Unspecified in 1.x).
SESSION_COOKIE_SAMESITE = 'Lax'  # New default in Flask 3.x

# Maximum content length (bytes)
# MAX_CONTENT_LENGTH = 16 * 1024 * 1024  # Uncomment and set as needed

# TRAP_HTTP_EXCEPTIONS is unchanged and still used for debugging.
TRAP_HTTP_EXCEPTIONS = False

# TRAP_BAD_REQUEST_ERRORS is still supported.
TRAP_BAD_REQUEST_ERRORS = False

# UPLOAD_FOLDER and related settings are unchanged.
# UPLOAD_FOLDER = '/path/to/uploads'  # Uncomment and set as needed

# Additional Flask 3.x configuration keys can be added below as needed.
# Refer to Flask 3.x documentation for up-to-date config options.

# End of Flask 3.x configuration