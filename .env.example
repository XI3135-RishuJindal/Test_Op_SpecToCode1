# ── Runtime ──────────────────────────────────────────────────────────────────
# Flask environment: development | production | testing
FLASK_ENV=development

# Set to "true" to enable the Flask debugger (never use in production)
FLASK_DEBUG=false

# Port the HTTP server listens on
PORT=5000

# ── Security ─────────────────────────────────────────────────────────────────
# Secret key used for session signing — replace with a long random string
SECRET_KEY=change-me-to-a-long-random-secret

# Bcrypt work factor (cost rounds); higher = slower but more secure
BCRYPT_ROUNDS=12

# ── Database (future) ────────────────────────────────────────────────────────
# Connection string for the user store (PostgreSQL example)
# DATABASE_URL=postgresql://user:password@localhost:5432/auth_db

# ── MFA (future) ─────────────────────────────────────────────────────────────
# Issuer name shown in authenticator apps
# MFA_ISSUER=AuthenticationService
