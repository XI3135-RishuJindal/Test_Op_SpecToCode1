# Microsoft.Extensions.DependencyInjection Migration Configuration Template
# Generated for: Replace Unity IoC with Microsoft.Extensions.DependencyInjection
#
# USAGE: This file documents the canonical mapping from Unity IoC concepts to
# MS.DI equivalents. Adapt the code sections to your actual composition root.
#
# ─────────────────────────────────────────────────────────────────────────────
# REMOVED (Unity-specific — delete from your project):
#   - Unity NuGet packages: Unity, Unity.Container, Unity.Abstractions,
#     Unity.Microsoft.DependencyInjection (if present)
#   - Any unity.config / unity section in app.config or web.config
#   - IUnityContainer, UnityContainer, UnityConfigurationSection references
#   - Unity lifetime managers: TransientLifetimeManager, ContainerControlledLifetimeManager,
#     HierarchicalLifetimeManager, PerResolveLifetimeManager, ExternallyControlledLifetimeManager
#   - container.RegisterType<,>(), container.RegisterInstance(), container.RegisterFactory()
#   - container.Resolve<>(), container.ResolveAll<>()
#   - UnityServiceLocator / ServiceLocator pattern (if used)
#
# ADDED (MS.DI equivalents):
#   - NuGet: Microsoft.Extensions.DependencyInjection (core container)
#   - NuGet: Microsoft.Extensions.DependencyInjection.Abstractions (IServiceCollection, IServiceProvider)
#   - Optional: Microsoft.Extensions.Hosting (IHost, IHostBuilder — recommended for console/worker apps)
#   - Optional: Microsoft.Extensions.Options (options pattern, replaces config-injected singletons)
#   - Optional: Microsoft.Extensions.Logging (replaces Unity-registered logger factories)
# ─────────────────────────────────────────────────────────────────────────────

# ═════════════════════════════════════════════════════════════════════════════
# SECTION 1 — NuGet Package References (csproj / packages.config equivalent)
# ═════════════════════════════════════════════════════════════════════════════
#
# Add to your .csproj:
#
#   <!-- REMOVED: Unity packages — delete these references -->
#   <!-- <PackageReference Include="Unity" Version="*" /> -->
#   <!-- <PackageReference Include="Unity.Container" Version="*" /> -->
#   <!-- <PackageReference Include="Unity.Abstractions" Version="*" /> -->
#   <!-- <PackageReference Include="Unity.Microsoft.DependencyInjection" Version="*" /> -->
#
#   <!-- ADDED: MS.DI core — required -->
#   <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.*" />
#   <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.*" />
#
#   <!-- ADDED: Hosting — recommended for non-ASP.NET apps (console, worker, WPF, WinForms) -->
#   <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.*" />
#
#   <!-- ADDED: Options pattern — replaces config-injected singleton objects -->
#   <PackageReference Include="Microsoft.Extensions.Options" Version="8.*" />
#   <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.*" />
#
#   <!-- ADDED: Logging abstraction — replaces Unity-registered ILogger/ILoggerFactory -->
#   <PackageReference Include="Microsoft.Extensions.Logging" Version="8.*" />
#   <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.*" />

# ═════════════════════════════════════════════════════════════════════════════
# SECTION 2 — Lifetime Mapping Reference
# ═════════════════════════════════════════════════════════════════════════════
#
# Unity Lifetime Manager                  → MS.DI Equivalent
# ─────────────────────────────────────── ─────────────────────────────────────
# TransientLifetimeManager                → services.AddTransient<TService, TImpl>()
#   (new instance per Resolve call)         (new instance per injection/request)
#
# ContainerControlledLifetimeManager      → services.AddSingleton<TService, TImpl>()
#   (single instance for container life)    (single instance for IServiceProvider life)
#
# HierarchicalLifetimeManager             → services.AddScoped<TService, TImpl>()
#   (single instance per child container)   (single instance per IServiceScope)
#
# PerResolveLifetimeManager               → services.AddTransient<TService, TImpl>()
#   (single instance per resolve graph)     (closest equivalent; see note below)
#
# ExternallyControlledLifetimeManager     → services.AddSingleton<TService>(instance)
#   (container holds weak ref; caller owns)  (caller manages lifetime; pass pre-built instance)
#
# NOTE on PerResolve: MS.DI has no direct PerResolve scope. If you relied on
# PerResolveLifetimeManager to share one instance within a single resolve graph,
# refactor to pass the dependency explicitly, or introduce a dedicated IServiceScope
# per logical operation unit.

# ═════════════════════════════════════════════════════════════════════════════
# SECTION 3 — Composition Root Template (C#)
# ═════════════════════════════════════════════════════════════════════════════
#
# ── 3a. ASP.NET Core (Program.cs / Startup.cs) ──────────────────────────────
#
#   // REMOVED: var container = new UnityContainer();
#   // REMOVED: container.RegisterType<IFoo, Foo>(new ContainerControlledLifetimeManager());
#   // REMOVED: UnityConfig.RegisterComponents(container);
#
#   var builder = WebApplication.CreateBuilder(args);
#
#   // ADDED: Register services using IServiceCollection
#   builder.Services.AddSingleton<IFoo, Foo>();          // was: ContainerControlledLifetimeManager
#   builder.Services.AddScoped<IBar, Bar>();             // was: HierarchicalLifetimeManager
#   builder.Services.AddTransient<IBaz, Baz>();          // was: TransientLifetimeManager
#
#   // ADDED: Register a pre-built instance (was: RegisterInstance / ExternallyControlledLifetimeManager)
#   builder.Services.AddSingleton<IConfig>(existingConfigInstance);
#
#   // ADDED: Register via factory delegate (was: RegisterFactory)
#   builder.Services.AddTransient<IService>(sp =>
#       new Service(sp.GetRequiredService<IDependency>(), "hardcoded-arg"));
#
#   // ADDED: Register open generics (was: container.RegisterType(typeof(IRepo<>), typeof(Repo<>)))
#   builder.Services.AddScoped(typeof(IRepository<>), typeof(Repository<>));
#
#   var app = builder.Build();
#
# ── 3b. Console / Worker / Non-ASP.NET (Program.cs) ─────────────────────────
#
#   // REMOVED: var container = new UnityContainer();
#   // REMOVED: container.RegisterType<IFoo, Foo>();
#
#   var host = Host.CreateDefaultBuilder(args)
#       .ConfigureServices((context, services) =>
#       {
#           // ADDED: All registrations move here
#           services.AddSingleton<IFoo, Foo>();
#           services.AddScoped<IBar, Bar>();
#           services.AddTransient<IBaz, Baz>();
#
#           // ADDED: Options pattern replaces config-injected singleton objects
#           // (was: container.RegisterInstance<AppSettings>(config.GetSection("AppSettings")))
#           services.Configure<AppSettings>(context.Configuration.GetSection("AppSettings"));
#       })
#       .Build();
#
#   await host.RunAsync();
#
# ── 3c. WPF / WinForms (App.xaml.cs / Program.cs) ───────────────────────────
#
#   // REMOVED: private IUnityContainer _container;
#   // REMOVED: _container = new UnityContainer();
#
#   private IServiceProvider _serviceProvider;
#
#   protected override void OnStartup(StartupEventArgs e)  // WPF example
#   {
#       var services = new ServiceCollection();
#
#       // ADDED: Register all services
#       services.AddSingleton<IFoo, Foo>();
#       services.AddTransient<MainWindow>();
#
#       // ADDED: Build the provider (replaces container.Resolve root)
#       _serviceProvider = services.BuildServiceProvider(
#           // ADDED: validateOnBuild catches missing registrations at startup
#           new ServiceProviderOptions { ValidateOnBuild = true, ValidateScopes = true }
#       );
#
#       var mainWindow = _serviceProvider.GetRequiredService<MainWindow>();
#       mainWindow.Show();
