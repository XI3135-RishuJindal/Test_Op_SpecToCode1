name: CI

on:
  push:                   # Run workflow on every push to any branch
  pull_request:           # Run workflow on every pull request

jobs:
  lint-and-test:
    runs-on: ubuntu-latest   # Use the latest Ubuntu runner
    steps:
      - name: Checkout code
        uses: actions/checkout@v3   # Checks out repository at the workflow run

      # --- BEGIN: Setup language environment ---
      # The actual language and build tool are unknown. Insert language setup step as needed.
      # - name: Set up <language> environment
      #   uses: actions/setup-<language>@vX
      #   with:
      #     <options>
      # --- END: Setup language environment ---

      - name: Install dependencies
        run: |
          # Add commands to install project dependencies here.
          # Example:
          # pip install -r requirements.txt          # For Python
          # npm install                             # For Node.js
          # go mod download                         # For Go
          echo "Install dependencies command goes here"

      - name: Run linter
        run: |
          # Add the command to run your project's linter here.
          # Example:
          # flake8 .                                # For Python
          # npm run lint                            # For Node.js
          # golint ./...                            # For Go
          echo "Lint command goes here"             # This step enforces code linting standards

      - name: Run tests
        run: |
          # Add the command to run your project's tests here.
          # Example:
          # pytest                                  # For Python
          # npm test                                # For Node.js
          # go test ./...                           # For Go
          echo "Test command goes here"             # This step enforces passing of automated tests

# Note: Keys 'on', 'jobs', and all steps above are newly added to provide a basic CI workflow per the upgrade spec.
#       All placeholder commands MUST be replaced with actual build/lint/test invocations appropriate to the project.
#       No deprecated keys are present or removed in this upgrade.