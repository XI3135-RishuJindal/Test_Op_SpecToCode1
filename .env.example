version_inventory:
  artifact:
    path: "baseline-inventory.yaml" # NEW: defines the single human-readable inventory artifact file path to be generated/checked
    format: "yaml" # NEW: specifies the artifact format (human-readable) for the baseline snapshot
  required_categories:
    - "language" # NEW: required category per spec acceptance criteria
    - "runtime" # NEW: required category per spec acceptance criteria
    - "build_tool" # NEW: required category per spec acceptance criteria
    - "frameworks" # NEW: required category per spec acceptance criteria
  unknown_placeholder: "unknown" # NEW: standard placeholder value when detection cannot determine a version (explicitly mark unknown/TODO)
  generation:
    enabled: true # NEW: enables inventory artifact generation as part of the baseline-inventory process
    include_timestamp: true # NEW: include a timestamp in the generated artifact to make the snapshot verifiable
  verification:
    enabled: true # NEW: enables reproducible verification that the artifact exists and contains required categories
    require_non_empty_entries: true # NEW: enforces non-empty entries for each required category (use 'unknown' when not detected)
  detection:
    enabled: true # NEW: enables best-effort detection; if detection fails, values should be set to unknown_placeholder
    language:
      name: "unknown" # NEW: detected or explicitly unknown/TODO language name
      version: "unknown" # NEW: detected or explicitly unknown/TODO language version
    runtime:
      name: "unknown" # NEW: detected or explicitly unknown/TODO runtime name
      version: "unknown" # NEW: detected or explicitly unknown/TODO runtime version
    build_tool:
      name: "unknown" # NEW: detected or explicitly unknown/TODO build tool name
      version: "unknown" # NEW: detected or explicitly unknown/TODO build tool version
    frameworks:
      - name: "unknown" # NEW: detected or explicitly unknown/TODO framework/library name
        version: "unknown" # NEW: detected or explicitly unknown/TODO framework/library version