{
  // ASP.NET Core 8 application settings — generated for SDK-style net8.0 project structure
  // This file replaces any legacy appsettings.json from a non-SDK-style project

  "Logging": {
    // Logging configuration aligned with ASP.NET Core 8 default host builder conventions
    "LogLevel": {
      // Default minimum log level for all categories
      "Default": "Information",
      // Microsoft.AspNetCore namespace log level — reduced to Warning to suppress routine request noise
      "Microsoft.AspNetCore": "Warning",
      // Microsoft hosting lifetime messages (startup/shutdown) kept at Information
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  // AllowedHosts restricts the Host header values the application will accept
  // "*" permits all hosts; restrict this in production to your actual domain(s)
  // New in SDK-style projects: this key is required by the default WebApplication host in ASP.NET Core 8
  "AllowedHosts": "*"
}