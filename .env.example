version: 1 # NEW: configuration schema version for this CI baseline + runbook template

ci: # NEW: root section defining the CI baseline expectations and validation criteria
  baseline: # NEW: explicit definition of what “CI baseline” means for this repository
    required_checks: [] # NEW: list CI checks/jobs that must pass for baseline compliance (left empty because CI provider/jobs are unknown)
    required_stages: [] # NEW: ordered pipeline stages required for baseline compliance (unknown in spec; to be filled by maintainers)
    required_test_suites: [] # NEW: test suites that must run in baseline (language/build tool unknown; to be filled)
    required_artifacts: [] # NEW: artifacts that must be produced/retained in baseline (unknown; to be filled)
    gating: # NEW: rules for when changes can merge/release based on CI status
      enabled: false # NEW: default disabled because CI provider and enforcement mechanism are unknown
      branches: [] # NEW: branches subject to gating (unknown; to be defined)
  validation: # NEW: repeatable end-to-end CI baseline validation definition
    enabled: true # NEW: baseline validation is the primary goal of this upgrade
    success_criteria: # NEW: verifiable criteria indicating CI is healthy end-to-end
      - "Pipeline triggers successfully" # NEW: ensures trigger-to-start works
      - "Required checks complete successfully" # NEW: ensures baseline checks finish and pass
      - "Artifacts (if required) are produced and accessible" # NEW: ensures artifact publishing works
    cadence: # NEW: when to perform baseline validation checks
      on_change: true # NEW: validate when CI config/runbook changes
      scheduled: false # NEW: default false until CI scheduler/provider is known
      schedule_cron: "" # NEW: placeholder; only applicable if scheduled=true and provider supports cron
    evidence: # NEW: what to capture as proof of validation
      store_links: true # NEW: store links to CI runs/logs
      store_logs: false # NEW: default false; log retention depends on provider
      location: "" # NEW: placeholder for where evidence is stored (wiki/docs/repo path); unknown
  ownership: # NEW: ownership for CI baseline and operational responsibility
    team: "" # NEW: owning team/group (unknown)
    primary_contact: "" # NEW: primary maintainer/on-call alias (unknown)
    secondary_contact: "" # NEW: backup contact (unknown)

runbook: # NEW: operational runbook definition for CI
  enabled: true # NEW: runbook creation is part of this upgrade
  location: "docs/ci-runbook.md" # NEW: default repo path for runbook; can be changed by maintainers
  contents: # NEW: required sections for the runbook to be considered complete
    - "Overview and purpose" # NEW: explains intended CI behavior
    - "Ownership and escalation" # NEW: who owns CI and how to escalate
    - "Triggers and expected workflows" # NEW: PR/push/manual/scheduled behavior
    - "Baseline required checks" # NEW: mirrors ci.baseline.required_checks
    - "How to validate CI end-to-end" # NEW: step-by-step validation procedure
    - "Common failures and triage steps" # NEW: known failure modes and diagnostics
    - "Recovery procedures" # NEW: standard remediation playbooks
    - "Change management" # NEW: how CI/runbook changes are reviewed and rolled out
  escalation: # NEW: escalation path details
    first_line: "" # NEW: first-line on-call/team alias (unknown)
    second_line: "" # NEW: secondary escalation (unknown)
    issue_tracker: "" # NEW: where to file CI incidents/issues (unknown)
    severity_guidance: # NEW: how to categorize CI incidents
      sev1: "CI down for all changes or merges blocked for critical branches" # NEW: guidance text
      sev2: "Intermittent failures or partial pipeline degradation" # NEW: guidance text
      sev3: "Single-job flakes or documentation-only issues" # NEW: guidance text
  triage: # NEW: standardized triage workflow
    checklist: # NEW: minimal set of steps to reduce MTTR
      - "Confirm scope (single PR vs all PRs)" # NEW
      - "Identify failing check and error signature" # NEW
      - "Determine if failure is infra/provider vs repo change" # NEW
      - "Re-run workflow/job if appropriate" # NEW
      - "Collect logs and links for incident record" # NEW
    rerun_policy: # NEW: guidance on when reruns are acceptable
      allow_rerun: true # NEW: reruns often resolve transient issues; keep allowed by default
      max_reruns: 1 # NEW: limit reruns to avoid masking real regressions
      require_annotation: true # NEW: require note/comment in incident/PR when rerunning due to flake
  maintenance: # NEW: keeping runbook current
    review_cadence_days: 90 # NEW: periodic review interval; conservative default for operational docs
    update_on_changes: true # NEW: update runbook when CI baseline changes
    owners_must_approve: true # NEW: require owner review for runbook changes

provider: # NEW: CI provider metadata (unknown in spec, so left as placeholders)
  name: "" # NEW: e.g., GitHub Actions/GitLab CI/Jenkins; unknown
  pipeline_config_paths: [] # NEW: paths to provider config files (unknown)
  notes: "" # NEW: any provider-specific operational notes

deprecated: # NEW: placeholder section to explicitly track deprecated keys if prior configs existed
  # No deprecated keys identified because no existing configuration was provided in Base Source Code. # NEW