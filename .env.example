<?xml version="1.0" encoding="utf-8"?>
<!--
  Integration Test Project File
  Generated for: xUnit integration test project with WebApplicationFactory
  Framework: Microsoft.AspNetCore.Mvc.Testing (in-process integration testing)

  IMPORTANT TODOs before this project is usable:
    1. Replace "YourApp.Api" in <ProjectReference> with the actual API/web project name.
    2. Replace "YourApp.Api.Program" (or equivalent) in test files with the real TEntryPoint type.
    3. Confirm the TargetFramework matches the application under test.
    4. Add this project to the solution: dotnet sln add YourApp.IntegrationTests/YourApp.IntegrationTests.csproj
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Target framework must match (or be compatible with) the application under test.
         Update "net8.0" to match your application's TargetFramework. -->
    <TargetFramework>net8.0</TargetFramework>

    <!-- Nullable reference types: enabled to match modern ASP.NET Core project conventions. -->
    <Nullable>enable</Nullable>

    <!-- Implicit usings reduce boilerplate in test files. -->
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Mark this as a test project so dotnet test discovers it automatically. -->
    <IsPackable>false</IsPackable>

    <!-- Treat this as a test project for SDK tooling (enables dotnet test support). -->
    <IsTestProject>true</IsTestProject>

    <!-- Root namespace for generated test classes. Adjust to match your solution naming convention. -->
    <RootNamespace>YourApp.IntegrationTests</RootNamespace>

    <!-- Assembly name. Adjust to match your solution naming convention. -->
    <AssemblyName>YourApp.IntegrationTests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- xUnit v2: the core testing framework.
         Use the latest stable 2.x release; xUnit v3 has a different package name. -->
    <PackageReference Include="xunit" Version="2.9.0" />

    <!-- xUnit test runner adapter for dotnet test / VSTest integration. -->
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <!-- PrivateAssets/IncludeAssets: runner is a build-time tool, not a runtime dependency. -->
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!-- Microsoft test SDK: required by dotnet test for test discovery and execution. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />

    <!-- WebApplicationFactory lives in this package.
         Version must align with the TargetFramework (e.g., 8.x for net8.0). -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.0" />

    <!-- coverlet: optional code coverage collector wired into dotnet test via DataCollector.
         Remove if coverage is handled by a different tool in your CI pipeline. -->
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Reference to the application under test.
         Replace "YourApp.Api" with the actual project folder/name.
         WebApplicationFactory requires a direct project reference (not a NuGet package reference)
         so it can access the entry point type and the application's DI/middleware configuration. -->
    <ProjectReference Include="..\YourApp.Api\YourApp.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- xUnit configuration file: controls parallelism, output verbosity, and diagnostics.
         CopyToOutputDirectory ensures dotnet test picks it up at runtime. -->
    <None Update="xunit.runner.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>