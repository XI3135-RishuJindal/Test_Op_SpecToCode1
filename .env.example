[pytest]
# pytest configuration file for migrated test suite
# Replaces unittest-based test runner configuration

# --- Test Discovery ---

# Root directory for test discovery (pytest will search recursively)
testpaths = tests

# File patterns to treat as test modules; updated from unittest discovery defaults
python_files = test_*.py *_test.py

# Class name patterns to collect as test classes (still supports class-based tests during migration)
python_classes = Test*

# Function/method name patterns to collect as tests
python_functions = test_*

# --- Output & Reporting ---

# Default CLI options applied to every pytest run
# -v: verbose output (shows each test name)
# --tb=short: shorter traceback format, easier to scan than unittest's default
# --strict-markers: fail if any test uses an unregistered marker (enforces marker hygiene)
addopts =
    -v
    --tb=short
    --strict-markers

# --- Markers ---
# Register custom markers here to avoid PytestUnknownMarkWarning (required by --strict-markers)
# Add project-specific markers below as needed during migration
markers =
    # slow: marks tests as slow-running (deselect with -m "not slow")
    slow: marks tests as slow-running
    # integration: marks tests that require external resources or services
    integration: marks tests as integration tests requiring external dependencies
    # unit: marks tests as pure unit tests with no external dependencies
    unit: marks tests as isolated unit tests

# --- Warnings ---

# Convert specific warnings to errors to surface issues early
# DeprecationWarning from unittest.TestCase usage will surface during migration
filterwarnings =
    # Treat DeprecationWarnings as errors to catch legacy unittest patterns
    error::DeprecationWarning
    # Ignore specific third-party deprecation warnings that are not actionable
    # Add project-specific ignores below as needed, e.g.:
    # ignore::DeprecationWarning:some_third_party_module

# --- Logging ---

# Capture log output during tests; replaces manual logging setup in setUp methods
log_cli = false
# Set to true to stream logs to the console in real time (useful for debugging)
# log_cli = true

# Minimum log level to capture during tests
log_cli_level = WARNING

# Log format for captured log records
log_cli_format = %(asctime)s [%(levelname)s] %(name)s: %(message)s

# Log level for the in-test log capture (available via the `caplog` fixture)
log_level = DEBUG

# --- pytest-mock ---
# pytest-mock provides the `mocker` fixture as a replacement for unittest.mock.patch
# decorators and context managers. No additional configuration keys are required here;
# install pytest-mock as a dependency (see requirements or pyproject.toml).
# The `mocker` fixture automatically resets all mocks after each test, replacing
# the manual teardown previously done in tearDown() methods.

# --- Fixture Scope Notes (inline documentation) ---
# Fixtures defined in conftest.py replace unittest setUp/tearDown/setUpClass/tearDownClass:
#   @pytest.fixture(scope="function")  -> replaces setUp / tearDown (default scope)
#   @pytest.fixture(scope="class")     -> replaces setUpClass / tearDownClass
#   @pytest.fixture(scope="module")    -> shared across all tests in a module
#   @pytest.fixture(scope="session")   -> shared across the entire test session