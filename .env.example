# SQLAlchemy 2.x explicit connection configuration
SQLALCHEMY_DATABASE_URI= # Database URI, e.g. 'postgresql+psycopg2://user:pass@localhost/dbname'
SQLALCHEMY_ENGINE_OPTIONS_POOL_PRE_PING=True # Ensures connection liveness on checkout (recommended for 2.x)
SQLALCHEMY_FUTURE=True # Enable SQLAlchemy 2.x style engine and API

# Deprecated or changed keys (remove from production configuration if present)
# SQLALCHEMY_TRACK_MODIFICATIONS is deprecated in 2.x, do not include or set to False if compatibility is needed.