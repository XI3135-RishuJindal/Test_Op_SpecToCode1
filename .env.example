# SQLAlchemy 2.x compatibility: recommend explicit engine and pool settings

# DATABASE_URL format should include driver if using async mode, e.g. 'postgresql+asyncpg://user:pass@host/db'
DATABASE_URL=postgresql://user:pass@localhost:5432/mydb

# Enable SQLAlchemy 2.x future engine mode for new-style queries and features
# Set to 'true' to enable 2.x API patterns (recommended)
SQLALCHEMY_ENGINE_FUTURE=true

# Optional: Explicitly set 'echo' to help debug migration issues (prints emitted SQL)
# SQLALCHEMY_ECHO=false

# Optional: Control pool handling more strictly for 2.x
# SQLALCHEMY_POOL_PRE_PING=true

# If using async DB access in 2.x
# SQLALCHEMY_ASYNC=true