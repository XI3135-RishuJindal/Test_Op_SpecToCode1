# Documentation Configuration Template
# Generated as part of developer and operational documentation update initiative.
# This file serves as the canonical configuration reference for the project.
# Update all TODO sections with values specific to your environment before use.

# ---------------------------------------------------------------------------
# PROJECT METADATA
# Updated to reflect modernized project identity and ownership.
# ---------------------------------------------------------------------------
project:
  name: TODO  # Human-readable project name
  description: TODO  # Brief description of the system's purpose
  version: TODO  # Current semantic version of the application (e.g., 1.0.0)
  owner: TODO  # Team or individual responsible for this project
  contact: TODO  # Primary contact email or Slack channel for this project
  repository: TODO  # URL of the source code repository
  documentation_url: TODO  # URL where rendered documentation is hosted

# ---------------------------------------------------------------------------
# DOCUMENTATION CONFIGURATION
# Controls how documentation is generated, structured, and published.
# All fields below were introduced or revised as part of the documentation
# modernization effort to align with current system state.
# ---------------------------------------------------------------------------
documentation:

  # Source directories scanned for documentation content.
  # Update paths to match the actual layout of your repository.
  source_dirs:
    - docs/developer       # Developer guides, onboarding, architecture notes
    - docs/operations      # Runbooks, deployment guides, incident playbooks
    - docs/api             # API and interface reference material
    - docs/configuration   # Configuration reference pages

  # Output directory where generated documentation artifacts are written.
  output_dir: docs/build  # Change if your CI/CD pipeline expects a different path

  # Documentation format used for source files.
  # Supported values: markdown, rst, asciidoc
  # TODO: Confirm the format in use across all source_dirs above.
  format: markdown

  # Documentation site generator / renderer.
  # TODO: Set to the tool adopted during modernization (e.g., mkdocs, sphinx, docusaurus).
  renderer: TODO

  # Renderer-specific configuration file path (relative to repository root).
  # e.g., mkdocs.yml, docs/conf.py, docusaurus.config.js
  renderer_config: TODO

  # Whether to treat documentation build warnings as errors.
  # Recommended: true for CI pipelines to catch broken links and missing refs.
  strict_mode: true  # New: enforces documentation quality gates in CI

# ---------------------------------------------------------------------------
# DEVELOPER DOCUMENTATION
# Settings specific to developer-facing guides and onboarding material.
# ---------------------------------------------------------------------------
developer_docs:

  # Path to the primary developer onboarding guide.
  # Updated to reflect modernized setup steps, toolchain, and workflows.
  onboarding_guide: docs/developer/onboarding.md  # TODO: confirm file exists at this path

  # Path to the architecture overview document.
  architecture_overview: docs/developer/architecture.md  # TODO: confirm or create

  # Path to the local development environment setup guide.
  local_setup_guide: docs/developer/local-setup.md  # TODO: confirm or create

  # Path to the contributing guide (branching strategy, PR process, code style).
  contributing_guide: CONTRIBUTING.md  # TODO: confirm or create at repository root

  # Path to the changelog maintained for developer reference.
  changelog: CHANGELOG.md  # TODO: confirm or create at repository root

# ---------------------------------------------------------------------------
# API / INTERFACE REFERENCE
# Settings for generating and publishing API documentation.
# Updated to reflect current interfaces and contracts after modernization.
# ---------------------------------------------------------------------------
api_docs:

  # Whether API reference documentation is enabled for this project.
  enabled: true  # Set to false if this project exposes no external API

  # Path to the API specification file (OpenAPI, AsyncAPI, GraphQL schema, etc.).
  # TODO: Set to the actual spec file path once confirmed.
  spec_file: TODO  # e.g., docs/api/openapi.yaml

  # Specification format.
  # Supported values: openapi3, openapi2, asyncapi, graphql, grpc
  # TODO: Set to the format used by this project.
  spec_format: TODO

  # Whether to validate the spec file during documentation builds.
  validate_on_build: true  # New: catches spec drift early in the development cycle

  # Output path for rendered API reference pages.
  output_path: docs/build/api

# ---------------------------------------------------------------------------
# CONFIGURATION REFERENCE
# Documents all configuration keys, their types, defaults, and descriptions.
# This section was added to address the identified gap in configuration
# documentation that contributed to operational risk.
# ---------------------------------------------------------------------------
configuration_reference:

  # Path to the configuration reference document.
  reference_doc: docs/configuration/reference.md  # TODO: confirm or create

  # Whether to auto-generate the configuration reference from source annotations.
  # Requires tooling support; set to false if maintained manually.
  auto_generate: false  # TODO: set to true if your toolchain supports it

  # Source file or directory scanned when auto_generate is true.
  # Ignored when auto_generate is false.
  source: TODO  # e.g., config/schema.yaml or src/config/

# ---------------------------------------------------------------------------
# OPERATIONAL DOCUMENTATION
# Settings for runbooks, deployment guides, and incident playbooks.
# Updated to reduce MTTR and align with modernized infrastructure.
# ---------------------------------------------------------------------------
operations_docs:

  # Path to the primary deployment guide.
  # Updated to reflect current deployment process after modernization.
  deployment_guide: docs/operations/deployment.md  # TODO: confirm or create

  # Directory containing runbooks for common operational procedures.
  runbooks_dir: docs/operations/runbooks  # TODO: populate with current runbooks

  # Directory containing incident response playbooks.
  playbooks_dir: docs/operations/playbooks  # TODO: populate with current playbooks

  # Path to the monitoring and alerting reference document.
  monitoring_reference: docs/operations/monitoring.md  # TODO: confirm or create

  # Path to the on-call guide (escalation paths, contact lists, SLA references).
  oncall_guide: docs/operations/oncall.md  # TODO: confirm or create

  # Review cadence for operational documentation (informational, not enforced here).
  # Recommended: review runbooks after every significant incident or release.
  review_cadence: quarterly  # New: establishes a baseline review schedule

# ---------------------------------------------------------------------------
# LINK VALIDATION
# Checks for broken internal and external links in documentation.
# New section introduced to improve documentation quality assurance.
# ---------------------------------------------------------------------------
link_validation:

  # Whether link validation is enabled during documentation builds.
  enabled: true  # New: prevents publishing documentation with broken references

  # Whether to check external (HTTP/HTTPS) links.
  # Note: external link checks may slow CI builds; consider running on schedule.
  check_external: true

  # List of URL patterns to exclude from external link checking.
  # Add internal hostnames, localhost references, or known-flaky external URLs.
  exclude_patterns:
    - "http://localhost"
    - "http://127.0.0.1"
    # TODO: add any internal hostnames or known-flaky external URLs here

  # HTTP timeout in seconds when checking external links.
  external_timeout_seconds: 10

# ---------------------------------------------------------------------------
# CI/CD INTEGRATION
# Controls how documentation builds are integrated into the CI/CD pipeline.
# TODO: Populate once CI/CD toolchain is confirmed.
# ---------------------------------------------------------------------------
ci:

  # Whether documentation builds are required to pass before merging.
  required_on_merge: true  # New: enforces documentation quality as a merge gate

  # Branch on which documentation is automatically published after merge.
  publish_branch: main  # TODO: update if your default branch has a different name

  # Destination environment for published documentation.
  # TODO: Set to the hosting platform in use (e.g., GitHub Pages, Confluence, S3).
  publish_target: TODO

  # Command used to build documentation in CI.
  # TODO: Replace with the actual build command for your renderer.
  build_command: TODO  # e.g., mkdocs build --strict

  # Command used to publish documentation in CI.
  # TODO: Replace with the actual publish command for your renderer and target.
  publish_command: TODO  # e.g., mkdocs gh-deploy --force

# ---------------------------------------------------------------------------
# VERSIONING
# Controls how documentation versions are managed and surfaced to readers.
# ---------------------------------------------------------------------------
versioning:

  # Whether multi-version documentation is enabled.
  # Set to true if readers need access to documentation for older releases.
  enabled: false  # TODO: set to true and configure versions if required

  # Strategy for versioning documentation.
  # Supported values: branch, tag, directory
  strategy: tag  # Ignored when enabled is false

  # List of versions to include in the published documentation site.
  # TODO: populate when versioning is enabled.
  versions: []  # e.g., ["latest", "1.2", "1.1"]

# ---------------------------------------------------------------------------
# NOTIFICATIONS
# Optional: notify teams when documentation builds fail or are published.
# TODO: Configure once notification channels are confirmed.
# ---------------------------------------------------------------------------
notifications:

  # Whether build failure notifications are enabled.
  on_failure: false  # TODO: set to true and configure channel below

  # Whether successful publish notifications are enabled.
  on_publish: false  # TODO: set to true and configure channel below

  # Notification channel.
  # TODO: Set to the appropriate channel type (e.g., slack, email, webhook).
  channel: TODO

  # Channel-specific target (e.g., Slack webhook URL, email address).
  target: TODO