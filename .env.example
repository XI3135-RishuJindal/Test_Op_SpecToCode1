# application.yml

spring:
  config:
    import: optional:classpath:/application-local.yml # New: enables profile-based config imports (Spring Boot 2.4+)
  main:
    allow-bean-definition-overriding: true # New: allows bean overriding if required
logging:
  level:
    root: INFO # Changed: use logging.level.<logger> in YAML style
    org.springframework.web: DEBUG # Example: Increased logging level for web
management:
  endpoints:
    web:
      exposure:
        include: "*" # New: exposes all Actuator endpoints
  endpoint:
    health:
      show-details: always # New: always show health details in Actuator

# For Spring Boot 3.x+:
spring:
  threads:
    virtual:
      enabled: true # New: enable virtual threads for maximum concurrency (if using Java 21+)
