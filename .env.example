# Flask 3.x requires that the secret key is set for session management and CSRF protection.
# Existing SECRET_KEY should be kept or added if missing.
FLASK_SECRET_KEY=your-secret-key-here

# Flask 3.x uses FLASK_DEBUG=1 or 0 instead of FLASK_ENV=development/production
# If enabling debug mode, set FLASK_DEBUG=1.
FLASK_DEBUG=0

# Flask 3.x drops support for 'FLASK_ENV' variable.
# Remove FLASK_ENV if previously used.

# If blueprints or CLI commands are in use, Flask 3.x prefers 'FLASK_APP' to be explicit.
# Set to the import path of your application.
FLASK_APP=your_app_module:app