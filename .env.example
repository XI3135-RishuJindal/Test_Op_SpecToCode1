# Updated configuration for documentation modernization
# Add or update keys below as needed for handling documentation settings

# DOCS_FORMAT specifies the output format for generated docs (e.g., 'md', 'html', 'pdf')
DOCS_FORMAT=md

# DOCS_VERSION sets the documentation version to match the codebase
DOCS_VERSION=latest

# DOCS_OUTPUT_PATH defines where generated documentation will be stored
DOCS_OUTPUT_PATH=./docs/build

# DOCS_AUTO_GENERATE enables automatic documentation updates on code changes (true/false)
DOCS_AUTO_GENERATE=true