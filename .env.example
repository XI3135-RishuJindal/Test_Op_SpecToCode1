# application.yml

# The following configuration keys are updated to support the latest ASP.NET Web API version

# Update to the latest ASP.NET Core version
aspnetcore:
  version: '7.0'  # Specify the target ASP.NET Core version

# Update logging configuration for improved diagnostics in .NET
logging:
  logLevel:
    default: Debug  # Change default log level for better visibility during development
    Microsoft: Warning # Limit Microsoft logs to warnings and above

# Enable the new simplified CORS policy options
cors:
  allowedOrigins: 
    - "https://example.com"  # Configure allowed origins for frontend access to API

# Add configuration for the new default JSON serializer settings
jsonOptions:
  propertyNamingPolicy: CamelCase  # Use camelCase for JSON property names by default
  writeIndented: true  # Enable pretty printing for better readability in debugging

# Added support for new health check configurations
healthChecks:
  enabled: true  # Enable health checks for monitoring
  timeout: 10s  # Set timeout for the health check requests

# Update connection strings for any new requirements
connectionStrings:
  DefaultConnection: "Server=localhost;Database=MyDatabase;User Id=myUser;Password=myPassword;TrustServerCertificate=True;"  # Updated to include TrustServerCertificate for enhanced security

# Add API versioning configuration
apiVersioning:
  enabled: true  # Enable API versioning support
  defaultVersion: v1  # Set the default API version for routes

# Add new security settings for the latest ASP.NET features
security:
  requireHttpsRedirection: true  # Enforce HTTPS for all requests

# Update feature flags if any new features are added in the latest upgrade
featureFlags:
  newFeatureX: true  # Enable new feature X introduced in the latest upgrade