[sqlalchemy]
# SQLAlchemy configuration for version 2.x

# The database URL, adjust as appropriate for target database
sqlalchemy.url = sqlite:///app.db

# The SQLAlchemy version constraint - updated for 2.x compatibility
sqlalchemy.version = ^2.0  # Upgraded from 1.3.x to require 2.x

# Enable SQLAlchemy 2.0 style engine options
sqlalchemy.future = true  # Enables 2.0-style engine and session behavior

# Pooling settings, retain unless changed for 2.x best practices
pool_size = 5
max_overflow = 10
pool_timeout = 30

# Expire on commit is still valid for 2.x
expire_on_commit = true

# echo flag controls SQL debug output
echo = false

# Removed deprecated implicit execution methods (e.g., engine.execute)
# All executions must now use explicit Connection or Session.execute()

# Removed or commented out in 2.x:
# sqlalchemy.autocommit = false  # Deprecated: autocommit mode removed in 2.x

# In 2.x, explicit transaction control is enforced.
# Make sure all session-related code uses context managers or explicit commit/rollback.

# ORM Settings
# For new style session creation in SQLAlchemy 2.x
[orm]
# Use the new-style Session API
sessionmaker.future = true  # Enables new Session() semantics in 2.x

# In 2.x, the 'binds' configuration is discouraged in favor of direct engine/session binding.
# No need to specify 'binds' unless advanced multi-bind cases.

# End of SQLAlchemy 2.x configuration file