# AUTHENTICATION / SECURITY
# -----------------------------------------------------------------------------
# TODO: Confirm the authentication mechanism (e.g., JWT, session cookies,
#       OAuth2, API keys). Remove or replace variables that do not apply.

# [SECRET][REQUIRED] Secret key used to sign tokens or sessions.
# Generate a strong random value: openssl rand -hex 32
# TODO: Confirm variable name (e.g., SECRET_KEY, JWT_SECRET, SESSION_SECRET).
SECRET_KEY=

# [OPTIONAL] Token expiry duration.
# TODO: Confirm variable name, format (seconds, ISO 8601, etc.), and default.
# TOKEN_EXPIRY=3600

# [OPTIONAL] Allowed CORS origins, comma-separated.
# Example: http://localhost:3000,https://app.example.com
# TODO: Confirm variable name and whether CORS is configured via env.
# ALLOWED_ORIGINS=http://localhost:3000


