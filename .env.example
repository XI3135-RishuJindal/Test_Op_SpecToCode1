# EF Core Migration Configuration Template
# Generated for: Initial EF Core Migration Setup
# Purpose: Establishes baseline configuration for EF Core migrations infrastructure
#
# TODO: Review all TODO markers before applying to any environment.
# TODO: Confirm EF Core version in use and validate tooling behavior for that version.

[database]
# Connection string for the primary database used by EF Core migrations.
# TODO: Replace with the actual connection string key registered in your DbContext configuration.
# TODO: Confirm provider (SqlServer, Npgsql, Sqlite, etc.) and update accordingly.
ConnectionString = "Server=localhost;Database=YOUR_DATABASE_NAME;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;"

# Database provider to use with EF Core.
# Supported values: SqlServer | Npgsql | Sqlite | Pomelo.MySql
# TODO: Set to the provider matching your registered EF Core database provider package.
Provider = "SqlServer"

[efcore]
# Name of the DbContext class to target when running migrations.
# TODO: Replace with the actual DbContext class name(s) in your project.
# If multiple DbContexts exist, each requires its own migration configuration.
DbContextName = "YOUR_DB_CONTEXT_NAME"

# Namespace for generated migration classes.
# TODO: Update to match your project's namespace conventions.
MigrationsNamespace = "YourProject.Data.Migrations"

# Relative path (from project root) where migration files will be generated.
# EF Core tooling will create this directory if it does not exist.
# TODO: Confirm this path aligns with your project structure.
MigrationsOutputDir = "Data/Migrations"

# Name of the initial migration to be created.
# Convention: Use PascalCase descriptive names. "InitialCreate" is the standard baseline name.
InitialMigrationName = "InitialCreate"

# The EF Core migrations history table name written to the database.
# Default: __EFMigrationsHistory
# Only change this if your environment requires a custom history table name.
MigrationsHistoryTable = "__EFMigrationsHistory"

# Schema for the migrations history table (if your provider supports schemas).
# TODO: Set to your target schema, or leave empty for provider default.
# Example for SQL Server: "dbo"
MigrationsHistoryTableSchema = ""

[migration_commands]
# Reference commands for authoring and applying migrations.
# These are documentation-only keys — not executed by this file directly.
# TODO: Confirm dotnet-ef tools are installed: dotnet tool install --global dotnet-ef
# TODO: Confirm Microsoft.EntityFrameworkCore.Design is referenced in the startup/data project.

# Command to add the initial migration (run from project root or data project directory):
# dotnet ef migrations add InitialCreate --context YOUR_DB_CONTEXT_NAME --output-dir Data/Migrations --project YourDataProject --startup-project YourStartupProject

# Command to apply migrations to the database:
# dotnet ef database update --context YOUR_DB_CONTEXT_NAME --project YourDataProject --startup-project YourStartupProject

# Command to generate a SQL script from migrations (for production/regulated environments):
# dotnet ef migrations script --idempotent --context YOUR_DB_CONTEXT_NAME --output migrations_baseline.sql --project YourDataProject --startup-project YourStartupProject

# Command to verify migration status:
# dotnet ef migrations list --context YOUR_DB_CONTEXT_NAME --project YourDataProject --startup-project YourStartupProject

[environments]
# Environment-specific overrides for migration application.
# TODO: Define connection strings per environment using your configuration provider
# (e.g., appsettings.{Environment}.json, environment variables, secrets manager).

# Development environment
Development.ConnectionString = "Server=localhost;Database=YOUR_DATABASE_NAME_DEV;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;"

# Staging environment
# TODO: Replace with staging connection string, preferably sourced from a secrets store.
Staging.ConnectionString = ""

# Production environment
# TODO: Replace with production connection string, preferably sourced from a secrets store.
# NEVER commit production credentials to source control.
Production.ConnectionString = ""

[baseline]
# Indicates whether the target database already has an existing schema
# that predates EF Core migrations (i.e., a brownfield/baseline scenario).
# If true, an empty initial migration must be created and manually marked as applied
# using: dotnet ef database update --context YOUR_DB_CONTEXT_NAME (after inserting the
# migration row into __EFMigrationsHistory manually, or using MigrationBuilder.Sql).
# TODO: Set to true if the database already has tables; false for greenfield databases.
IsBaselineRequired = false

# If IsBaselineRequired = true, the baseline migration will be inserted into
# __EFMigrationsHistory without executing its Up() method.
# Command to mark an existing migration as applied without running it:
# dotnet ef database update InitialCreate --context YOUR_DB_CONTEXT_NAME (after manually
# inserting the row, or by using an empty Up() migration with the schema pre-existing).
BaselineMigrationName = "InitialCreate"

[tooling]
# Minimum required dotnet-ef global tool version.
# TODO: Align with the EF Core package version used in your project.
# Install: dotnet tool install --global dotnet-ef --version X.Y.Z
# Update:  dotnet tool update --global dotnet-ef --version X.Y.Z
RequiredDotnetEfToolVersion = "TODO_CONFIRM_VERSION"

# Startup project path relative to solution root.
# The startup project must reference Microsoft.EntityFrameworkCore.Design.
# TODO: Update to your actual startup project path.
StartupProject = "src/YourStartupProject/YourStartupProject.csproj"

# Data/migrations project path relative to solution root.
# TODO: Update to your actual data project path (may be same as startup project).
DataProject = "src/YourDataProject/YourDataProject.csproj"