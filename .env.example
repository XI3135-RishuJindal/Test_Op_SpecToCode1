# Flask Application Factory Pattern - Configuration Template
# This file defines configuration classes for use with the create_app() factory pattern.
# Each class represents a distinct environment configuration, loaded by create_app()
# via the `config_name` parameter or the FLASK_ENV / APP_ENV environment variable.

import os

# ---------------------------------------------------------------------------
# Base directory reference — used to build absolute paths for file-based config
# ---------------------------------------------------------------------------
basedir = os.path.abspath(os.path.dirname(__file__))


class Config:
    """
    Base configuration class.
    All environment-specific classes inherit from this.
    Values here serve as application-wide defaults.

    In the factory pattern, create_app() calls app.config.from_object(config)
    rather than setting keys directly on a module-level app instance.
    This class replaces any module-level app.config[] assignments that were
    previously scattered across the old entry-point module.
    """

    # ------------------------------------------------------------------
    # Core Flask settings
    # ------------------------------------------------------------------

    # SECRET_KEY is required for session signing and CSRF protection.
    # Must be overridden via environment variable in all real deployments.
    # Previously this may have been hard-coded at module level — it is now
    # centralised here and read from the environment at factory call time.
    SECRET_KEY = os.environ.get("SECRET_KEY", "change-me-in-production")

    # Disable debug mode by default; overridden in DevelopmentConfig.
    DEBUG = False

    # Disable testing mode by default; overridden in TestingConfig.
    TESTING = False

    # ------------------------------------------------------------------
    # Database settings (SQLAlchemy)
    # Previously set directly on the global app object; now declared here
    # so that each environment can supply its own DATABASE_URL without
    # patching a shared app instance.
    # ------------------------------------------------------------------

    # Primary database URI — read from environment, with a SQLite fallback
    # suitable only for local development.
    SQLALCHEMY_DATABASE_URI = os.environ.get(
        "DATABASE_URL",
        "sqlite:///" + os.path.join(basedir, "app.db"),
    )

    # Disable SQLAlchemy modification tracking (deprecated feature).
    # Suppresses the FSADeprecationWarning that appeared when this was
    # omitted from the old module-level configuration.
    SQLALCHEMY_TRACK_MODIFICATIONS = False

    # ------------------------------------------------------------------
    # Mail settings (Flask-Mail, if used)
    # Centralised here so create_app() can initialise Flask-Mail against
    # the correct per-environment values rather than a shared global state.
    # ------------------------------------------------------------------
    MAIL_SERVER = os.environ.get("MAIL_SERVER", "localhost")
    MAIL_PORT = int(os.environ.get("MAIL_PORT", 25))
    MAIL_USE_TLS = os.environ.get("MAIL_USE_TLS", "false").lower() in ("true", "1", "yes")
    MAIL_USERNAME = os.environ.get("MAIL_USERNAME")
    MAIL_PASSWORD = os.environ.get("MAIL_PASSWORD")

    # ------------------------------------------------------------------
    # Application-level feature flags / miscellaneous defaults
    # Add any additional keys that were previously set at module level below.
    # ------------------------------------------------------------------

    # Example: pagination page size used across the application.
    POSTS_PER_PAGE = int(os.environ.get("POSTS_PER_PAGE", 20))

    @staticmethod
    def init_app(app):
        """
        Hook called by create_app() after app.config.from_object().
        Override in subclasses to perform environment-specific
        initialisation that cannot be expressed as a plain config value
        (e.g., attaching log handlers, configuring Sentry, etc.).

        This replaces any post-instantiation setup that was previously
        performed inline in the module-level entry point.
        """
        pass


class DevelopmentConfig(Config):
    """
    Development environment configuration.

    Loaded by create_app('development') or when
    FLASK_ENV=development / APP_ENV=development is set.

    Replaces the ad-hoc DEBUG=True / config overrides that were
    previously applied directly to the module-level app object during
    local development.
    """

    # Enable Flask debug mode (interactive debugger + auto-reloader).
    DEBUG = True

    # Use a local SQLite database for development by default.
    SQLALCHEMY_DATABASE_URI = os.environ.get(
        "DEV_DATABASE_URL",
        "sqlite:///" + os.path.join(basedir, "dev.db"),
    )

    # Enable SQLAlchemy query logging in development for easier debugging.
    SQLALCHEMY_ECHO = True


class TestingConfig(Config):
    """
    Testing environment configuration.

    Loaded by create_app('testing') inside test fixtures.

    This is the primary benefit of the factory pattern refactor:
    each test (or test session) can call create_app('testing') to
    receive a fully isolated application instance with its own
    in-memory database, eliminating shared state between tests.
    """

    # Enable Flask testing mode (propagates exceptions rather than
    # returning 500 responses, disables error catching).
    TESTING = True

    # Use an in-memory SQLite database so tests never touch disk and
    # each test run starts with a clean schema.
    SQLALCHEMY_DATABASE_URI = os.environ.get(
        "TEST_DATABASE_URL",
        "sqlite:///:memory:",
    )

    # Disable CSRF protection in tests so form submissions work without
    # generating tokens (applicable when Flask-WTF is in use).
    WTF_CSRF_ENABLED = False

    # Disable login requirement redirects during testing where applicable.
    LOGIN_DISABLED = False


class ProductionConfig(Config):
    """
    Production environment configuration.

    Loaded by create_app('production') or when
    FLASK_ENV=production / APP_ENV=production is set.

    All sensitive values MUST be supplied via environment variables.
    No defaults that are safe for production are provided here —
    missing required variables will raise an error via init_app().
    """

    # Production database URI — no fallback; must be set explicitly.
    SQLALCHEMY_DATABASE_URI = os.environ.get("DATABASE_URL")

    @classmethod
    def init_app(cls, app):
        """
        Production-specific post-init hook called by create_app().
        Validates that required environment variables are present and
        attaches production-grade log handlers.
        """
        Config.init_app(app)

        # Validate that a real SECRET_KEY has been provided.
        if not app.config.get("SECRET_KEY") or app.config["SECRET_KEY"] == "change-me-in-production":
            raise ValueError(
                "Production SECRET_KEY must be set via the SECRET_KEY "
                "environment variable and must not be the default value."
            )

        # Validate that a database URI has been provided.
        if not app.config.get("SQLALCHEMY_DATABASE_URI"):
            raise ValueError(
                "Production DATABASE_URL environment variable must be set."
            )

        # Attach a stderr log handler so errors surface in process logs
        # (e.g., systemd journal, Docker log driver) without requiring a
        # file-based logging setup.
        import logging
        from logging import StreamHandler

        stream_handler = StreamHandler()
        stream_handler.setLevel(logging.WARNING)
        app.logger.addHandler(stream_handler)


# ---------------------------------------------------------------------------
# Config registry
# ---------------------------------------------------------------------------
# Maps string keys to config classes.
# create_app() accepts a config_name string and looks it up here, e.g.:
#
#   def create_app(config_name=None):
#       config_name = config_name or os.environ.get('APP_ENV', 'default')
#       app.config.from_object(config_map[config_name])
#       config_map[config_name].init_app(app)
#
# This replaces the single hard-coded configuration that was previously
# applied to the module-level app object.
# ---------------------------------------------------------------------------

config_map = {
    "development": DevelopmentConfig,
    "testing": TestingConfig,
    "production": ProductionConfig,
    # 'default' points to development so that a bare `flask run` works
    # without requiring APP_ENV to be set explicitly.
    "default": DevelopmentConfig,
}