# SQLALCHEMY_ENGINE_OPTIONS can be used to set engine-level options for latest SQLAlchemy
SQLALCHEMY_ENGINE_OPTIONS={}  # New in latest SQLAlchemy. Example: {"pool_pre_ping": true, "pool_recycle": 1800}

# SQLALCHEMY_DATABASE_URI must use the new URL format if upgrading to SQLAlchemy 2.x
# Example: "postgresql+psycopg://user:password@host/dbname"
SQLALCHEMY_DATABASE_URI=

# If using "future" mode (SQLAlchemy 2.0 compatible API)
SQLALCHEMY_FUTURE=true  # Set to true to enable SQLAlchemy 2.x 'future' API compatibility

# If echo needs to be explicitly set to true/false (newer versions recommend explicit config)
SQLALCHEMY_ECHO=false  # Set to true to enable SQL query logging

# If isolation level config is needed for new SQLAlchemy (optional)
SQLALCHEMY_ISOLATION_LEVEL=  # Example: "AUTOCOMMIT", "READ COMMITTED", etc.