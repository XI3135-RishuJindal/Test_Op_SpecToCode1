.github/workflows/security.yml

# Security scanning workflow — added as part of Bandit + pip-audit CI integration.
# Runs on every push to main and on every pull request targeting main.
# This is a standalone parallel job so it does not block or depend on existing test jobs.

name: Security Scanning

# Trigger on pushes to main and on all pull requests targeting main.
# Adjust branch names below if your default branch differs (e.g., "master").
on:
  push:
    branches:
      - main
  pull_request:
    branches:
      - main

jobs:
  security:
    name: Bandit & pip-audit
    # Using ubuntu-latest as the runner; update if your project requires a specific OS.
    runs-on: ubuntu-latest

    steps:
      # Step 1: Check out the repository so tools can access source files and manifests.
      - name: Checkout repository
        uses: actions/checkout@v4

      # Step 2: Set up Python.
      # python-version is set to "3.x" to always use the latest stable 3.x release.
      # Pin this to a specific version (e.g., "3.12") if your project requires it.
      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.x"

      # Step 3: Install security scanning tools.
      # bandit — static analysis tool that detects common Python security anti-patterns.
      # pip-audit — scans installed dependencies against OSV and PyPI Advisory Database for known CVEs.
      # Both are installed into the CI environment; they are NOT added to your project's own dependencies.
      - name: Install security tools
        run: |
          python -m pip install --upgrade pip
          pip install bandit pip-audit

      # Step 4: Install project dependencies so pip-audit can resolve and audit the full dependency graph.
      # The block below attempts the most common dependency manifest formats in order.
      # Uncomment ONLY the line that matches your project's manifest format and comment out the rest.
      # If your project uses none of these, replace this step with the appropriate install command.
      - name: Install project dependencies
        run: |
          # --- requirements.txt (most common) ---
          pip install -r requirements.txt

          # --- pyproject.toml (PEP 517/518 projects, e.g., Poetry, Hatch, Flit) ---
          # pip install .

          # --- setup.cfg / setup.py ---
          # pip install .

          # --- Pipfile (Pipenv) ---
          # pip install pipenv && pipenv install --deploy --ignore-pipfile

      # Step 5: Run Bandit static analysis.
      # -r .        — recursively scan the entire repository.
      # -ll         — report issues at severity level LOW and above (catches the broadest set).
      #               Change to -l (medium) or remove the flag (high only) to reduce noise if needed.
      # --exit-zero — remove this flag (or set to non-zero) to fail the job on any finding.
      #               Currently set so findings are surfaced as warnings without blocking CI.
      #               Change to a non-zero exit code (remove --exit-zero) to enforce hard failures.
      # -f json -o bandit-report.json — also emit a machine-readable report for later upload/review.
      - name: Run Bandit (SAST)
        run: |
          bandit -r . -ll -f json -o bandit-report.json || true
          bandit -r . -ll

      # Step 6: Upload Bandit JSON report as a workflow artifact for review.
      # The report is retained for 30 days. Adjust retention-days as needed.
      - name: Upload Bandit report
        if: always()  # Upload even if the Bandit step above exits non-zero.
        uses: actions/upload-artifact@v4
        with:
          name: bandit-report
          path: bandit-report.json
          retention-days: 30

      # Step 7: Run pip-audit dependency vulnerability scan.
      # --output pip-audit-report.json — emit a machine-readable JSON report.
      # --format json                  — output format for the report file.
      # Exit code is non-zero if vulnerabilities are found; this will fail the job.
      # To make pip-audit non-blocking (warn only), append "|| true" to the command.
      # --ignore-vuln <GHSA-xxxx-xxxx-xxxx> — add this flag to suppress a specific known/accepted advisory.
      - name: Run pip-audit (dependency vulnerability scan)
        run: |
          pip-audit --format json --output pip-audit-report.json

      # Step 8: Upload pip-audit JSON report as a workflow artifact for review.
      # The report is retained for 30 days. Adjust retention-days as needed.
      - name: Upload pip-audit report
        if: always()  # Upload even if the pip-audit step above exits non-zero.
        uses: actions/upload-artifact@v4
        with:
          name: pip-audit-report
          path: pip-audit-report.json
          retention-days: 30