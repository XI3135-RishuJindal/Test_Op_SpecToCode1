# Application Configuration Template for Flask 3.x and SQLAlchemy 2.x
#
# All keys here reflect changes and required compatibilities from the Flask 3.x and SQLAlchemy 2.x upgrade.
# Inline comments annotate any keys introduced or altered by this upgrade.

# Flask section
FLASK_APP = "app.py"                   # Entry point for Flask application
FLASK_ENV = "development"              # Use "production" in production environments
DEBUG = True

# Updated WSGI Application callable is still 'app' by Flask convention (no config change required).

# SQLAlchemy configuration -- Updated for SQLAlchemy 2.x compatibility

SQLALCHEMY_DATABASE_URI = "sqlite:///app.db"    # Database URL, adjust as necessary for deployment
SQLALCHEMY_TRACK_MODIFICATIONS = False          # Disables the deprecated event system in Flask-SQLAlchemy

# SQLAlchemy 2.x removes implicit session creation and requires explicit configuration.
SQLALCHEMY_ENGINE_OPTIONS = {
    # New in SQLAlchemy 2.x: Using 'future': True ensures 2.x syntax/behavior (not required after 2.x, but safe for explicitness)
    "future": True           # Ensures the engine uses SQLAlchemy 2.x "future" (new) behavior
}

# Remove (or comment out) deprecated or legacy options previously supported in 1.x:
# SQLALCHEMY_COMMIT_ON_TEARDOWN = False   # Deprecated in SQLAlchemy 2.x, session commits must be explicit.

# Flask blueprints and extension configs (add as needed)
# Example: 
# # Register Flask extensions here with updated import paths if required in code (no config change needed)

# Secret key (for sessions), ensure this is set to a strong secret in production.
SECRET_KEY = "please-set-a-secure-secret-key"

# Flask 3.x opts into strict error checking; add configuration if needed (optional):
# JSONIFY_PRETTYPRINT_REGULAR is removed in Flask 3.x; response JSON formatting is handled differently now.

# Optional security/session settings
SESSION_COOKIE_SECURE = False                   # Set True in production to use HTTPS cookies
SESSION_COOKIE_HTTPONLY = True
SESSION_COOKIE_SAMESITE = "Lax"

# Logging configuration (if custom logging is used, update for Flask 3.x handlers)
# LOG_LEVEL = "INFO"

# If using Flask CLI (Flask 3.x), commands auto-discovered; no config needed

# Additional notes:
# - All SQLAlchemy models should use `DeclarativeBase` from sqlalchemy.orm for 2.x compatibility.
# - Session management is now explicit; code must be updated to create and remove sessions as needed.
# - Ensure all Flask extension import paths are updated as needed for Flask 3.x.

# End of configuration