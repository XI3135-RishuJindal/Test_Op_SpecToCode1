# EF Core Migration Configuration Template
# Generated for: Initial EF Core Migration Setup
# Purpose: Establishes baseline configuration for EF Core migrations infrastructure
#
# TODO: Review all TODO markers before applying to any environment.
# TODO: Confirm EF Core version in use and validate tooling behavior for that version.

[database]

# ---------------------------------------------------------------------------
# Connection String Configuration
# NEW: Required by EF Core migrations to locate and connect to the target database.
# The DbContext reads this value at design-time (migrations) and runtime.
# TODO: Replace placeholder with the actual connection string key name used in
#       your project (e.g., "DefaultConnection", "AppDb", etc.).
# TODO: Confirm the database provider (SQL Server, PostgreSQL, SQLite, MySQL, etc.)
#       and ensure the matching EF Core provider package is installed.
# ---------------------------------------------------------------------------
connection_string_key = "DefaultConnection"
# connection_string = "Server=localhost;Database=YOUR_DB_NAME;User Id=YOUR_USER;Password=YOUR_PASSWORD;"

# ---------------------------------------------------------------------------
# Database Provider
# NEW: Identifies which EF Core database provider is in use.
# Valid values (confirm package is installed):
#   SqlServer   -> Microsoft.EntityFrameworkCore.SqlServer
#   Sqlite      -> Microsoft.EntityFrameworkCore.Sqlite
#   Npgsql      -> Npgsql.EntityFrameworkCore.PostgreSQL
#   Pomelo.MySql -> Pomelo.EntityFrameworkCore.MySql
# TODO: Set to the provider matching your target database engine.
# ---------------------------------------------------------------------------
provider = "SqlServer"

[efcore]

# ---------------------------------------------------------------------------
# DbContext Class Name
# NEW: The fully-qualified or short class name of the DbContext to target when
#      running migration commands (dotnet ef migrations add / database update).
# TODO: Replace with the actual DbContext class name(s) in your project.
#       If multiple DbContexts exist, each requires its own migration project
#       or --context flag.
# ---------------------------------------------------------------------------
dbcontext_class = "ApplicationDbContext"

# ---------------------------------------------------------------------------
# DbContext Assembly
# NEW: The assembly (project) that contains the DbContext class.
# Used with: dotnet ef --project <assembly>
# TODO: Replace with the actual project/assembly name.
# ---------------------------------------------------------------------------
dbcontext_assembly = "YourProject.Data"

# ---------------------------------------------------------------------------
# Migrations Assembly
# NEW: The assembly where migration files will be generated and stored.
# This may be the same as dbcontext_assembly or a dedicated migrations project.
# TODO: Confirm whether migrations live in the same project as the DbContext
#       or in a separate infrastructure/data project.
# ---------------------------------------------------------------------------
migrations_assembly = "YourProject.Data"

# ---------------------------------------------------------------------------
# Migrations Namespace
# NEW: The .NET namespace under which migration class files will be generated.
# Follows the pattern: <RootNamespace>.Migrations
# TODO: Replace with the actual root namespace of your migrations assembly.
# ---------------------------------------------------------------------------
migrations_namespace = "YourProject.Data.Migrations"

# ---------------------------------------------------------------------------
# Migrations Output Directory
# NEW: Relative path (from the migrations assembly root) where migration files
#      are written by `dotnet ef migrations add`.
# Convention: "Migrations" folder at the project root is standard.
# ---------------------------------------------------------------------------
migrations_output_dir = "Migrations"

# ---------------------------------------------------------------------------
# Initial Migration Name
# NEW: The name given to the first (baseline) migration.
# Convention: "InitialCreate" is the EF Core standard name for the first migration.
# This name appears in the generated migration class and in __EFMigrationsHistory.
# ---------------------------------------------------------------------------
initial_migration_name = "InitialCreate"

# ---------------------------------------------------------------------------
# Migrations History Table
# NEW: The name of the table EF Core uses to track applied migrations.
# Default EF Core value: __EFMigrationsHistory
# Only change this if your environment requires a custom table name or schema.
# TODO: Confirm whether a custom schema (e.g., "dbo", "migrations") is required.
# ---------------------------------------------------------------------------
migrations_history_table = "__EFMigrationsHistory"
# migrations_history_schema = "dbo"

[migration_commands]

# ---------------------------------------------------------------------------
# Reference Commands — NOT executed by this file; provided for operator use.
# NEW: Documents the exact CLI commands required to author and apply the
#      initial migration. Run these from the solution or project root.
#
# Step 1 — Add the initial migration (design-time, generates C# migration files):
#   dotnet ef migrations add InitialCreate \
#     --project YourProject.Data \
#     --startup-project YourProject.Api \
#     --context ApplicationDbContext \
#     --output-dir Migrations
#
# Step 2 — Apply the migration to the target database:
#   dotnet ef database update \
#     --project YourProject.Data \
#     --startup-project YourProject.Api \
#     --context ApplicationDbContext
#
# Step 3 — (Optional) Generate a SQL script for audited/manual environments:
#   dotnet ef migrations script \
#     --idempotent \
#     --project YourProject.Data \
#     --startup-project YourProject.Api \
#     --context ApplicationDbContext \
#     --output ./scripts/InitialCreate.sql
#
# TODO: Replace --project, --startup-project, and --context values above
#       with the actual project paths and DbContext name before running.
# ---------------------------------------------------------------------------

[baseline]

# ---------------------------------------------------------------------------
# Existing Schema Handling
# NEW: Indicates whether the target database already has a schema that predates
#      EF Core migrations (i.e., a "baseline" scenario vs. greenfield).
#
# greenfield  = No existing schema; EF Core will create all tables from scratch.
# baseline    = Schema already exists; an empty initial migration must be applied
#               to seed __EFMigrationsHistory without re-creating existing tables.
#               See: https://learn.microsoft.com/en-us/ef/core/managing-schemas/migrations/applying
#
# TODO: Confirm with the team which scenario applies before running any commands.
# ---------------------------------------------------------------------------
schema_scenario = "greenfield"

# ---------------------------------------------------------------------------
# Baseline Migration Strategy (only relevant when schema_scenario = baseline)
# NEW: When targeting an existing database, after generating the initial migration,
#      apply it with the --target-migration flag set to 0 to mark it as applied
#      without executing the Up() method:
#
#   dotnet ef database update 0   <- rolls back to empty history
#   dotnet ef database update     <- marks InitialCreate as applied without running it
#
# Alternatively, manually insert into __EFMigrationsHistory:
#   INSERT INTO __EFMigrationsHistory (MigrationId, ProductVersion)
#   VALUES ('YYYYMMDDHHMMSS_InitialCreate', '<EFCoreVersion>');
#
# TODO: Confirm EF Core version string (e.g., "8.0.0") for the ProductVersion column.
# ---------------------------------------------------------------------------
baseline_efcore_version = "8.0.0"

[environments]

# ---------------------------------------------------------------------------
# Environment-Specific Overrides
# NEW: EF Core migrations should be applied per-environment using environment-
#      specific connection strings. The keys below are placeholder references.
#
# TODO: Map each environment to its actual connection string source
#       (appsettings.{Environment}.json, environment variables, secrets manager, etc.)
# ---------------------------------------------------------------------------
development_connection_source  = "appsettings.Development.json"
staging_connection_source      = "appsettings.Staging.json"
production_connection_source   = "Environment variable or secrets manager (do not store in source control)"

# ---------------------------------------------------------------------------
# Auto-Migration at Startup
# NEW: Controls whether Database.MigrateAsync() is called automatically on
#      application startup. This is convenient for development but is NOT
#      recommended for production environments where migrations should be
#      applied in a controlled, audited deployment step.
#
# Recommended values:
#   development = true
#   staging     = false (apply via CI/CD pipeline)
#   production  = false (apply via CI/CD pipeline or DBA-reviewed SQL script)
#
# TODO: Implement startup migration logic in Program.cs / Startup.cs if enabled.
# ---------------------------------------------------------------------------
auto_migrate_on_startup_development = true
auto_migrate_on_startup_staging     = false
auto_migrate_on_startup_production  = false

[tooling]

# ---------------------------------------------------------------------------
# Required dotnet-ef Tool Version
# NEW: The dotnet-ef global/local tool must be installed to run migration commands.
# The tool version should match the EF Core runtime version in use.
#
# Install globally:
#   dotnet tool install --global dotnet-ef --version <version>
#
# Install as local tool (recommended for reproducible builds):
#   dotnet tool install dotnet-ef --version <version>
#   (requires a .config/dotnet-tools.json manifest)
#
# TODO: Pin to the exact EF Core version confirmed for this project.
# ---------------------------------------------------------------------------
dotnet_ef_tool_version = "8.0.0"

# ---------------------------------------------------------------------------
# Design-Time Package
# NEW: The Microsoft.EntityFrameworkCore.Design package must be present in the
#      startup project (or the project containing the DbContext) for design-time
#      tooling (migrations add, database update) to function.
#
# Add via:
#   dotnet add package Microsoft.EntityFrameworkCore.Design --version <version>
#
# TODO: Confirm this package is referenced in the correct project.
# ---------------------------------------------------------------------------
design_package = "Microsoft.EntityFrameworkCore.Design"