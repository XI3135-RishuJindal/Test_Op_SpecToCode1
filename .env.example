# pytest.ini configuration file

[pytest]
# Enable capturing of stdout and stderr for failed tests.
# This is equivalent to setting the `--capture=fd` option via the command line.
addopts = --capture=fd

# Specify directories or files to ignore when collecting tests.
# The pytest cache, bytecode, and specific test configurations are ignored by default.
norecursedirs = .git __pycache__ *.egg-info *.eggs

# Specify paths to pytest fixture files for easy import and reuse across tests.
# Fixtures are critical in pytest for setup and teardown logic.
# Directory patterns can be adjusted as per project structure.
python_files = tests/test_*.py tests/*.py

# Automatically discover and integrate plugins for enhanced pytest functionalities,
# including fixtures and mocking.
# Plugins can be specified here if needed, though pytest auto-detection is typically sufficient.
# In a new setup, consider installing `pytest-mock`, `pytest-cov`, and similar plugins for mocking and coverage.
# plugins = pytest-mock pytest-cov

# Enforce test coverage reporting. This will output coverage data after tests are run.
# Setting thresholds for coverage can ensure test quality and highlight missing test areas.
cov-report=term-missing
cov-report=xml
cov=project

# Additional pathways for plugins can be included here if not auto-discovered by pytest.
# Contingent on the presence of these directories in the project structure.
# This should be configured as per specific plugin documentation.
# pytest_plugins =

# Implement strict warnings control across tests to catch potential issues early.
# Configures pytest to transform these warnings into errors where applicable.
filterwarnings =
    error::DeprecationWarning
    ignore::PendingDeprecationWarning