# log4j2 configuration updates for upgrading log4j-core 2.14.1 -> 2.17.1

# Enable security manager for Log4j to mitigate CVE-2021-44228, CVE-2021-45046, CVE-2021-45105
LOG4J_FORMAT_MSG_NO_LOOKUPS=true  # Prevents lookup vulnerabilities in log messages

# (Optional) Set strict parsing for log4j2 configurations. See Log4j2 2.17.1 docs for details.
# LOG4J_CONFIGURATION_FACTORY=org.apache.logging.log4j.core.config.DefaultConfigurationFactory

# (Optional) If using Java system properties, the below can be set as a JVM argument:
# -Dlog4j2.formatMsgNoLookups=true