# SQLAlchemy Configuration for 2.x
# This is a template configuration file for SQLAlchemy 2.x
# All configurations should be adapted as required by your project.

[sqlalchemy]
# The database connection URL for SQLAlchemy engines.
# Update this with your actual connection string.
url = sqlite:///./app.db

# Enable SQLAlchemy 2.x future engine and ORM behaviors.
future = true  # New in SQLAlchemy 2.x; enables 2.x API mode.

# In SQLAlchemy 2.x, the 'pool_pre_ping' option is recommended for production use to detect stale connections.
pool_pre_ping = true  # Recommended; enables connection recycling checks.

# The isolation level for database transactions.
# Set as required; "AUTOCOMMIT" is deprecated in SQLAlchemy 2.x.
isolation_level = "READ COMMITTED"  # Use a valid database-specific isolation level.

# Show all SQL statements and parameter values in log output.
echo = false

# ORM-Specific settings
[orm]
# SQLAlchemy 2.x enforces true/false for expire_on_commit.
expire_on_commit = true  # Ensures objects expire after commit, as per SQLAlchemy best practice.

# Deprecated keys from 1.3 (example):
# [DEPRECATED] use_native_unicode = true
# [DEPRECATED] convert_unicode = true
# These are removed or handled automatically in SQLAlchemy 2.x.

# [Optional] Set the session configuration mode to 2.x.
use_session_future = true  # New in SQLAlchemy 2.x; recommends using new Session API patterns.