# Project Documentation Configuration Template
# Generated to reflect modernized stack documentation standards.
# All TODO markers indicate fields that must be populated with actual project values.

# ---------------------------------------------------------------------------
# PROJECT IDENTITY
# ---------------------------------------------------------------------------

project:
  name: "TODO: <project-name>"                  # Human-readable project name
  description: "TODO: <short project description>"
  repository: "TODO: <repository-url>"
  license: "TODO: <license-identifier>"         # e.g. MIT, Apache-2.0

# ---------------------------------------------------------------------------
# MODERNIZED STACK REFERENCES
# Update these values to match the current runtime, language, and tooling
# versions in use after the modernization effort. Remove any prior version
# entries that no longer apply.
# ---------------------------------------------------------------------------

stack:
  language:
    name: "TODO: <language-name>"               # e.g. Python, Node.js, Go, Java
    version: "TODO: <current-stable-version>"   # Must reflect post-modernization version
    # deprecated_version: "TODO: <old-version>" # Comment out or remove after docs updated

  runtime:
    name: "TODO: <runtime-name>"                # e.g. CPython, V8, JVM, .NET CLR
    version: "TODO: <current-stable-version>"   # Must reflect post-modernization version

  build_tool:
    name: "TODO: <build-tool-name>"             # e.g. Maven, Gradle, npm, make, Bazel
    version: "TODO: <current-stable-version>"   # Must reflect post-modernization version
    config_file: "TODO: <build-config-filename>" # e.g. pom.xml, build.gradle, package.json

  package_manager:
    name: "TODO: <package-manager-name>"        # e.g. pip, npm, yarn, cargo, go mod
    version: "TODO: <current-stable-version>"
    lockfile: "TODO: <lockfile-name>"           # e.g. package-lock.json, Pipfile.lock

# ---------------------------------------------------------------------------
# DOCUMENTATION ARTIFACTS
# List all documentation files that have been updated to reflect the
# modernized stack. This serves as an audit trail for documentation drift.
# ---------------------------------------------------------------------------

documentation:
  artifacts:
    - path: "README.md"
      description: "Project overview, quickstart, and setup instructions"
      status: "TODO: updated | pending | not-applicable"
      last_reviewed: "TODO: <YYYY-MM-DD>"

    - path: "docs/architecture.md"
      description: "System architecture overview"
      status: "TODO: updated | pending | not-applicable"
      last_reviewed: "TODO: <YYYY-MM-DD>"

    - path: "docs/setup.md"
      description: "Environment setup and installation guide"
      status: "TODO: updated | pending | not-applicable"
      last_reviewed: "TODO: <YYYY-MM-DD>"

    - path: "docs/contributing.md"
      description: "Contribution guidelines and development workflow"
      status: "TODO: updated | pending | not-applicable"
      last_reviewed: "TODO: <YYYY-MM-DD>"

    - path: "docs/runbook.md"
      description: "Operational runbook for deployment and incident response"
      status: "TODO: updated | pending | not-applicable"
      last_reviewed: "TODO: <YYYY-MM-DD>"

    - path: "docs/api-reference.md"
      description: "API reference documentation"
      status: "TODO: updated | pending | not-applicable"
      last_reviewed: "TODO: <YYYY-MM-DD>"

    # Add additional documentation artifacts as needed.

# ---------------------------------------------------------------------------
# DEPRECATED COMPONENTS
# Record components, versions, or workflows that have been removed or
# replaced as part of the modernization. These entries exist for audit
# and onboarding clarity — they must NOT be referenced in active docs.
# ---------------------------------------------------------------------------

deprecated:
  components:
    - name: "TODO: <deprecated-component-name>"
      reason: "TODO: <why it was replaced>"
      replaced_by: "TODO: <replacement-component-name>"
      removed_from_docs_date: "TODO: <YYYY-MM-DD>"

    # Add additional deprecated components as identified.

# ---------------------------------------------------------------------------
# ENVIRONMENT VARIABLES
# Document all environment variables relevant to the modernized stack.
# Remove entries for variables that belonged to deprecated components.
# ---------------------------------------------------------------------------

environment_variables:
  - name: "TODO: <ENV_VAR_NAME>"
    description: "TODO: <what this variable controls>"
    required: true                              # true | false
    default: "TODO: <default-value-or-none>"
    example: "TODO: <example-value>"
    introduced_by: "TODO: <component or version that introduced this var>"

  # Add additional environment variables as needed.
  # Remove or comment out variables belonging to deprecated components:
  # - name: "TODO: <OLD_ENV_VAR>"
  #   status: deprecated
  #   deprecated_reason: "TODO: replaced by <NEW_ENV_VAR> in modernized stack"

