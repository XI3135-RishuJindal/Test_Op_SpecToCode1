# docker-compose.yml
# Generated for containerized development environment
# TODO: Review and update all TODO values before use

version: "3.9"  # Compose file format version — supports most current Docker Engine features

services:
  app:
    # Build the application image from the local Dockerfile
    build:
      context: .
      dockerfile: Dockerfile
      # TODO: Add build args here if the Dockerfile uses ARG directives
      # args:
      #   RUNTIME_VERSION: "TODO"

    # TODO: Replace with the actual image name for your project
    image: myapp:dev

    # TODO: Replace with the actual port(s) your application listens on
    # Format: "host_port:container_port"
    ports:
      - "8080:8080"  # TODO: Update to match your application's port

    # Mount the local source directory into the container for live reload during development
    volumes:
      - .:/app  # TODO: Update /app if your Dockerfile sets a different WORKDIR

    # Load environment variables from a local .env file (not committed to source control)
    env_file:
      - .env  # TODO: Create a .env file locally; add .env to .gitignore

    # Inline environment variable overrides (supplement or override .env values)
    environment:
      # TODO: Add any environment variables your application requires
      - APP_ENV=development  # Signals to the app that it is running in dev mode

    # TODO: If your application depends on a database, cache, or queue, uncomment
    # and configure the relevant service blocks below, and add a depends_on entry.
    # depends_on:
    #   - db
    #   - cache

    # Restart policy for development — restarts on failure but not on explicit stop
    restart: on-failure

    # TODO: Replace or remove this command if your application has a specific start command
    # command: ["TODO: your start command here"]

  # ---------------------------------------------------------------------------
  # Optional: Database service — uncomment and configure if needed
  # ---------------------------------------------------------------------------
  # db:
  #   image: postgres:15-alpine  # TODO: Replace with your database image and version
  #   environment:
  #     POSTGRES_USER: TODO
  #     POSTGRES_PASSWORD: TODO
  #     POSTGRES_DB: TODO
  #   ports:
  #     - "5432:5432"  # TODO: Update if using a different database port
  #   volumes:
  #     - db_data:/var/lib/postgresql/data  # Persist database data across container restarts
  #   restart: on-failure

  # ---------------------------------------------------------------------------
  # Optional: Cache service — uncomment and configure if needed
  # ---------------------------------------------------------------------------
  # cache:
  #   image: redis:7-alpine  # TODO: Replace with your cache image and version
  #   ports:
  #     - "6379:6379"  # TODO: Update if using a different cache port
  #   restart: on-failure

# ---------------------------------------------------------------------------
# Named volumes — uncomment if any service above uses a named volume
# ---------------------------------------------------------------------------
# volumes:
#   db_data:  # Persistent storage for the database service