version: 1 # New: configuration schema version for the "source access validation" task/template

source_input: # New: single place to specify one supported source delivery mechanism for validation
  type: "" # New: required; one of: "github", "zip", "local_path"
  github: # New: used when source_input.type == "github"
    url: "" # New: GitHub repository URL to validate read access against (e.g., https://github.com/org/repo)
    ref: "" # New: optional; branch/tag/commit to baseline the validation on (empty means default branch)
  zip: # New: used when source_input.type == "zip"
    path: "" # New: filesystem path to the ZIP archive to validate
    sha256: "" # New: optional; expected SHA-256 for integrity verification (empty disables hash check)
  local_path: # New: used when source_input.type == "local_path"
    path: "" # New: filesystem path to the project root to validate

validation: # New: validation checks and evidence recording for acceptance criteria
  actor: "" # New: engineering role/account identifier used to perform validation (e.g., username/service account)
  require_read_access: true # New: must confirm readable access to the provided source input
  require_non_empty: true # New: must confirm source is not empty / can be enumerated
  require_stack_discovery: true # New: must confirm source contains enough signals to identify language/runtime/build tooling if present
  evidence: # New: where to record validation outcomes for reproducibility/auditability
    record: true # New: enable recording of validation evidence
    output_path: "source-access-validation.json" # New: file path to write validation evidence/results

# Deprecated (replaced by source_input): previously separate keys for each mechanism are no longer used by this template.
# github_url: "" # Deprecated: use source_input.type="github" and source_input.github.url instead
# zip_path: "" # Deprecated: use source_input.type="zip" and source_input.zip.path instead
# local_source_path: "" # Deprecated: use source_input.type="local_path" and source_input.local_path.path instead