# Input Validation and Sanitization Configuration
# Generated for: POST /orders endpoint hardening
# Upgrade goal: Add input validation and sanitization layer
#
# NOTE: Language, runtime, and framework were not specified in the upgrade context.
# This file uses a framework-neutral, environment-variable-driven format (YAML/dotenv hybrid comments).
# Adapt key names and syntax to match your actual runtime (e.g., Node.js, Python, Java, Go).
# Every key below is derived exclusively from the spec document provided.

# ---------------------------------------------------------------------------
# VALIDATION LAYER — POST /orders endpoint
# ---------------------------------------------------------------------------

validation:

  # [NEW] Master switch to enable the input validation and sanitization layer
  # for the POST /orders endpoint. Set to false ONLY in controlled debug environments.
  enabled: true

  # [NEW] Enforce strict mode: reject any request field not explicitly declared
  # in the order payload schema (allowlist-based field filtering).
  # Prevents unknown/extra fields from passing through to the order processing layer.
  strict_unknown_fields: true

  # [NEW] Reject requests whose Content-Type header is not in this allowlist.
  # Only well-formed, explicitly supported content types are accepted.
  allowed_content_types:
    - "application/json"

  # [NEW] Maximum allowed size (in bytes) for the POST /orders request body.
  # Requests exceeding this limit are rejected before parsing to prevent
  # resource exhaustion and oversized payload attacks.
  # Default: 65536 bytes (64 KB) — adjust based on expected maximum order payload size.
  max_body_size_bytes: 65536

  # [NEW] Whether to strip (sanitize) leading/trailing whitespace from all
  # string fields in the order payload before validation and processing.
  trim_string_fields: true

  # [NEW] Whether to reject the request if any string field contains characters
  # that match known injection patterns (SQL, NoSQL, shell, HTML/script).
  # Recommended: true. Set to false only if downstream escaping is fully verified.
  reject_injection_patterns: true

  # [NEW] List of injection pattern categories to screen against.
  # Derived from spec security requirements (injection attack prevention).
  # Add or remove categories based on your data store and rendering context.
  injection_pattern_categories:
    - sql
    - nosql
    - html_script
    - shell

  # [NEW] Whether to HTML-encode (escape) string field values that will be
  # reflected in responses or stored for later rendering in a browser context.
  html_encode_string_output: true

  # [NEW] Enforce required fields at the API boundary before passing data to
  # the order processing layer. The specific required fields MUST be populated
  # from your order payload schema (see Open Questions in spec).
  # Placeholder list — replace with actual required field names.
  required_fields:
    # - customer_id       # Uncomment and populate from actual order schema
    # - items             # Uncomment and populate from actual order schema
    # - shipping_address  # Uncomment and populate from actual order schema

  # [NEW] Type enforcement: reject fields whose runtime type does not match
  # the declared schema type. Prevents type-confusion and coercion-based attacks.
  enforce_field_types: true

  # [NEW] Whether implicit type coercion (e.g., string "123" → integer 123)
  # is permitted during validation. Recommended: false for strict type safety.
  # Set to true only if legacy clients depend on coercion behavior.
  allow_type_coercion: false

  # [NEW] Maximum allowed length (in characters) for any individual string field
  # in the order payload. Fields exceeding this are rejected.
  # Adjust per-field limits in your schema definition as needed.
  max_string_field_length: 1000

  # [NEW] Maximum number of items allowed in any array field within the order payload
  # (e.g., line items list). Prevents array-flooding attacks.
  max_array_items: 500

  # [NEW] Maximum allowed nesting depth for JSON objects in the order payload.
  # Prevents deeply nested object attacks that can cause stack overflows in parsers.
  max_object_nesting_depth: 10

# ---------------------------------------------------------------------------
# ERROR RESPONSE CONTRACT — POST /orders validation failures
# ---------------------------------------------------------------------------

validation_error_response:

  # [NEW] HTTP status code returned when the request payload fails validation.
  # 422 Unprocessable Entity is the semantically correct code for validation failures
  # on a well-formed but invalid payload. Use 400 if your API convention requires it.
  http_status_code: 422

  # [NEW] Whether to include a machine-readable list of field-level validation
  # errors in the error response body. Enables clients to surface specific issues.
  include_field_errors: true

  # [NEW] Whether to include a human-readable summary message in the error response.
  include_error_message: true

  # [NEW] Whether to expose the specific rejected field value in the error response.
  # Recommended: false in production to avoid reflecting potentially malicious input
  # back to the caller (reflected injection risk).
  expose_rejected_value: false

  # [NEW] Whether to log full validation error details (field names, failure reasons)
  # server-side for observability. Does not affect what is returned to the caller.
  log_validation_failures: true

  # [NEW] Log level used when a validation failure is recorded.
  # Options (adapt to your logging framework): warn, info, error
  validation_failure_log_level: "warn"

# ---------------------------------------------------------------------------
# PAYLOAD SIZE ENFORCEMENT
# (May overlap with web framework/reverse proxy config — set at both layers)
# ---------------------------------------------------------------------------

payload_limits:

  # [NEW] Enforce payload size limit at the application layer (in addition to
  # any reverse proxy or load balancer limit). Belt-and-suspenders protection.
  enforce_at_application_layer: true

  # [NEW] HTTP status code returned when the payload exceeds max_body_size_bytes.
  # 413 Payload Too Large is the correct HTTP status for this condition.
  payload_too_large_status_code: 413

# ---------------------------------------------------------------------------
# SANITIZATION PIPELINE ORDER
# Defines the sequence in which sanitization steps are applied to the
# incoming order payload. Steps execute in list order before validation.
# ---------------------------------------------------------------------------

sanitization:

  # [NEW] Ordered list of sanitization steps applied to the raw request body
  # before schema validation. Adjust order to match your security requirements.
  pipeline:
    - step: "strip_null_bytes"          # Remove null bytes (\x00) from string fields
      enabled: true

    - step: "trim_whitespace"           # Strip leading/trailing whitespace from strings
      enabled: true

    - step: "normalize_unicode"         # Normalize Unicode to NFC form to prevent homoglyph attacks
      enabled: true

    - step: "remove_control_characters" # Strip non-printable ASCII control characters from strings
      enabled: true

    - step: "escape_html_entities"      # Escape <, >, &, ", ' in string fields
      enabled: true

# ---------------------------------------------------------------------------
# COMPLIANCE NOTES (derived from spec — PCI-DSS reference)
# ---------------------------------------------------------------------------

compliance:

  # [NEW] Flag indicating that payment-related fields in the order payload
  # are subject to PCI-DSS data handling requirements. When true, additional
  # field-level masking and audit logging SHOULD be applied by the processing layer.
  # The specific payment fields must be identified from your order schema.
  pci_dss_applicable: true

  # [NEW] Whether to mask sensitive field values in server-side logs
  # (e.g., card numbers, CVV, account identifiers) to support PCI-DSS compliance.
  mask_sensitive_fields_in_logs: true

  # [NEW] Placeholder list of field names considered sensitive for log masking.
  # Populate from your actual order payload schema.
  sensitive_field_names:
    # - card_number       # Uncomment and populate from actual order schema
    # - cvv               # Uncomment and populate from actual order schema
    # - account_number    # Uncomment and populate from actual order schema