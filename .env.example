# New/updated properties for Spring Boot 3.x & Java 17+ compatibility

# Ensures correct JDK target for Spring Boot 3.x
JAVA_VERSION=17

# Spring Boot 3.x requires at least version 3.x for actuator, endpoints, etc.
SPRING_BOOT_VERSION=3.1.0

# Use new property style for management endpoints in Spring Boot 3.x
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info

# For Java 17+, enable JVM preview features if needed (optional, comment out if unused)
# JAVA_OPTS=--enable-preview

# Update language level for build tools (Maven/Gradle), if required in CI
# For Maven: see pom.xml, for Gradle: see build.gradle
# Example for Gradle: (if using plugins syntax)
# JAVA_TOOLCHAIN_VERSION=17