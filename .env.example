# Monolith Decomposition Configuration Template
# Generated for: Monolith-to-Microservices Decomposition Evaluation
# Purpose: Tracks decomposition candidates, interface contracts, and migration readiness
# Usage: Update each section as bounded contexts are identified and assessed
# Format: YAML — adjust to your configuration management toolchain as needed

---

decomposition_assessment:

  # Metadata about this assessment document
  metadata:
    # Human-readable name for this decomposition initiative
    initiative_name: "Monolith Decomposition Evaluation"

    # Version of this assessment document — increment on each revision
    assessment_version: "1.0.0"

    # ISO 8601 date this assessment was last updated
    last_updated: "TODO"

    # Team or individual responsible for maintaining this document
    owner: "TODO"

    # Current phase of the decomposition initiative
    # Allowed values: discovery | assessment | planning | execution | complete
    phase: "discovery"

    # Overall urgency rating derived from spec
    # Allowed values: low | medium | high | critical
    urgency: "medium"

    # Free-text notes on scope limitations or open questions
    notes: >
      Specific framework versions, runtime versions, language, build tool,
      and regulatory/SLA requirements are not yet confirmed.
      All TODO fields must be resolved via codebase inventory before
      advancing to the planning phase.

  # -----------------------------------------------------------------------
  # Source system description — fill in after codebase inventory
  # -----------------------------------------------------------------------
  source_monolith:

    # Primary programming language of the monolith
    # TODO: confirm from codebase inventory
    language: "TODO"

    # Runtime version currently in use
    # TODO: confirm from codebase inventory
    runtime_version: "TODO"

    # Build tool used (e.g. Maven, Gradle, Make, npm, etc.)
    # TODO: confirm from codebase inventory
    build_tool: "TODO"

    # List of primary frameworks in use
    # TODO: confirm from codebase inventory
    frameworks: []

    # Whether the monolith is currently containerized
    # TODO: confirm from deployment inventory
    containerized: false

    # CI/CD toolchain in use (e.g. Jenkins, GitHub Actions, GitLab CI)
    # TODO: confirm from DevOps inventory
    cicd_toolchain: "TODO"

    # Deployment frequency of the monolith today
    # Allowed values: on-demand | daily | weekly | monthly | ad-hoc
    deployment_frequency: "TODO"

    # Approximate size indicators — helps prioritize decomposition effort
    size_indicators:
      # Estimated lines of code — TODO
      loc_estimate: "TODO"
      # Number of top-level modules or packages — TODO
      module_count: "TODO"
      # Number of active contributors — TODO
      contributor_count: "TODO"
      # Number of distinct product/feature teams sharing the codebase — TODO
      team_count: "TODO"

  # -----------------------------------------------------------------------
  # Decomposition drivers — sourced directly from spec motivation section
  # -----------------------------------------------------------------------
  decomposition_drivers:

    technical:
      # Tight coupling increases blast radius of any single change or failure
      - id: "TD-001"
        description: >
          Monolithic deployment model creates tight coupling between unrelated
          functional areas, increasing the blast radius of any single change or failure.
        confirmed: false   # Set true after codebase review validates this driver

      # Independent scaling is not possible within the current architecture
      - id: "TD-002"
        description: >
          Independent scaling of high-load components is not possible within
          the current architecture.
        confirmed: false

      # Shared codebase constrains development velocity
      - id: "TD-003"
        description: >
          Development velocity is constrained by shared codebases, long
          build/test cycles, and merge contention across teams.
        confirmed: false

      # All components must be released together
      - id: "TD-004"
        description: >
          Deployment frequency is limited because all components must be
          released together.
        confirmed: false

    business:
      # Organizational growth may require independent team ownership
      - id: "BD-001"
        description: >
          Organizational growth may require independent team ownership of
          distinct product domains.
        confirmed: false

      # Faster iteration on specific product areas is blocked
      - id: "BD-002"
        description: >
          Faster iteration on specific product areas is blocked by
          full-monolith release cycles.
        confirmed: false

      # Resilience requirements cannot be met independently
      - id: "BD-003"
        description: >
          Resilience and availability requirements for critical subsystems
          cannot be met independently under the current model.
        confirmed: false

    compliance_and_operational:
      # Regulatory or SLA requirements — not yet confirmed per spec
      - id: "CO-001"
        description: >
          TODO — specific regulatory or SLA requirements that may mandate
          service isolation have not been confirmed in the provided context.
        confirmed: false

  # -----------------------------------------------------------------------
  # Decomposition candidate registry
  # Each entry represents one bounded context or functional domain
  # evaluated as a potential microservice extraction target.
  # Add one block per candidate identified during discovery.
  # -----------------------------------------------------------------------
  decomposition_candidates:

    # Template entry — copy and fill in for each identified candidate
    - id: "DC-001"

      # Short name for this bounded context or functional domain
      name: "TODO — e.g. User Identity & Authentication"

      # Brief description of what this domain is responsible for
      description: "TODO"

      # Drivers from the list above that motivate extracting this candidate
      # Reference driver IDs (e.g. TD-001, BD-002)
      motivated_by: []

      # Viability assessment for extraction
      viability:

        # Overall viability rating
        # Allowed values: high | medium | low | not-viable
        rating: "TODO"

        # Rationale supporting the viability rating
        rationale: "TODO"

        # Known blockers that must be resolved before extraction
        blockers: []

        # Dependencies this domain has on other parts of the monolith
        # List module or package names
        inbound_dependencies: []

        # Parts of the monolith that depend on this domain
        outbound_dependencies: []

        # Estimated coupling score (1 = loosely coupled, 5 = tightly coupled)
        # TODO: derive from static analysis or manual review
        coupling_score: "TODO"

        # Estimated data ownership clarity
        # Allowed values: clear | shared | unclear
        data_ownership: "TODO"

        # Does this domain own its own data store, or share one?
        # Allowed values: dedicated | shared | mixed
        datastore_ownership: "TODO"

      # Interface contract sketch for the extracted service
      interface_contract:

        # Proposed communication style
        # Allowed values: REST | gRPC | GraphQL | event-driven | mixed
        communication_style: "TODO"

        # List of proposed public API operations (high-level, not full spec)
        proposed_operations: []
        # Example entry:
        # - operation: "CreateUser"
        #   method: "POST"
        #   path: "/users"
        #   notes: "TODO"

        # Events this service would publish (if event-driven)
        published_events: []

        # Events this service would consume (if event-driven)
        consumed_events: []

        # Authentication/authorization mechanism for this service
        # TODO: confirm from security review
        auth_mechanism: "TODO"

      # Migration approach for this candidate
      migration:

        # Recommended extraction pattern
        # Allowed values: strangler-fig | branch-by-abstraction | parallel-run | big-bang
        pattern: "TODO"

        # Estimated effort to extract
        # Allowed values: small | medium | large | x-large
        effort_estimate: "TODO"

        # Recommended extraction sequence priority (lower = extract sooner)
        priority_order: "TODO"

        # Whether a feature flag or dark-launch strategy is needed
        requires_feature_flag: false

        # Whether data migration is required as part of extraction
        requires_data_migration: false

        # Notes on data migration approach if applicable
        data_migration_notes: "TODO"

        # Rollback strategy if extraction fails
        rollback_strategy: "TODO"

      # Observability requirements for the extracted service
      observability:

        # Logging format required
        # Allowed values: structured-json | plaintext | TODO
        logging_format: "TODO"

        # Distributed tracing required
        distributed_tracing_required: false

        # Key metrics this service should expose
        key_metrics: []

        # Health check endpoint required
        health_check_required: true

      # Current status of this candidate's assessment
      # Allowed values: identified | under-review | approved | deferred | rejected
      status: "identified"

      # Free-text notes or open questions for this candidate
      notes: "TODO"

  # -----------------------------------------------------------------------
  # Shared infrastructure concerns
  # Cross-cutting concerns that must be addressed regardless of which
  # candidates are extracted first.
  # -----------------------------------------------------------------------
  shared_infrastructure:

    # Service discovery mechanism
    # TODO: select based on target runtime/platform
    service_discovery:
      approach: "TODO"   # e.g. DNS-based | sidecar | client-side registry
      tooling: "TODO"    # e.g. Consul, Kubernetes DNS, Eureka — TODO confirm

    # API gateway or edge proxy
    api_gateway:
      required: true
      tooling: "TODO"    # TODO: confirm from infrastructure review

    # Inter-service communication defaults
    inter_service_communication:
      # Synchronous call default
      sync_protocol: "TODO"       # e.g. REST/HTTP, gRPC — TODO confirm
      # Asynchronous messaging default
      async_protocol: "TODO"      # e.g. Kafka, RabbitMQ, SQS — TODO confirm

    # Distributed tracing infrastructure
    distributed_tracing:
      required: true
      tooling: "TODO"    # TODO: confirm from observability review

    # Centralized logging infrastructure
    centralized_logging:
      required: true
      tooling: "TODO"    # TODO: confirm from observability review

    # Secrets management approach
    secrets_management:
      approach: "TODO"   # TODO: confirm from security review

    # Container orchestration platform (if containerization is adopted)
    container_orchestration:
      # Per spec: containerized = None currently; confirm target state
      target_platform: "TODO"   # e.g. Kubernetes, ECS, Nomad — TODO confirm

    # CI/CD pipeline changes required to support independent service deployments
    cicd_changes:
      # Each extracted service will need its own pipeline
      per_service_pipelines_required: true
      # Shared pipeline template approach
      pipeline_template_approach: "TODO"   # TODO: confirm from DevOps review

  # -----------------------------------------------------------------------
  # Assessment process configuration
  # Controls how the decomposition evaluation is conducted and tracked.
  # -----------------------------------------------------------------------
  assessment_process:

    # Criteria used to score and rank decomposition candidates
    scoring_criteria:

      # Weight assigned to each criterion (must sum to 1.0)
      weights:
        # How loosely coupled is this domain from the rest of the monolith?
        coupling_score: 0.25
        # How clearly does this domain own its data?
        data_ownership_clarity: 0.20
        # How high is the business value of independent deployment?
        business_value: 0.20
        # How well-understood are the domain boundaries?
        domain_boundary_clarity: 0.15
        # How feasible is extraction given current team capacity?
        team_feasibility: 0.10
        # How high is the operational risk of extraction?
        operational_risk: 0.10

    # Review gates that must be passed before a candidate moves to planning
    review_gates:
      - id: "RG-001"
        name: "Codebase inventory complete"
        description: "All TODO fields in source_monolith section are resolved."
        required: true

      - id: "RG-002"
        name: "Bounded context mapping complete"
        description: >
          All major functional domains have been identified and entered
          as decomposition_candidates entries.
        required: true

      - id: "RG-003"
        name: "Data ownership analysis complete"
        description: >
          datastore_ownership and data_ownership fields are filled in
          for all candidates with viability rating of medium or higher.
        required: true

      - id: "RG-004"
        name: "Interface contracts drafted"
        description: >
          interface_contract section is populated for all approved candidates.
        required: true

      - id: "RG-005"
        name: "Compliance and SLA requirements confirmed"
        description: >
          CO-001 driver is resolved — regulatory or SLA isolation requirements
          are documented or explicitly marked as not applicable.
        required: true

    # Recommended tooling for bounded context discovery
    # These are process suggestions, not hard dependencies
    discovery_tooling_suggestions:
      - "Event Storming workshops"
      - "Domain storytelling sessions"
      - "Static dependency analysis (language-specific tooling — TODO confirm)"
      - "Runtime call graph analysis"
      - "Team topology mapping"