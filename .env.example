appsettings.json

{
  // Connection string for EF Core — replaces the static in-memory data store.
  // Update the value to match your target database provider and credentials.
  // Example shown uses SQL Server; swap the provider package and format for PostgreSQL, SQLite, etc.
  "ConnectionStrings": {
    // Primary connection string consumed by the EF Core DbContext (see DbContext registration in Program.cs / Startup.cs).
    // Key name must match the argument passed to builder.Configuration.GetConnectionString("DefaultConnection").
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=AppDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },

  // EF Core runtime behaviour settings.
  "EFCore": {
    // When true, EF Core will apply pending migrations automatically on startup.
    // Recommended: false in production — run migrations explicitly via CLI or deployment pipeline.
    "AutoMigrateOnStartup": false,

    // When true, EF Core will seed initial/reference data if the database is empty.
    // Replaces any seed logic that previously populated the static in-memory store.
    "SeedDataOnStartup": true,

    // When true, generated SQL statements are written to the configured logger.
    // Disable in production to avoid logging sensitive query parameters.
    "EnableSensitiveDataLogging": false,

    // When true, EF Core logs all executed SQL. Useful during development/migration validation.
    "EnableDetailedErrors": false
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      // Raise to "Warning" or "Error" in production to suppress verbose EF Core query logs.
      "Microsoft.EntityFrameworkCore": "Warning",
      // Log EF Core database command execution at Information level during development to verify queries.
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },

  "AllowedHosts": "*"
}