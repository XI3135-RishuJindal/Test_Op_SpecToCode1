# .env.example

# API version to test compatibility after upgrade
API_VERSION=latest  # Set the latest stable API version for testing

# Add new base URL for the upgraded API
API_BASE_URL=https://api.example.com/v${API_VERSION}  # Update the base URL to reflect the new API version

# Optional: Enable or disable compatibility mode if the framework needs it
COMPATIBILITY_MODE=true  # Enable compatibility mode for legacy support during the upgrade transition