# Environment Variables and Local Setup Configuration Template
# =============================================================================
# This file documents all required and optional environment variables for this
# project. Copy this file to .env (or the appropriate local config file) and
# fill in the values for your environment.
#
# USAGE:
#   cp .env.example .env
#   # Edit .env with your local values
#   # Never commit .env to version control
#
# TODO: Confirm the mechanism used to load these variables at runtime
#       (e.g., dotenv library, shell export, secrets manager, CI/CD injection).
#
# TODO: Confirm the exact variable names, types, and default values by
#       auditing the codebase (search for process.env, os.environ, getenv,
#       System.getenv, or equivalent for your runtime).
#
# LEGEND:
#   [REQUIRED] — Must be set; the application will not start or behave
#                correctly without this value.
#   [OPTIONAL] — Has a safe default; override only if needed.
#   [SECRET]   — Contains sensitive data; never commit to version control,
#                never log, never expose in error messages.
#   [TODO]     — Variable name or default value not yet confirmed; must be
#                resolved before this file is considered complete.
# =============================================================================


# -----------------------------------------------------------------------------
# APPLICATION / RUNTIME
# -----------------------------------------------------------------------------

# [REQUIRED] The environment the application is running in.
# Typical values: development | staging | production | test
# TODO: Confirm the exact variable name used in code (e.g., APP_ENV, NODE_ENV,
#       RAILS_ENV, FLASK_ENV, ENVIRONMENT).
APP_ENV=development

# [OPTIONAL] The host interface the application server binds to.
# Default: 0.0.0.0 (all interfaces) for containers; 127.0.0.1 for local dev.
# TODO: Confirm variable name and whether this is used by the project.
APP_HOST=127.0.0.1

# [OPTIONAL] The port the application server listens on.
# TODO: Confirm variable name and default port for this project.
APP_PORT=8080

# [OPTIONAL] Log level for application output.
# Typical values: debug | info | warn | error
# TODO: Confirm variable name and supported values.
LOG_LEVEL=info

# [OPTIONAL] Enable or disable debug mode.
# Set to true only in development; never enable in production.
# TODO: Confirm variable name (e.g., DEBUG, APP_DEBUG).
DEBUG=false


# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# TODO: Confirm whether this project uses a database and which type
#       (relational, document, key-value, etc.). Remove this section if unused.

# [REQUIRED] Full connection string for the primary database.
# Example (PostgreSQL): postgresql://user:password@localhost:5432/dbname
# Example (MySQL):      mysql://user:password@localhost:3306/dbname
# Example (MongoDB):    mongodb://user:password@localhost:27017/dbname
# TODO: Confirm variable name and database type.
DATABASE_URL=

# [OPTIONAL] Maximum number of connections in the database connection pool.
# TODO: Confirm variable name and appropriate default for this project.
DATABASE_POOL_SIZE=10

# [OPTIONAL] Connection timeout in milliseconds.
# TODO: Confirm variable name and default.
DATABASE_TIMEOUT_MS=5000


# -----------------------------------------------------------------------------
# CACHE / SESSION STORE
# -----------------------------------------------------------------------------
# TODO: Confirm whether this project uses a cache or session store (e.g.,
#       Redis, Memcached). Remove this section if unused.

# [OPTIONAL] Connection URL for the cache/session store.
# Example (Redis): redis://localhost:6379/0
# TODO: Confirm variable name.
CACHE_URL=

# [OPTIONAL] Default cache TTL in seconds.
# TODO: Confirm variable name and default.
CACHE_TTL_SECONDS=3600


