# ═════════════════════════════════════════════════════════════════════════════
# SECTION 4 — Resolution API Mapping
# ═════════════════════════════════════════════════════════════════════════════
#
# Unity API                                    → MS.DI Equivalent
# ──────────────────────────────────────────── ─────────────────────────────────────────────
# container.Resolve<IFoo>()                    → provider.GetRequiredService<IFoo>()
#                                                (throws InvalidOperationException if not registered)
#
# container.Resolve<IFoo>()  (nullable ok)     → provider.GetService<IFoo>()
#                                                (returns null if not registered)
#
# container.ResolveAll<IFoo>()                 → provider.GetServices<IFoo>()
#                                                (returns IEnumerable<IFoo>)
#
# container.Resolve(typeof(IFoo))              → provider.GetRequiredService(typeof(IFoo))
#
# container.CreateChildContainer()             → provider.CreateScope()
#                                                (use scope.ServiceProvider for scoped resolution)
#
# NOTE: Avoid storing IServiceProvider as a field and calling GetRequiredService<>
# throughout the codebase (Service Locator anti-pattern). Prefer constructor injection.
# The only legitimate uses of IServiceProvider.GetRequiredService are:
#   - The composition root itself
#   - Factory delegates registered with services.AddTransient(sp => ...)
#   - IHostedService.StartAsync where the scope must be created manually

# ═════════════════════════════════════════════════════════════════════════════
# SECTION 5 — Named / Keyed Registration Mapping
# ═════════════════════════════════════════════════════════════════════════════
#
# Unity supported named registrations:
#   container.RegisterType<IFoo, FooA>("nameA");
#   container.RegisterType<IFoo, FooB>("nameB");
#   var foo = container.Resolve<IFoo>("nameA");
#
# MS.DI (.NET 8+) introduces Keyed Services as the direct replacement:
#
#   // ADDED (.NET 8+): Keyed service registration
#   services.AddKeyedSingleton<IFoo, FooA>("nameA");
#   services.AddKeyedTransient<IFoo, FooB>("nameB");
#
#   // ADDED (.NET 8+): Keyed service resolution via attribute in constructor
#   public class Consumer([FromKeyedServices("nameA")] IFoo foo) { ... }
#
#   // ADDED (.NET 8+): Keyed service resolution via IServiceProvider
#   var foo = provider.GetRequiredKeyedService<IFoo>("nameA");
#
# For .NET 6/7 (no keyed services), use one of these patterns instead:
#   Option A — Factory delegate:
#     services.AddTransient<Func<string, IFoo>>(sp => key => key switch {
#         "nameA" => sp.GetRequiredService<FooA>(),
#         "nameB" => sp.GetRequiredService<FooB>(),
#         _ => throw new ArgumentException($"Unknown key: {key}")
#     });
#
#   Option B — Dedicated interface per variant (preferred for small sets):
#     services.AddSingleton<IFooA, FooA>();
#     services.AddSingleton<IFooB, FooB>();

# ═════════════════════════════════════════════════════════════════════════════
# SECTION 6 — app.config / web.config Unity XML Section Removal
# ═════════════════════════════════════════════════════════════════════════════
#
# If your project used XML-based Unity configuration, remove the following
# from app.config / web.config entirely:
#
#   <!-- REMOVED: Unity configuration section declaration -->
#   <!-- <section name="unity"
#                type="Microsoft.Practices.Unity.Configuration.UnityConfigurationSection,
#                      Microsoft.Practices.Unity.Configuration" /> -->
#
#   <!-- REMOVED: Unity container XML block -->
#   <!-- <unity>
#          <container>
#            <register type="IFoo" mapTo="Foo" />
#            <register type="IBar" mapTo="Bar">
#              <lifetime type="singleton" />
#            </register>
#          </container>
#        </unity> -->
#
# Replace with appsettings.json + Microsoft.Extensions.Configuration:
#
#   // appsettings.json (new — for options pattern)
#   {
#     "AppSettings": {
#       "SomeKey": "SomeValue"
#     }
#   }
#
#   // Registration (in ConfigureServices / Program.cs)
#   services.Configure<AppSettings>(configuration.GetSection("AppSettings"));
#
#   // Consumption (constructor injection — preferred over IOptions<> in leaf classes)
#   public class MyService
#   {
#       private readonly AppSettings _settings;
#       public MyService(IOptions<AppSettings> options) =>
#           _settings = options.Value;
#   }

# ═════════════════════════════════════════════════════════════════════════════
# SECTION 7 — Interception / AOP (Unity.Interception replacement)
# ═════════════════════════════════════════════════════════════════════════════
#
# Unity.Interception provided call-handler / behavior pipeline AOP.
# MS.DI has no built-in interception. Choose one of:
#
#   Option A — Decorator pattern (zero extra dependencies, preferred for simple cases):
#     services.AddSingleton<FooImpl>();
#     services.AddSingleton<IFoo>(sp =>
#         new LoggingFooDecorator(sp.GetRequiredService<FooImpl>()));
#
#   Option B — Scrutor (open-source decorator helper):
#     // NuGet: Scrutor
#     services.AddSingleton<IFoo, FooImpl>();
#     services.Decorate<IFoo, LoggingFooDecorator>();
#
#   Option C — Castle DynamicProxy / DispatchProxy (runtime proxy AOP):
#     // NuGet: Castle.Core
#     services.AddSingleton<IFoo>(sp =>
#         ProxyGenerator.CreateInterfaceProxyWithTarget<IFoo>(
#             sp.GetRequiredService<FooImpl>(),
#             new LoggingInterceptor()));

# ═════════════════════════════════════════════════════════════════════════════
# SECTION 8 — Validation & Diagnostics
# ═════════════════════════════════════════════════════════════════════════════
#
# MS.DI provides built-in registration validation absent in Unity.
# Enable in non-production environments:
#
#   // ADDED: Validate all registrations and scope violations at container build time
#   // (Development environment only — has performance cost)
#   if (builder.Environment.IsDevelopment())  // ASP.NET Core
#   {
#       builder.Host.UseDefaultServiceProvider(options =>
#       {
#           options.ValidateOnBuild = true;   // catches missing registrations at startup
#           options.ValidateScopes = true;    // catches scoped-in-singleton captive dependency bugs
#       });
#   }
#
#   // For non-hosted apps:
#   var provider = services.BuildServiceProvider(
#       new ServiceProviderOptions { ValidateOnBuild = true, ValidateScopes = true });

# ═════════════════════════════════════════════════════════════════════════════
# SECTION 9 — Migration Checklist
# ═════════════════════════════════════════════════════════════════════════════
#
# [ ] Remove Unity NuGet packages from all .csproj / packages.config files
# [ ] Remove unity XML section from app.config / web.config
# [ ] Delete or replace UnityConfig / UnityBootstrapper / UnityContainerFactory classes
# [ ] Replace IUnityContainer fields/parameters with IServiceCollection (registration)
#     and IServiceProvider (resolution, composition root only)
# [ ] Map each RegisterType call to AddSingleton / AddScoped / AddTransient (Section 2)
# [ ] Map each RegisterInstance call to AddSingleton(instance) (Section 3)
# [ ] Map each RegisterFactory call to AddTransient(sp => ...) (Section 3)
# [ ] Replace named registrations with keyed services (.NET 8+) or factory pattern (Section 5)
# [ ] Replace container.Resolve<> with constructor injection everywhere possible (Section 4)
# [ ] Replace remaining container.Resolve<> call sites with GetRequiredService<> (Section 4)
# [ ] Replace child container usage with IServiceScope (Section 4)
# [ ] Replace Unity.Interception with decorator or proxy pattern (Section 7)
# [ ] Enable ValidateOnBuild + ValidateScopes in development (Section 8)
# [ ] Run full test suite; resolve any captive dependency / scope violations surfaced
# [ ] Remove Unity-related using directives (Microsoft.Practices.Unity.*)
# [ ] Audit for remaining ServiceLocator anti-pattern usages and refactor to injection