[loggers]
# Define the root logger and any named application loggers.
# Add additional logger names here (comma-separated) as your application grows.
keys=root

[handlers]
# Define all handlers that will be attached to loggers.
# json_stream_handler emits structured JSON to stdout — the primary handler added by this upgrade.
keys=json_stream_handler

[formatters]
# Define all formatters.
# json_formatter is the structured JSON formatter introduced by this upgrade.
keys=json_formatter

# ---------------------------------------------------------------------------
# Logger definitions
# ---------------------------------------------------------------------------

[logger_root]
# Root logger catches all log records not handled by a named child logger.
# Level can be overridden at runtime via the LOG_LEVEL environment variable
# in application startup code (e.g. logging.getLogger().setLevel(...)).
level=INFO
# Attach the JSON stream handler so all output is structured JSON.
handlers=json_stream_handler
# propagate is not applicable to the root logger but is shown for clarity.

# ---------------------------------------------------------------------------
# Handler definitions
# ---------------------------------------------------------------------------

[handler_json_stream_handler]
# StreamHandler writes log records to a stream (stdout by default).
# stdout is preferred in containerised and cloud environments so that the
# process supervisor or container runtime can capture and forward log lines.
class=StreamHandler
# Emit INFO and above; set to DEBUG during local development if needed.
level=INFO
# Attach the JSON formatter so every emitted record is a JSON object.
formatter=json_formatter
# args=(sys.stdout,) directs output to stdout rather than the default stderr.
# This is the standard choice for structured log pipelines (Datadog, Loki,
# CloudWatch, Splunk, etc.) that tail stdout.
args=(sys.stdout,)

# ---------------------------------------------------------------------------
# Formatter definitions
# ---------------------------------------------------------------------------

[formatter_json_formatter]
# IMPORTANT: Python's built-in logging.ini format does not natively support
# custom formatter *classes* via the simple key=value syntax used above.
# To use a custom JSON formatter class (e.g. python-json-logger's
# pythonjsonlogger.jsonlogger.JsonFormatter, or a project-local
# app.logging_utils.JsonFormatter), you MUST configure logging via
# logging.config.dictConfig() in code instead of — or in addition to —
# this file.  The stanza below documents the intended configuration so that
# it can be translated directly into a dictConfig dict.
#
# Recommended dictConfig equivalent (place in app startup / settings.py):
#
#   import logging.config, os
#
#   LOGGING = {
#       "version": 1,
#       # Keep existing non-root loggers (e.g. third-party library loggers).
#       "disable_existing_loggers": False,
#       "formatters": {
#           "json": {
#               # Use pythonjsonlogger if available; otherwise substitute your
#               # own JsonFormatter class path.
#               "()": "pythonjsonlogger.jsonlogger.JsonFormatter",
#               # fmt lists the LogRecord attributes to include in every JSON
#               # object.  %(message)s is the formatted log message string.
#               # Additional fields (timestamp, level, logger name, etc.) are
#               # appended automatically by JsonFormatter.
#               "fmt": "%(asctime)s %(name)s %(levelname)s %(message)s",
#               # datefmt controls the shape of the "asctime" field value.
#               # ISO-8601 with UTC offset is strongly preferred for log
#               # aggregation platforms.
#               "datefmt": "%Y-%m-%dT%H:%M:%S%z",
#               # rename_fields maps default LogRecord attribute names to the
#               # canonical field names expected by your log platform.
#               # Adjust keys/values to match your organisation's schema.
#               "rename_fields": {
#                   "asctime":   "timestamp",
#                   "levelname": "level",
#                   "name":      "logger"
#               },
#               # static_fields are merged into every log record as-is.
#               # Use them to tag records with the service name / environment.
#               "static_fields": {
#                   "service": os.getenv("SERVICE_NAME", "app"),
#                   "env":     os.getenv("APP_ENV", "production")
#               }
#           }
#       },
#       "handlers": {
#           "json_stream": {
#               "class":     "logging.StreamHandler",
#               "level":     os.getenv("LOG_LEVEL", "INFO"),
#               "formatter": "json",
#               "stream":    "ext://sys.stdout"
#           }
#       },
#       "root": {
#           "level":    os.getenv("LOG_LEVEL", "INFO"),
#           "handlers": ["json_stream"]
#       }
#   }
#
#   logging.config.dictConfig(LOGGING)
#
# The keys below are kept for documentation purposes and for environments
# that load this file directly via logging.config.fileConfig().  They will
# produce plain-text output in that case; replace with dictConfig for full
# JSON output.

# class must be a dotted path resolvable at import time.
# Replace with your project's JsonFormatter class if not using
# python-json-logger.
class=pythonjsonlogger.jsonlogger.JsonFormatter

# format string passed to the formatter constructor as the `fmt` argument.
# Attributes listed here are included as top-level JSON keys in each record.
format=%(asctime)s %(name)s %(levelname)s %(message)s

# datefmt controls the "asctime" field.  ISO-8601 is recommended.
datefmt=%Y-%m-%dT%H:%M:%S%z