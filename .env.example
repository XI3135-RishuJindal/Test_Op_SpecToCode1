# Added to support SQLAlchemy 2.x compatible connection string format
SQLALCHEMY_DATABASE_URL=postgresql+psycopg://username:password@localhost/dbname

# Optional: Enable SQLAlchemy 2.0 style usage for some ORMs or frameworks
SQLALCHEMY_ENGINE_OPTIONS={"future": true}  # Enables 2.x engine API usage

# Optional: Track DB query warnings for deprecated patterns under SQLAlchemy 2.x
SQLALCHEMY_WARN_20=true