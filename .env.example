[pytest]
# ---------------------------------------------------------------------------
# pytest configuration file (pytest.ini)
# Generated for: migration from unittest to pytest
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Test discovery
# ---------------------------------------------------------------------------

# Root directory pytest uses as the base for test discovery.
# Adjust to match your project layout (e.g. "src" or ".").
testpaths = tests

# File name patterns pytest will collect as test modules.
# Covers both the legacy test_*.py convention and *_test.py.
python_files = test_*.py *_test.py

# Class name patterns collected as test classes.
# Retains unittest.TestCase subclasses during the migration period
# while also collecting plain pytest-style classes (no base class required).
python_classes = Test* *Tests *Test

# Function / method name patterns collected as test cases.
python_functions = test_*

# ---------------------------------------------------------------------------
# Output and reporting
# ---------------------------------------------------------------------------

# Default CLI options applied to every pytest run.
#   -v            : verbose — show each test name and PASSED/FAILED status
#   --tb=short    : short traceback format; reduces noise while keeping context
#   --strict-markers : fail if an unregistered marker is used (enforces discipline)
addopts =
    -v
    --tb=short
    --strict-markers

# ---------------------------------------------------------------------------
# Markers
# ---------------------------------------------------------------------------
# Declare every custom marker here to avoid PytestUnknownMarkWarning and to
# satisfy --strict-markers.  Add project-specific markers as needed.
markers =
    # Marks tests that require a live database connection.
    db: marks tests that require database access (deselect with -m "not db")

    # Marks tests that should be skipped in CI environments without network.
    integration: marks integration tests that call external services

    # Marks tests that are slow and can be excluded from fast feedback loops.
    slow: marks tests as slow-running (deselect with -m "not slow")

    # Marks tests that are currently being migrated from unittest; may be
    # temporarily fragile.  Remove this marker once migration is complete.
    migrating: marks tests still being ported from unittest to pytest

# ---------------------------------------------------------------------------
# Warnings
# ---------------------------------------------------------------------------
# Treat all warnings as errors to surface deprecations early.
# The filterwarnings list below carves out known acceptable warnings that
# arise during the unittest → pytest migration period.
filterwarnings =
    # Default: promote all warnings to errors.
    error

    # unittest.TestCase.assertEqual and friends emit DeprecationWarning when
    # called outside a TestCase context; ignore during migration.
    ignore::DeprecationWarning:unittest

    # pytest-mock / unittest.mock interop warnings that are benign.
    ignore::pytest.PytestUnraisableExceptionWarning

    # Remove the line below once all assertRaises context-manager usages have
    # been replaced with pytest.raises().
    ignore:.*assertRaises.*:DeprecationWarning

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Capture log output and display it on test failure.
# New key introduced by pytest's built-in log capture (replaces manual
# logging setup that was common in unittest setUp methods).
log_cli = false
log_cli_level = INFO
log_level = DEBUG
log_format = %(asctime)s [%(levelname)s] %(name)s: %(message)s
log_date_format = %Y-%m-%dT%H:%M:%S

# ---------------------------------------------------------------------------
# Database isolation (pytest-django / SQLAlchemy / generic)
# ---------------------------------------------------------------------------
# If you are using pytest-django, uncomment and set the Django settings module:
# [pytest]
# DJANGO_SETTINGS_MODULE = myproject.settings.test

# If you are using pytest-sqlalchemy-mock or a custom conftest.py fixture,
# the isolation strategy (transaction rollback or truncation) is configured
# in conftest.py, not here.  See conftest.py for the `db_session` fixture.

# ---------------------------------------------------------------------------
# Coverage (pytest-cov integration)
# ---------------------------------------------------------------------------
# These options are activated when pytest is invoked with --cov.
# Install: pip install pytest-cov
# Uncomment and adjust the source path to match your package name.
# addopts entries for coverage should be appended to the addopts block above
# rather than duplicated here; they are shown separately for clarity.
#
#   --cov=mypackage          : measure coverage for this package
#   --cov-report=term-missing: show missing lines in terminal
#   --cov-report=xml         : emit coverage.xml for CI ingestion
#   --cov-fail-under=80      : fail the build if coverage drops below 80 %
#
# Example (merge into addopts above when ready):
#   --cov=mypackage --cov-report=term-missing --cov-report=xml --cov-fail-under=80

# ---------------------------------------------------------------------------
# Parallel execution (pytest-xdist)
# ---------------------------------------------------------------------------
# Install: pip install pytest-xdist
# To run tests in parallel add "-n auto" (or "-n <N>") to addopts above.
# DB isolation fixtures MUST use function-scoped transactions or separate
# schemas/databases per worker when xdist is enabled.
# Uncomment the line below once DB isolation is confirmed xdist-safe:
# addopts = ... -n auto

# ---------------------------------------------------------------------------
# Fixture / conftest notes (not a config key — informational comment)
# ---------------------------------------------------------------------------
# The following fixtures are expected to be defined in tests/conftest.py:
#
#   @pytest.fixture(scope="session")
#   def db_engine(): ...          # creates the engine once per session
#
#   @pytest.fixture(scope="function")
#   def db_session(db_engine): ... # wraps each test in a rolled-back transaction
#
#   @pytest.fixture
#   def mock_external_service(mocker): ...  # uses pytest-mock's `mocker` fixture
#
# pytest-mock (pip install pytest-mock) replaces unittest.mock.patch decorators
# with the `mocker` fixture, which is automatically cleaned up after each test.