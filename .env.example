# unittest_config.yaml

# Configuration for running unittests after refactoring for API and dependency changes

# Specify the paths to test discovery; update to ensure all refactored tests are included.
test_paths:
  - tests/  # Root folder for all unittests

# Patterns for test files; ensure compatibility with latest framework/discovery tools.
test_file_pattern: "test_*.py"  # Updated to standard modern unittest discovery pattern

# Exclude patterns for files/folders (if legacy tests are being phased out).
exclude_patterns:
  - "tests/legacy/*"  # Exclude outdated legacy tests no longer compatible post-upgrade

# Dependency stubs/mocks config
use_mocks: true  # Enable dependency mocks to allow seamless refactoring of dependencies and APIs

# Updated fixtures location matching refactored data contracts and schema.
fixtures_path: "tests/fixtures/"  # Path for updated fixtures synchronised with new API/data models

# Updated mock configuration reflecting current interfaces; replaced deprecated methods.
mock_config:
  strict_signature: true   # Enforce strict mock signatures to match updated dependency interface
  autospec: true           # Use autospec to prevent usage of removed/deprecated methods

# Updated assertion behavior settings.
assertion_settings:
  fail_fast: false         # Continue running all tests even after failures (modern default)
  verbose: true            # Enable verbose output to inspect rewritten/unskipped tests

# Removed deprecated options (if any), e.g.:
# legacy_helpers: false    # Deprecated: old helpers removed after dependency update

# CI pipeline integration config — updated to ensure compatibility with refactored test suite.
ci_integration:
  enabled: true
  report_format: "junitxml"   # Updated for modern CI report parsing
  report_output: "test-reports/results.xml"

# Add other framework-required keys here if discovered during further audit for new APIs or dependencies