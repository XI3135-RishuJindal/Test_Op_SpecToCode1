# --- BEGIN GITLAB CI ---
#
# # NEW: define the six pipeline stages in execution order.
# stages:
#   - build
#   - test
#   - sast
#   - container-build
#   - image-scan
#   - deploy
#
# # NEW: top-level variables shared across all jobs.
# variables:
#   REGISTRY: registry.gitlab.com                          # CHANGE: set to your registry
#   IMAGE_NAME: $CI_REGISTRY_IMAGE                         # GitLab built-in: org/project path
#   IMAGE_TAG: $CI_COMMIT_SHA                              # NEW: tag with commit SHA for traceability
#   SCAN_SEVERITY: CRITICAL,HIGH                           # NEW: severities that fail the pipeline
#   DOCKERFILE_PATH: ./Dockerfile                          # CHANGE: path to your Dockerfile
#   DOCKER_DRIVER: overlay2                                # NEW: recommended Docker storage driver
#   DOCKER_TLS_CERTDIR: "/certs"                           # NEW: enable TLS for Docker-in-Docker
#
# # ─────────────────────────────────────────────────────────────────────────
# # STAGE 1: BUILD
# # ─────────────────────────────────────────────────────────────────────────
# build:
#   stage: build
#   # CHANGE: replace with the Docker image that provides your build toolchain.
#   # Examples: node:20-alpine, maven:3.9-eclipse-temurin-21, python:3.12-slim, golang:1.22
#   image: <your-build-image>
#   script:
#     # CHANGE: replace with your actual build command.
#     - echo "CHANGE ME — e.g. npm ci && npm run build | mvn package -DskipTests | make build"
#   artifacts:
#     # NEW: persist build artifacts for downstream stages.
#     paths:
#       - dist/      # CHANGE: set to your artifact output directory
#       - target/
#     expire_in: 1 hour   # NEW: auto-expire artifacts to save storage
#
# # ─────────────────────────────────────────────────────────────────────────
# # STAGE 2: TEST
# # ─────────────────────────────────────────────────────────────────────────
# test:
#   stage: test
#   image: <your-build-image>   # CHANGE: same image as build stage
#   script:
#     # CHANGE: replace with your actual test command.
#     - echo "CHANGE ME — e.g. npm test | mvn verify | pytest | make test"
#   artifacts:
#     # NEW: publish test results for GitLab's test report widget.
#     when: always   # NEW: upload even on failure
#     reports:
#       junit: test-results/*.xml   # CHANGE: set to your JUnit XML output path
#     paths:
#       - coverage/
#     expire_in: 1 hour
#
# # ─────────────────────────────────────────────────────────────────────────
# # STAGE 3: SAST
# # ─────────────────────────────────────────────────────────────────────────
# sast:
#   stage: sast
#   # NEW: GitLab-native SAST template — auto-detects language and runs appropriate analyzers.
#   # To use GitLab's built-in SAST, include the template below and remove the custom script.
#   # include:
#   #   - template: Security/SAST.gitlab-ci.yml
#   #
#   # Alternatively, use a custom SAST tool:
#   image: <your-sast-image>   # CHANGE: e.g. returntocorp/semgrep, or your SAST tool image
#   script:
#     # CHANGE: replace with your SAST tool command.
#     - echo "CHANGE ME — e.g. semgrep --config=auto --severity=ERROR ."
#   artifacts:
#     # NEW: publish SAST findings as a GitLab security report.
#     reports:
#       sast: gl-sast-report.json   # CHANGE: match your tool's output file name
#     when: always
#     expire_in: 1 hour
#   allow_failure: false   # NEW: SAST failures block the pipeline
#
# # ─────────────────────────────────────────────────────────────────────────
# # STAGE 4: CONTAINER BUILD
# # ─────────────────────────────────────────────────────────────────────────
# container-build:
#   stage: container-build
#   # NEW: Docker-in-Docker service required to build images in GitLab CI.
#   image: docker:24   # NEW: pinned to Docker 24 (latest stable major)
#   services:
#     - docker:24-dind   # NEW: Docker daemon sidecar
#   before_script:
#     # NEW: authenticate to the registry before building.
#     - docker login -u "$CI_REGISTRY_USER" -p "$CI_REGISTRY_PASSWORD" "$CI_REGISTRY"
#   script:
#     - docker build
#         --file "$DOCKERFILE_PATH"
#         --tag "$IMAGE_NAME:$IMAGE_TAG"
#         --tag "$IMAGE_NAME:latest"
#         .   # CHANGE: replace '.' with your Docker build context if different
#     - docker push "$IMAGE_NAME:$IMAGE_TAG"
#     - docker push "$IMAGE_NAME:latest"
#   # NEW: only build images from the default branch and merge requests.
#   only:
#     - main     # CHANGE: set to your default branch name
#     - merge_requests
#
# # ─────────────────────────────────────────────────────────────────────────
# # STAGE 5: IMAGE SCAN
# # ─────────────────────────────────────────────────────────────────────────
# image-scan:
#   stage: image-scan
#   # NEW: GitLab-native container scanning template.
#   # To use GitLab's built-in scanner, include the template and set CS_IMAGE.
#   # include:
#   #   - template: Security/Container-Scanning.gitlab-ci.yml
#   # variables:
#   #   CS_IMAGE: "$IMAGE_NAME:$IMAGE_TAG"
#   #
#   # Alternatively, use Trivy directly:
#   image: aquasec/trivy:latest   # CHANGE: pin to a specific Trivy version for reproducibility
#   script:
#     - trivy image
#         --severity "$SCAN_SEVERITY"
#         --exit-code 1
#         --format template
#         --template "@/contrib/gitlab.tpl"
#         --output gl-container-scanning-report.json
#         "$IMAGE_NAME:$IMAGE_TAG"
#   artifacts:
#     # NEW: publish scan results as a GitLab container scanning report.
#     reports:
#       container_scanning: gl-container-scanning-report.json
#     when: always
#     expire_in: 1 hour
#   allow_failure: false   # NEW: scan failures block the pipeline
#   only:
#     - main
#     - merge_requests
#
# # ─────────────────────────────────────────────────────────────────────────
# # STAGE 6: DEPLOY
# # ─────────────────────────────────────────────────────────────────────────
# deploy:
#   stage: deploy
#   image: <your-deploy-image>   # CHANGE: e.g. bitnami/kubectl, alpine/helm, amazon/aws-cli
#   environment:
#     # NEW: GitLab environment block enables deployment tracking and rollback.
#     name: production   # CHANGE: set to your target environment name
#     url: https://<your-app-url>   # CHANGE: set to your deployed application URL
#   script:
#     # CHANGE: replace with your actual deployment command.
#     # Examples:
#     #   kubectl set image deployment/<name> <container>=$IMAGE_NAME:$IMAGE_TAG
#     #   helm upgrade --install <release> <chart> --set image.tag=$IMAGE_TAG
#     #   aws ecs update-service --cluster <c> --service <s> --force-new-deployment
#     - echo "CHANGE ME — add your deployment command here"
#   # NEW: only deploy from the default branch, not from merge requests.
#   only:
#     - main   # CHANGE: set to your default branch name
#   when: manual   # NEW: require a manual approval click before deploying to production
#                  # CHANGE to 'on_success' for fully automated deploys
#
# --- END GITLAB CI ---


###############################################################################
# SECTION 3: GENERIC SHELL PIPELINE SCRIPT
# Save as: pipeline.sh
# Use when: no dedicated CI platform is available; run on any Linux host or
#           as a fallback script invoked by a simpler CI system.
###############################################################################

# --- BEGIN SHELL PIPELINE ---
#!/usr/bin/env bash
# pipeline.sh — Generic CI/CD pipeline script
# NEW: set -euo pipefail ensures the script exits immediately on any error,
#      treats unset variables as errors, and propagates pipe failures.
set -euo pipefail

# ─────────────────────────────────────────────────────────────────────────────
# CONFIGURATION — override these via environment variables or edit in place.
# ─────────────────────────────────────────────────────────────────────────────

# NEW: REGISTRY — container registry host.
REGISTRY="${REGISTRY:-<your-container-registry>}"

# NEW: IMAGE_NAME — full image path (registry/org/name).
IMAGE_NAME="${IMAGE_NAME:-<your-image-name>}"

# NEW: IMAGE_TAG — tag applied to the built image; defaults to git commit SHA.
IMAGE_TAG="${IMAGE_TAG:-$(git rev-parse --short HEAD 2>/dev/null || echo "latest")}"

# NEW: SCAN_SEVERITY — comma-separated list of severities that fail the pipeline.
SCAN_SEVERITY="${SCAN_SEVERITY:-CRITICAL,HIGH}"

# NEW: DOCKERFILE_PATH — path to the Dockerfile.
DOCKERFILE_PATH="${DOCKERFILE_PATH:-./Dockerfile}"

# NEW: DOCKER_CONTEXT — Docker build context directory.
DOCKER_CONTEXT="${DOCKER_CONTEXT:-.}"

# NEW: DEPLOY_ENV — target deployment environment name.
DEPLOY_ENV="${DEPLOY_ENV:-production}"

# CHANGE: set these to your actual build, test, and deploy commands.
BUILD_COMMAND="${BUILD_COMMAND:-echo 'CHANGE ME: set BUILD_COMMAND'}"
TEST_COMMAND="${TEST_COMMAND:-echo 'CHANGE ME: set TEST_COMMAND'}"
SAST_COMMAND="${SAST_COMMAND:-echo 'CHANGE ME: set SAST_COMMAND (e.g. semgrep --config=auto .)'}"
DEPLOY_COMMAND="${DEPLOY_COMMAND:-echo 'CHANGE ME: set DEPLOY_COMMAND'}"

# ─────────────────────────────────────────────────────────────────────────────
# HELPER FUNCTIONS
# ─────────────────────────────────────────────────────────────────────────────

# NEW: log — print a timestamped stage banner to stdout.
log() {
  echo ""
  echo "════════════════════════════════════════════════════════════════"
  echo "  [$(date -u '+%Y-%m-%dT%H:%M:%SZ')] $*"
  echo "════════════════════════════════════════════════════════════════"
}

# NEW: fail — print an error message and exit with a non-zero code.
fail() {
  echo "[ERROR] $*" >&2
  exit 1
}

# ─────────────────────────────────────────────────────────────────────────────
# STAGE 1: BUILD
# ─────────────────────────────────────────────────────────────────────────────
stage_build() {
  log "STAGE 1: BUILD"
  # CHANGE: replace with your actual build command.
  eval "$BUILD_COMMAND" || fail "Build stage failed."
  log "BUILD: SUCCESS"
}

# ─────────────────────────────────────────────────────────────────────────────
# STAGE 2: TEST
# ─────────────────────────────────────────────────────────────────────────────
stage_test() {
  log "STAGE 2: TEST"
  # CHANGE: replace with your actual test command.
  eval "$TEST_COMMAND" || fail "Test stage failed."
  log "TEST: SUCCESS"
}

# ─────────────────────────────────────────────────────────────────────────────
# STAGE 3: SAST
# ─────────────────────────────────────────────────────────────────────────────
stage_sast() {
  log "STAGE 3: SAST"
  # CHANGE: replace with your SAST tool command.
  # Example using Semgrep: semgrep --config=auto --severity=ERROR --error .
  eval "$SAST_COMMAND" || fail "SAST stage failed — security findings detected."
  log "SAST: SUCCESS"
}

# ─────────────────────────────────────────────────────────────────────────────
# STAGE 4: CONTAINER BUILD
# ─────────────────────────────────────────────────────────────────────────────
stage_container_build() {
  log "STAGE 4: CONTAINER BUILD"

  # NEW: verify Docker is available before attempting to build.
  command -v docker >/dev/null 2>&1 || fail "Docker is not installed or not in PATH."

  # NEW: authenticate to the registry.
  # CHANGE: set REGISTRY_USER and REGISTRY_PASSWORD as environment variables or CI secrets.
  if [[ -n "${REGISTRY_PASSWORD:-}" ]]; then
    echo "${REGISTRY_PASSWORD}" | docker login "${REGISTRY}" \
      --username "${REGISTRY_USER:-}" \
      --password-stdin || fail "Docker registry login failed."
  else
    echo "[WARN] REGISTRY_PASSWORD not set — skipping docker login. Ensure you are pre-authenticated."
  fi

  # NEW: build the container image.
  docker build \
    --file "${DOCKERFILE_PATH}" \
    --tag "${IMAGE_NAME}:${IMAGE_TAG}" \
    --tag "${IMAGE_NAME}:latest" \
    "${DOCKER_CONTEXT}" || fail "Docker build failed."

  # NEW: push the image to the registry.
  docker push "${IMAGE_NAME}:${IMAGE_TAG}" || fail "Docker push (SHA tag) failed."
  docker push "${IMAGE_NAME}:latest"       || fail "Docker push (latest tag) failed."

  log "CONTAINER BUILD: SUCCESS — ${IMAGE_NAME}:${IMAGE_TAG}"
}

# ─────────────────────────────────────────────────────────────────────────────
# STAGE 5: IMAGE SCAN
# ─────────────────────────────────────────────────────────────────────────────
stage_image_scan() {
  log "STAGE 5: IMAGE SCAN"

  # NEW: verify a scan tool is available.
  # CHANGE: replace 'trivy' with your chosen image scanner (grype, snyk, etc.).
  if command -v trivy >/dev/null 2>&1; then
    # NEW: run Trivy; --exit-code 1 causes a non-zero exit on findings above threshold.
    trivy image \
      --severity "${SCAN_SEVERITY}" \
      --exit-code 1 \
      "${IMAGE_NAME}:${IMAGE_TAG}" || fail "Image scan failed — vulnerabilities detected at or above ${SCAN_SEVERITY}."
  else
    # NEW: fallback warning if no scanner is installed.
    echo "[WARN] No image scanner found. Install trivy, grype, or snyk and set SCAN_COMMAND."
    echo "[WARN] Skipping image scan — THIS IS NOT RECOMMENDED FOR PRODUCTION PIPELINES."
    # CHANGE: remove the line below and install a scanner to enforce this gate.
  fi

  log "IMAGE SCAN: SUCCESS"
}

# ─────────────────────────────────────────────────────────────────────────────
# STAGE 6: DEPLOY
# ─────────────────────────────────────────────────────────────────────────────
stage_deploy() {
  log "STAGE 6: DEPLOY — environment: ${DEPLOY_ENV}"

  # NEW: export image reference so the deploy command can reference it.
  export IMAGE_REF="${IMAGE_NAME}:${IMAGE_TAG}"
  export DEPLOY_ENV

  # CHANGE: replace with your actual deployment command.
  # Examples:
  #   kubectl set image deployment/<name> <container>="${IMAGE_REF}"
  #   helm upgrade --install <release> <chart> --set image.tag="${IMAGE_TAG}"
  #   aws ecs update-service --cluster <c> --service <s> --force-new-deployment
  eval "$DEPLOY_COMMAND" || fail "Deploy stage failed."

  log "DEPLOY: SUCCESS — ${IMAGE_REF} deployed to ${DEPLOY_ENV}"
}

# ─────────────────────────────────────────────────────────────────────────────
# MAIN — execute all stages in order.
# NEW: each stage is a discrete function; comment out any stage to skip it.
# ─────────────────────────────────────────────────────────────────────────────
main() {
  log "CI/CD PIPELINE START — image: ${IMAGE_NAME}:${IMAGE_TAG}"

  stage_build
  stage_test
  stage_sast
  stage_container_build
  stage_image_scan
  stage_deploy

  log "CI/CD PIPELINE COMPLETE — all stages passed."
}

main "$@"

# --- END SHELL PIPELINE ---


###############################################################################
# REQUIRED SECRETS / ENVIRONMENT VARIABLES REFERENCE
# ─────────────────────────────────────────────────────────────────────────────
# Store these as encrypted secrets in your CI platform — NEVER commit them.
#
# Secret name          Description
# ─────────────────    ──────────────────────────────────────────────────────
# REGISTRY_USER        Username or robot account for the container registry
# REGISTRY_PASSWORD    Password or token for the container registry
# KUBECONFIG           (if deploying to Kubernetes) base64-encoded kubeconfig
# AWS_ACCESS_KEY_ID    (if deploying to AWS) IAM access key
# AWS_SECRET_ACCESS_KEY(if deploying to AWS) IAM secret key
# SNYK_TOKEN           (if using Snyk for SAST or image scan) Snyk API token
# DEPLOY_SSH_KEY       (if deploying via SSH) private key for target host
###############################################################################


###############################################################################
# DOCKERFILE TEMPLATE
# Save as: Dockerfile
# NEW: minimal, security-hardened multi-stage Dockerfile template.
#      Replace each CHANGE comment with values specific to your application.
###############################################################################

# --- BEGIN DOCKERFILE ---
# Stage 1 — Builder
# CHANGE: replace 'builder-base-image' with the image that provides your build toolchain.
# Examples: node:20-alpine, maven:3.9-eclipse-temurin-21-alpine, python:3.12-slim, golang:1.22-alpine
# FROM <builder-base-image> AS builder
# WORKDIR /app
# COPY . .
# # CHANGE: replace with your build command.
# RUN echo "CHANGE ME — e.g. npm ci && npm run build | mvn package -DskipTests | make build"

# Stage 2 — Runtime
# NEW: multi-stage build keeps the final image small and free of build-time dependencies.
# CHANGE: replace 'runtime-base-image' with a minimal runtime image.
# Examples: node:20-alpine, eclipse-temurin:21-jre-alpine, python:3.12-slim, gcr.io/distroless/base
# FROM <runtime-base-image>
# WORKDIR /app

# NEW: run as a non-root user to reduce container attack surface.
# CHANGE: adjust UID/GID if your application requires specific values.
# RUN addgroup -S appgroup && adduser -S appuser -G appgroup
# USER appuser

# COPY --from=builder /app/dist ./dist   # CHANGE: copy only the artifacts needed at runtime

# NEW: expose only the port your application listens on.
# EXPOSE 8080   # CHANGE: set to your application's port

# NEW: use ENTRYPOINT + CMD pattern for flexibility.
# ENTRYPOINT ["<your-runtime-executable>"]   # CHANGE: e.g. node, java, python, ./myapp
# CMD ["<your-entrypoint-script-or-args>"]   # CHANGE: e.g. dist/server.js, -jar app.jar

# --- END DOCKERFILE ---