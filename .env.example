name: CodeQL

on:
  push:
    branches: [ "main" ] # NEW: Run CodeQL on pushes to the default branch (adjust if your default branch is not "main")
  pull_request:
    branches: [ "main" ] # NEW: Run CodeQL on pull requests targeting the default branch
  schedule:
    - cron: "0 6 * * 1" # NEW: Weekly scheduled scan to ensure periodic coverage even without recent PR activity

jobs:
  analyze:
    name: Analyze
    runs-on: ubuntu-latest # NEW: Standard GitHub-hosted runner compatible with CodeQL action defaults

    permissions:
      actions: read # NEW: Required by CodeQL workflow to access action metadata
      contents: read # NEW: Required to read repository contents for analysis
      security-events: write # NEW: Required to upload CodeQL results to GitHub code scanning

    strategy:
      fail-fast: false # NEW: Prevents cancelling other matrix runs if one language fails
      matrix:
        language: [ "javascript-typescript" ] # NEW: Placeholder language selection; update to your repo’s actual language(s) supported by CodeQL

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4 # NEW: Required to fetch source code for analysis

      - name: Initialize CodeQL
        uses: github/codeql-action/init@v3 # NEW: Initializes CodeQL with baseline (default) query suites for the selected language(s)
        with:
          languages: ${{ matrix.language }} # NEW: Ties initialization to the matrix-selected language
          # queries: security-extended # DEPRECATED/NOT USED: Omitted to keep baseline (default) queries as required by the spec

      - name: Autobuild
        uses: github/codeql-action/autobuild@v3 # NEW: Attempts to build the project automatically when a build is required for analysis

      - name: Perform CodeQL Analysis
        uses: github/codeql-action/analyze@v3 # NEW: Runs analysis and uploads results to GitHub code scanning
        with:
          category: "/language:${{ matrix.language }}" # NEW: Labels results by language for clearer reporting in code scanning