<Project Sdk="Microsoft.NET.Sdk">

  <!-- Target .NET 8.0: modern LTS release, required for compatibility with new SDK tools -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Use implicit 'GenerateAssemblyInfo', true by default in SDK style projects, no need to specify unless override needed -->
    <!-- Enable nullable reference types by default for modern .NET; comment/remove to opt-out -->
    <Nullable>enable</Nullable>
    <!-- ImplicitUsings adds common C# usings automatically; comment/remove to disable -->
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Add project references, package references, or additional settings as necessary for your application -->
  <!-- Example:
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  -->

</Project>