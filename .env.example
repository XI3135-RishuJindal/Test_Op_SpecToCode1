# Spring Boot 3.x uses snake_case for management endpoints now
management.endpoints.web.exposure.include=health,info # Explicitly expose actuator endpoints

# Jakarta EE namespace change: If you used servlet-related config, keys may need updating
spring.servlet.multipart.max-file-size=10MB  # Example; update namespace in your own config if needed
spring.servlet.multipart.max-request-size=10MB

# Spring Boot 3.x requires Java 17+; ensure minimum Java version compatibility at build/runtime if set via config

# If using legacy timezone/date properties, review those as Java 8+ Date/Time API is enforced

# Jackson serialization settings may have changed; review if custom ObjectMapper is configured
spring.jackson.default-property-inclusion=non_null # Example; update this if your original config used deprecated keys

# Configuration property changes for mail sender (example; update according to your mail setup)
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

# If using security endpoints (Spring Security), web path patterns now require {} syntax for variables:
# Example: spring.security.oauth2.client.provider.{provider}.issuer-uri

# Explicitly configure deprecated configuration keys if used, and migrate to new ones as per official migration guide

# If you use reactive server properties (Spring WebFlux), property names may have changed:
# Example (update accordingly):
spring.webflux.base-path=/

# YAML/Properties comments: Review all configuration for deprecation warnings and rename keys per migration guide

# If you used spring.datasource initialization (deprecated in 2.5+), now standardize:
spring.sql.init.mode=always  # Use new property to initialize DB

# NOTE: List only the keys above that *changed or are added* by the upgrade; remove deprecated or renamed keys from your configuration as needed.