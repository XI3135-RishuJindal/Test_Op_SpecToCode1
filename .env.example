# API Gateway Service — Environment Variables

NODE_ENV=development
PORT=3000

# JWT / OIDC
JWT_ISSUER=https://auth.example.com/
JWT_AUDIENCE=api.example.com
JWT_JWKS_URI=https://auth.example.com/.well-known/jwks.json
JWKS_CACHE_TTL_MS=600000
ACCESS_TOKEN_TTL_S=3600
REFRESH_TOKEN_TTL_S=2592000

# Redis
REDIS_URL=redis://localhost:6379
MFA_SESSION_TTL_S=300
IDEMPOTENCY_KEY_TTL_S=86400

# Postgres
DATABASE_URL=postgresql://gateway:gateway@localhost:5432/gateway

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_AUDIT_TOPIC=gateway.audit-events
KAFKA_CLIENT_ID=api-gateway-service

# OPA
OPA_URL=http://localhost:8181
OPA_POLICY_PATH=/v1/data/gateway/authz/allow
OPA_TIMEOUT_MS=5000

# Upstream services
USER_PROFILE_SERVICE_URL=http://user-profile-service:4001
MFA_SERVICE_URL=http://mfa-service:4002
REPORTING_SERVICE_URL=http://reporting-service:4003
PAYMENT_SERVICE_URL=http://payment-service:4004
NOTIFICATION_SERVICE_URL=http://notification-service:4005

# Proxy / Circuit breaker
UPSTREAM_TIMEOUT_MS=30000
CB_THRESHOLD=5
CB_RESET_MS=30000

# Rate limits (defaults)
# Auth login: 10/min per IP
# Payments: 100/min per user
# General: 1000/min per user
# Admin: 200/min per user

# Observability
LOG_LEVEL=info
JAEGER_ENDPOINT=http://localhost:14268/api/traces
PROMETHEUS_ENABLED=true

# CORS
CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
