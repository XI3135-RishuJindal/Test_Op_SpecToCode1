# Flask 3.x requires explicit setting of FLASK_DEBUG and FLASK_ENV
FLASK_ENV=development  # Set to 'production' for production environment
FLASK_DEBUG=True  # Set to 'False' in production

# Flask 3.x uses FLASK_RUN_EXTRA_FILES for reloading behavior
FLASK_RUN_EXTRA_FILES=  # Comma separated list of extra files to watch for autoreload

# The application entry point syntax may require explicit FLASK_APP
FLASK_APP=app:app  # Update as appropriate for your application module/package