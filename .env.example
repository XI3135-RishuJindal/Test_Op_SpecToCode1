# CI/CD Pipeline Configuration
# Generated for: Build, Test, SAST, Container Build, Image Scan, and Deploy stages
#
# INSTRUCTIONS FOR USE:
#   This is a technology-agnostic pipeline template. Before using, replace all
#   placeholder values (marked with <ANGLE_BRACKETS>) with values specific to
#   your project. Select the CI/CD platform section that matches your toolchain
#   and remove or ignore the others.
#
# SUPPORTED PLATFORMS (choose one):
#   - GitHub Actions  (.github/workflows/pipeline.yml)
#   - GitLab CI       (.gitlab-ci.yml)
#   - Generic shell   (pipeline.sh)
#
# ─────────────────────────────────────────────────────────────────────────────
# SHARED PIPELINE VARIABLES (apply to all platforms)
# ─────────────────────────────────────────────────────────────────────────────
#
# REGISTRY          = <your-container-registry>          # e.g. ghcr.io, registry.gitlab.com, docker.io
# REGISTRY_USER     = <registry-username-or-robot>
# REGISTRY_PASSWORD = <registry-password-or-token>       # store as a CI secret, never in plain text
# IMAGE_NAME        = <your-image-name>                  # e.g. myorg/myapp
# IMAGE_TAG         = <tag-strategy>                     # e.g. $COMMIT_SHA, $VERSION, latest
# DEPLOY_ENV        = <target-environment>               # e.g. staging, production
# DEPLOY_SCRIPT     = <path-to-deploy-script>            # e.g. ./scripts/deploy.sh
# SAST_TOOL         = <sast-tool>                        # e.g. semgrep, bandit, eslint-security
# SCAN_TOOL         = <image-scan-tool>                  # e.g. trivy, grype, snyk
# SCAN_SEVERITY     = CRITICAL,HIGH                      # fail pipeline on these severities
# BUILD_COMMAND     = <your-build-command>               # e.g. make build, npm run build, mvn package
# TEST_COMMAND      = <your-test-command>                # e.g. make test, npm test, mvn verify
# DOCKERFILE_PATH   = ./Dockerfile                       # path to Dockerfile
# DOCKERFILE_CONTEXT= .                                  # Docker build context directory

###############################################################################
# SECTION 1: GITHUB ACTIONS
# Save as: .github/workflows/pipeline.yml
###############################################################################

# --- BEGIN GITHUB ACTIONS ---
#
# name: CI/CD Pipeline
#
# # Trigger: run on every push to main/master and on pull requests targeting main/master.
# # New key: 'workflow_dispatch' added to allow manual pipeline runs from the GitHub UI.
# on:
#   push:
#     branches:
#       - main          # change to your default branch name if different
#       - master
#   pull_request:
#     branches:
#       - main
#       - master
#   workflow_dispatch:  # NEW: enables manual trigger from GitHub Actions UI
#
# # Top-level permissions: restrict to least privilege.
# # New key: 'permissions' block added to follow security best practices.
# permissions:
#   contents: read        # NEW: read repo contents only
#   packages: write       # NEW: required to push images to GHCR
#   security-events: write # NEW: required to upload SARIF results to GitHub Security tab
#
# env:
#   REGISTRY: ghcr.io                          # CHANGE: set to your registry
#   IMAGE_NAME: ${{ github.repository }}       # defaults to org/repo; override if needed
#   IMAGE_TAG: ${{ github.sha }}               # NEW: tag images with commit SHA for traceability
#   SCAN_SEVERITY: CRITICAL,HIGH               # NEW: severities that will fail the pipeline
#
# jobs:
#
#   # ─────────────────────────────────────────────────────────────────────────
#   # STAGE 1: BUILD
#   # Purpose: Compile source code and produce build artifacts.
#   # ─────────────────────────────────────────────────────────────────────────
#   build:
#     name: Build
#     runs-on: ubuntu-latest   # CHANGE: use self-hosted runner if required
#     steps:
#       - name: Checkout source
#         uses: actions/checkout@v4   # NEW: pinned to v4 (latest stable)
#
#       - name: Set up build environment
#         # CHANGE: replace this step with the setup action for your language/runtime.
#         # Examples:
#         #   Node.js  → uses: actions/setup-node@v4 / with: { node-version: '20' }
#         #   Java     → uses: actions/setup-java@v4 / with: { java-version: '21' }
#         #   Python   → uses: actions/setup-python@v5 / with: { python-version: '3.12' }
#         #   Go       → uses: actions/setup-go@v5 / with: { go-version: '1.22' }
#         run: echo "CHANGE ME — add your runtime setup step here"
#
#       - name: Build
#         # CHANGE: replace with your actual build command.
#         run: echo "CHANGE ME — e.g. make build | npm run build | mvn package -DskipTests"
#
#       - name: Upload build artifacts
#         # NEW: persist artifacts so downstream jobs can consume them without rebuilding.
#         uses: actions/upload-artifact@v4
#         with:
#           name: build-artifacts
#           path: |
#             ./dist          # CHANGE: set to your actual artifact output directory
#             ./target
#           if-no-files-found: warn   # NEW: warn instead of error if path does not exist
#
#   # ─────────────────────────────────────────────────────────────────────────
#   # STAGE 2: TEST
#   # Purpose: Run unit, integration, and/or end-to-end tests.
#   # Gate: pipeline fails if any test fails.
#   # ─────────────────────────────────────────────────────────────────────────
