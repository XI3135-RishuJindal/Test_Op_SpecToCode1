# Updated configuration template

# ASP.NET Web API configuration upgrades
ASPNETCORE_ENVIRONMENT=Development # Set the environment for ASP.NET Core (e.g., Development, Staging, Production)
ASPNETCORE_URLS="http://localhost:5000;https://localhost:5001" # Define the URLs the application will listen on

# New settings for CORS policy configurations
CORS_ORIGINS="https://example.com" # Allowed origins for CORS requests

# New authentication settings
JWT_SECRET="your_jwt_secret_key" # Secret key for JWT token validation
JWT_VALID_ISSUER="https://your-issuer.com" # Valid issuer for JWT tokens
JWT_VALID_AUDIENCE="https://your-audience.com" # Valid audience for JWT tokens

# Database connection string updates
DATABASE_CONNECTION_STRING="Server=your_server;Database=your_database;User Id=your_user;Password=your_password;" # Updated connection string format for the upgraded ORM or database provider

# Logging level adjustments
LOGGING__LOGLEVEL__DEFAULT="Information" # Set the default logging level in the new logging framework

# Health check settings
HEALTHCHECK_URL="/health" # Endpoint for health check verification in .NET Core applications