# ──────────────────────────────────────────────────────────────────────────────
# API Gateway / BFF Service — Environment Variables
# Copy this file to .env and fill in the values for your environment.
# ──────────────────────────────────────────────────────────────────────────────

# ── Service identity ──────────────────────────────────────────────────────────
APP_NAME=api-gateway
APP_VERSION=0.1.0
ENVIRONMENT=development          # development | staging | production

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=1
LOG_LEVEL=info                   # debug | info | warning | error | critical

# ── Upstream services ─────────────────────────────────────────────────────────
IDENTITY_SERVICE_URL=http://identity-service:8001

# ── Redis (rate limiting & caching) ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100          # max requests per window per client IP
RATE_LIMIT_WINDOW_SECONDS=60     # sliding-window duration in seconds

# ── Request size ──────────────────────────────────────────────────────────────
MAX_REQUEST_BODY_BYTES=1048576   # 1 MiB

# ── OpenTelemetry ─────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=     # e.g. http://otel-collector:4317 (empty = console)
OTEL_SERVICE_NAME=api-gateway

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or * for all
CORS_ALLOW_ORIGINS=["*"]
