# Flask 3.x Configuration Template
# This is a complete example of a Flask configuration file, updated for Flask 3.x.
# All keys shown are compatible with Flask 3.x defaults and options.

# Core Flask settings
DEBUG = False                  # Enable/disable debug mode (unchanged).
TESTING = False                # Enable test mode (unchanged).
SECRET_KEY = "change-me"       # Required: Used to sign session cookies.

# Server settings
JSON_AS_ASCII = False          # Unchanged: Ensure JSON responses use UTF-8.
JSON_SORT_KEYS = False         # Unchanged: Do not sort JSON keys automatically.
JSONIFY_PRETTYPRINT_REGULAR = False  # Unchanged: Don't pretty-print JSON.

# Session and Cookie settings
SESSION_COOKIE_NAME = 'session'              # Unchanged: Name of the session cookie.
SESSION_COOKIE_SECURE = True                 # Should be True in production for HTTPS.
SESSION_COOKIE_HTTPONLY = True               # Prevent JS access to cookies.
SESSION_COOKIE_SAMESITE = 'Lax'              # 'Lax' is default in Flask 3.x.

# Templating settings
TEMPLATES_AUTO_RELOAD = True                 # Reload templates on changes (dev setting).
# Note: 'EXPLAIN_TEMPLATE_LOADING' is removed in Flask 3.x as it's deprecated.
# EXPLAIN_TEMPLATE_LOADING = False           # (Deprecated in Flask 3.x)

# Blueprints and static files
STATIC_FOLDER = 'static'                     # Folder for static files (unchanged).
STATIC_URL_PATH = '/static'                  # URL path for static files (unchanged).

# Internationalization
MAX_CONTENT_LENGTH = 16 * 1024 * 1024        # Restrict maximum accepted request size.

# Logging (no changes, included for completeness)
PROPAGATE_EXCEPTIONS = None                  # Use Flask 3.x default handling.

# New in Flask 3.x: Response Streaming Option
RESPONSE_STREAMING = False                   # New in Flask 3.x: Controls streaming responses.

# New in Flask 3.x: ASN.1 DER JSON ENCODING
JSON_ENSURE_ASCII = False                    # New behavior: Ensure ASCII in JSON (recommend False for UTF-8 support).

# Deprecated/removed settings
# APPLICATION_ROOT is deprecated and should not be used in Flask 3.x
# APPLICATION_ROOT = '/'                     # (Deprecated in Flask 3.x)

# End of configuration