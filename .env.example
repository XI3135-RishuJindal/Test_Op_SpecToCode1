version: 2.1

jobs:
  dependency_vulnerability_scan:
    docker:
      - image: cimg/base:stable
    steps:
      - checkout

      - run:
          name: Install Trivy vulnerability scanner
          command: |
            sudo apt-get update
            sudo apt-get install -y wget apt-transport-https gnupg lsb-release
            wget -qO - https://aquasecurity.github.io/trivy-repo/deb/public.key | sudo apt-key add -
            echo "deb https://aquasecurity.github.io/trivy-repo/deb $(lsb_release -sc) main" | sudo tee -a /etc/apt/sources.list.d/trivy.list
            sudo apt-get update
            sudo apt-get install -y trivy

      - run:
          name: Run dependency vulnerability scan (fail on CRITICAL)
          command: |
            mkdir -p artifacts

            # New: Human-readable report artifact for developers/auditability
            trivy fs \
              --scanners vuln \  # New: Limit scan to dependency vulnerabilities (vs. secrets/misconfig) to match upgrade goal
              --severity CRITICAL \  # New: Enforce policy focus on CRITICAL findings
              --exit-code 1 \  # New: Fail the gate (block pipeline) when CRITICAL vulnerabilities are found
              --format table \  # New: Generate a readable report for CI review
              --output artifacts/dependency-vuln-report.txt \  # New: Store report as a CI artifact
              .

            # New: Machine-readable report artifact for tooling/auditability
            trivy fs \
              --scanners vuln \  # New: Limit scan to dependency vulnerabilities (vs. secrets/misconfig) to match upgrade goal
              --severity CRITICAL \  # New: Enforce policy focus on CRITICAL findings
              --exit-code 1 \  # New: Fail the gate (block pipeline) when CRITICAL vulnerabilities are found
              --format json \  # New: Generate a machine-readable report for automated processing
              --output artifacts/dependency-vuln-report.json \  # New: Store report as a CI artifact
              .

      - store_artifacts:
          path: artifacts
          destination: dependency-vulnerability-scan

workflows:
  version: 2
  security_gates:
    jobs:
      - dependency_vulnerability_scan  # New: Required dependency vulnerability scanning gate (fails pipeline on CRITICAL)