# No configuration changes are strictly required for jakarta.* migration 
# or core Spring Boot 3.x API changes. 
# However, for future compatibility, ensure the following property is set for Spring Boot 3.x:

spring.jackson.default-property-inclusion=non_null # Recommended for Spring Boot 3.x (serializes non-null fields only)

# If any actuator endpoints are used, update endpoint exposure patterns:
management.endpoints.web.exposure.include=* # Expose all actuator endpoints in Spring Boot 3.x; customize as needed

# If using legacy server port key, update it (for Spring Boot 3.x):
server.port=8080 # Standard port property remains unchanged for migration

# If web security is migrated, Spring Boot 3.x disables actuator exposure by default:
# You may need to update security config separately; no .env keys for basic Spring Security changes