# .NET 8 SDK-style projects require specifying the target framework
# Update the following key in your build configuration to use .NET 8

DOTNET_TARGET_FRAMEWORK=net8.0   # Target framework for .NET 8 SDK-style projects

# If previously using AssemblyInfo.cs or old configuration, move assembly metadata to the new csproj file format
# These keys are only needed if you set them via environment variables in your build pipeline

DOTNET_GENERATE_ASSEMBLYINFO=true      # Set to true to auto-generate AssemblyInfo from csproj properties
DOTNET_USE_SDK_STYLE_PROJECTS=true    # Indicates use of new SDK-style csproj format for .NET 8

# If building with global.json, ensure the correct SDK version is selected
DOTNET_SDK_VERSION=8.0.*      # Specify the .NET 8 SDK version to use