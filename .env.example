<IntegrationTests.csproj>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Target framework: use the same TFM as the application under test (update to match your app's TFM) -->
    <TargetFramework>net8.0</TargetFramework>

    <!-- Marks this project as a test project so dotnet test discovers it -->
    <IsPackable>false</IsPackable>

    <!-- Suppress nullable warnings in test code; adjust to match solution-wide policy -->
    <Nullable>enable</Nullable>

    <!-- Enable implicit usings to reduce boilerplate in test files -->
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Treat warnings as errors is intentionally left off for test projects to reduce friction -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- xUnit test framework: core runner and assertion library -->
    <PackageReference Include="xunit" Version="2.9.0" />

    <!-- xUnit runner for dotnet test / MSBuild integration -->
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!-- Microsoft test SDK required by dotnet test to discover and run xUnit tests -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />

    <!-- WebApplicationFactory and related in-process test server infrastructure -->
    <!-- Version must match the ASP.NET Core version of the application under test -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.0" />

    <!-- Optional: coverlet for code coverage collection during dotnet test -->
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Reference to the application under test.
         Replace "YourApp.Api" with the actual project name of the ASP.NET Core host. -->
    <ProjectReference Include="..\YourApp.Api\YourApp.Api.csproj" />
  </ItemGroup>

</Project>