.github/workflows/ci.yml

# GitHub Actions CI/CD pipeline introducing lint, SAST, and test stages.
# Triggers on every push to main and on all pull requests targeting main.
# All three jobs (lint, sast, test) must pass before a PR can be merged
# when branch protection rules are configured to require these status checks.

name: CI

on:
  push:
    branches:
      - main          # Run pipeline on every push to the main branch
  pull_request:
    branches:
      - main          # Run pipeline on every PR targeting main

# Limit concurrent runs on the same ref to avoid redundant work.
# In-progress runs on the same branch are cancelled when a new run starts.
concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:

  # ---------------------------------------------------------------------------
  # LINT STAGE
  # Runs static code style and formatting checks.
  # TODO: Replace the placeholder step below with the linter appropriate for
  #       this project's language/runtime once confirmed (e.g. eslint, flake8,
  #       golangci-lint, rubocop, checkstyle, etc.).
  # ---------------------------------------------------------------------------
  lint:
    name: Lint
    runs-on: ubuntu-latest   # Use the latest stable GitHub-hosted Ubuntu runner

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4   # Pin to v4 (latest stable major) for security

      # TODO: Add a language-specific setup step here, for example:
      #   - uses: actions/setup-node@v4        (Node.js)
      #   - uses: actions/setup-python@v5      (Python)
      #   - uses: actions/setup-go@v5          (Go)
      #   - uses: actions/setup-java@v4        (Java/Kotlin)
      # Replace or remove this placeholder once the runtime is confirmed.

      - name: Run linter
        # TODO: Replace this placeholder command with the actual lint invocation,
        #       e.g. `npm run lint`, `flake8 .`, `golangci-lint run`, etc.
        #       Remove this comment block once the command is confirmed.
        run: |
          echo "TODO: replace with real lint command"
          exit 0

  # ---------------------------------------------------------------------------
  # SAST STAGE
  # Runs static application security testing using CodeQL (GitHub-native,
  # language-agnostic, free for public and GitHub Advanced Security-enabled
  # private repos). CodeQL is the recommended default when the language is not
  # yet confirmed; swap for a language-specific tool (Semgrep, Bandit, etc.)
  # if preferred.
  # ---------------------------------------------------------------------------
  sast:
    name: SAST
    runs-on: ubuntu-latest
    # Required permissions for CodeQL to upload SARIF results to the
    # GitHub Security tab and for the checkout action.
    permissions:
      actions: read
      contents: read
      security-events: write   # Allows uploading SARIF scan results

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      # Initialize CodeQL analysis.
      # TODO: Set `languages` to the actual language(s) used in this repo once
      #       confirmed. Supported values: c-cpp, csharp, go, java-kotlin,
      #       javascript-typescript, python, ruby, swift.
      #       Example for a JavaScript project: languages: '["javascript-typescript"]'
      - name: Initialize CodeQL
        uses: github/codeql-action/init@v3   # v3 is the latest stable major
        with:
          languages: ${{ vars.CODEQL_LANGUAGES || 'javascript-typescript' }}
          # languages: '["python"]'          # Uncomment and set once confirmed
          queries: security-and-quality      # Run both security and quality query suites

      # CodeQL auto-build attempts to build compiled languages automatically.
      # For interpreted languages (Python, JS/TS, Ruby) this step is a no-op
      # and can be removed once the language is confirmed as interpreted.
      - name: Autobuild
        uses: github/codeql-action/autobuild@v3

      # Perform the CodeQL analysis and upload results to GitHub Security tab.
      - name: Perform CodeQL Analysis
        uses: github/codeql-action/analyze@v3
        with:
          category: "/language:${{ vars.CODEQL_LANGUAGES || 'javascript-typescript' }}"

  # ---------------------------------------------------------------------------
  # TEST STAGE
  # Runs the project's automated test suite.
  # TODO: Replace the placeholder step below with the test runner appropriate
  #       for this project (e.g. `npm test`, `pytest`, `go test ./...`,
  #       `./gradlew test`, `bundle exec rspec`, etc.).
  # ---------------------------------------------------------------------------
  test:
    name: Test
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      # TODO: Add a language-specific setup step here (same as lint stage).
      # Example:
      #   - uses: actions/setup-node@v4
      #     with:
      #       node-version: 'lts/*'
      #       cache: 'npm'

      # TODO: Add a dependency installation step if required, for example:
      #   - run: npm ci
      #   - run: pip install -r requirements.txt
      #   - run: go mod download

      - name: Run tests
        # TODO: Replace this placeholder command with the actual test invocation.
        #       Remove this comment block once the command is confirmed.
        run: |
          echo "TODO: replace with real test command"
          exit 0

      # Optional: upload test results or coverage reports as artifacts.
      # Uncomment and configure once the test runner and output format are known.
      # - name: Upload test results
      #   if: always()   # Upload even when tests fail so results are always visible
      #   uses: actions/upload-artifact@v4
      #   with:
      #     name: test-results
      #     path: |
      #       # TODO: set path to test result files, e.g. coverage/, test-results.xml
      #     retention-days: 14   # Retain artifacts for 14 days