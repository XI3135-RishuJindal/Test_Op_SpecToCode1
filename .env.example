# SQLALCHEMY_ENGINE_OPTIONS: dictionary of options passed to SQLAlchemy engine (new in 2.x)
# Example: {"future": true, "echo": false}
SQLALCHEMY_ENGINE_OPTIONS=

# SQLALCHEMY_DATABASE_URI: Update driver string for SQLAlchemy 2.x compatibility if necessary
# Example: "postgresql+psycopg://user:pass@host/dbname"
SQLALCHEMY_DATABASE_URI=