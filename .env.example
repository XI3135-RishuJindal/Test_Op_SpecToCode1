# documentation-config.yaml

# Configuration file for documentation build and validation.
# Updated to reflect new runtime environment, dependencies, and config requirements.

# Specify the documentation runtime to use for building and previewing docs.
runtime: latest
# ^ Updated to require latest stable supported runtime (was previously unspecified or legacy).

# Define primary documentation source directories.
docs_dir: docs/
# ^ Set to the standard documentation folder.

# List of files to include in documentation build/release.
include_files:
  - README.md
  - CONTRIBUTING.md
  - DEPENDENCIES.md
# ^ Ensures all major user- and contributor-facing docs are included.

# Dependency section now accurately lists all required documentation dependencies.
dependencies:
  - markdownlint-cli
  - mkdocs
  - mkdocs-material
# ^ Updated dependency list for new documentation stack; previous dependencies now replaced.

# Configuration for markdown linting.
linting:
  enabled: true
  config_file: .markdownlint.yaml
# ^ Turns on markdownlint and points to standard configuration file.

# Configuration for documentation theme (defaults to recommended for new stack).
theme: material
# ^ Sets main theme to the new standard.

# Containerization is not supported/required in this upgrade; no container config present.

# Removed deprecated keys related to previous runtime and dependencies.
# (No old/legacy config present based on context, so nothing commented out.)

# End of configuration