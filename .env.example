# dependency-risk-inventory.config.yaml
# Purpose: configuration template to produce a prioritized upgrade backlog based on CVE exposure
# and outdated dependency analysis (ecosystem/tooling unknown in provided spec).

version: 1 # NEW: config schema version for this upgrade deliverable (prioritized upgrade backlog)

project:
  name: "" # NEW: set to your project/repo name to label backlog outputs
  repo: "" # NEW: optional repository URL/path for traceability in generated backlog

inputs:
  manifests: [] # NEW: list dependency manifest files to scan (ecosystem unknown; fill with paths)
  lockfiles: [] # NEW: list lockfiles to scan for resolved versions (if applicable; fill with paths)

analysis:
  cve:
    enabled: true # NEW: enable CVE exposure analysis as required by the upgrade goal
    sources: [] # NEW: vulnerability advisory sources are ecosystem/tool specific; provide explicitly
    include_withdrawn: false # NEW: conservative default—ignore withdrawn advisories unless required
    severity_floor: "" # NEW: optional filter; leave empty to include all severities (spec did not define)
  outdated:
    enabled: true # NEW: enable outdated dependency analysis as required by the upgrade goal
    criteria: "" # NEW: outdatedness criteria is TODO per spec (e.g., behind-latest / outside supported)
    allow_prerelease_targets: false # NEW: conservative default—do not recommend prerelease versions

prioritization:
  scheme: "" # NEW: priority rubric is TODO per spec (e.g., P0/P1/P2); define externally
  factors:
    cve_severity_weight: 0 # NEW: numeric weights are unspecified in spec; set when rubric is defined
    cve_known_exploit_weight: 0 # NEW: placeholder for exploitability signal; set when available
    outdatedness_weight: 0 # NEW: placeholder for outdatedness scoring; set when criteria is defined
    breaking_change_risk_weight: 0 # NEW: placeholder for breaking-change risk scoring; set when defined
  urgency: "medium" # NEW: set from spec (“Upgrade urgency: medium”)

backlog:
  output:
    path: "upgrade-backlog.json" # NEW: default output artifact path for the prioritized backlog
    format: "json" # NEW: machine-readable output to capture required per-item metadata
  required_fields: # NEW: minimum fields per spec deliverable; values are produced by tooling/process
    - dependency_identifier
    - ecosystem
    - current_version
    - recommended_target_version
    - cves
    - cve_severity
    - outdatedness_indicator
    - upgrade_type
    - breaking_change_risk
    - rationale
    - references
    - priority
    - urgency_classification

reporting:
  include_todos: true # NEW: emit TODO markers where spec indicates missing context (ecosystem/criteria/CVEs)
  include_references: true # NEW: include advisory/release-note references per spec
  include_metadata: true # NEW: include planning metadata (upgrade type, breaking risk) per spec

# Deprecated/removed:
# None provided by base source or spec; no keys can be marked deprecated without prior config context.