SESSION_TYPE=filesystem  # Changed session management to use filesystem storage as per Flask 3.x updates
SESSION_PERMANENT=True     # Updated to ensure sessions are permanent by default
SESSION_USE_SIGNER=True    # Enable session signing for added security
SESSION_COOKIE_SAMESITE='Lax'  # Added SameSite attribute for session cookie as a security measure
SESSION_COOKIE_SECURE=False  # Updated this based on deployment considerations; ensure to set to True in production