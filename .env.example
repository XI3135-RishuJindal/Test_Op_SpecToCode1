# Application Configuration File

# This configuration file includes sections for HTTP server setup 
# and logging, focusing on the new /health and /ready endpoints.

[http]
# Setting the port for the application server
port = 8080  # Default server port set to 8080

# Defining the /health endpoint configuration
# Returns HTTP 200 when the application is healthy
[http.endpoints.health]
path = "/health"
# A brief check to determine if the application is healthy
check = "basic"  # Type of health check performed, defaults to 'basic'

# Defining the /ready endpoint configuration
# Returns HTTP 200 when the application is ready to serve traffic
[http.endpoints.ready]
path = "/ready"
# A readiness check that determines if the application is ready
check = "basic"  # Type of readiness check performed, defaults to 'basic'

# Optional: [http.authentication]
# Configurations for securing endpoints, if authentication is required
# Uncomment and configure if needed
# type = "none"  # Authentication type, e.g., 'none', 'basic', 'oauth2'

[logging]
# General application logging settings
level = "info"  # Controls the verbosity of logs, default set to 'info'
# Enable or disable logging for the new endpoints
enable_health_logging = true  # Log requests to /health
enable_ready_logging = true  # Log requests to /ready

# Note: No deprecated keys applicable as
# there were no existing endpoints prior to this upgrade.