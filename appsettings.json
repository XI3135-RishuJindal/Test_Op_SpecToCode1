      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "Client": {
    "Id": "your-client-id",
    "Secret": "your-client-secret",
    "RedirectUri": "your-redirect-uri"
  }
}
