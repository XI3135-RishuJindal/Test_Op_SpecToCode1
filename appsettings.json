{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Audit": {
    "Enabled": true,
    "Service": "api-gateway",
    "Environment": "Development",
    "PseudonymizationSalt": "dev-only-change-me",
    "R06": {
      "EndpointUrl": "https://audit.example.com/r06/events",
      "ApiKey": "replace-in-secure-store"
    },
    "QueueCapacity": 1000,
    "TimeoutSeconds": 2,
    "MaxRetries": 3
  }
}