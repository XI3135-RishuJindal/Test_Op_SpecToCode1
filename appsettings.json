    "Audience": "ApiGatewayUsers"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "Oauth": {
    "ClientId": "your-oauth-client-id",
    "RedirectUri": "https://localhost/sso-callback",
    "AuthorizationEndpoint": "https://idp.example.com/authorize"
  }
}
