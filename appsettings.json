{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "your-secret-key-here-must-be-at-least-256-bits",
    "Issuer": "ApiGateway",
    "Audience": "ApiGatewayUsers"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "Authentication": {
    "DefaultRedirectUrl": "/profile",
    "Providers": {
      "Google": {
        "Enabled": true,
        "ClientId": "",
        "ClientSecret": "",
        "TokenValidationEndpoint": ""
      },
      "Facebook": {
        "Enabled": true,
        "ClientId": "",
        "ClientSecret": "",
        "TokenValidationEndpoint": ""
      },
      "Apple": {
        "Enabled": true,
        "ClientId": "",
        "ClientSecret": "",
        "TokenValidationEndpoint": ""
      }
    }
  }
}
