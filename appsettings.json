{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "your-secret-key-here-must-be-at-least-256-bits",
    "Issuer": "ApiGateway",
    "Audience": "ApiGatewayUsers"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "TokenValidation": {
    "Fallback": {
      "Enabled": true,
      "Introspection": {
        "Enabled": true,
        "Endpoint": "https://idp.example.com/introspect",
        "ClientId": "your-client-id",
        "ClientSecret": "your-client-secret",
        "CacheTtlSeconds": 60,
        "NegativeCacheTtlSeconds": 300
      }
    }
  }
}