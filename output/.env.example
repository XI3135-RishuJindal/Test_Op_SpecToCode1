# ============================================================
# .env.example — Account Management Service
# Copy to .env and fill in values before running locally.
# NEVER commit .env to source control.
# ============================================================

# ── Service Identity ─────────────────────────────────────────
SERVICE_NAME=account-management-service
SERVICE_VERSION=1.0.0

# ── VSAM / File Paths ────────────────────────────────────────
# Path to the VSAM-equivalent indexed data file
ACCT_VSAM_PATH=/data/accounts.dat

# Path to the sequential import file for customer data
IMPORT_FILE_PATH=/data/import/customers.dat

# ── Logging ──────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# ── Health Check ─────────────────────────────────────────────
HEALTH_CHECK_ENABLED=true

# ── Build / Compile ──────────────────────────────────────────
# GnuCOBOL compiler flags (override for mainframe-specific flags)
COBC_FLAGS=-x -free

# Output directory for compiled binaries
BIN_DIR=./bin
