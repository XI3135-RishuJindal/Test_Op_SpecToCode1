{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "Jwt": {
    "Key": "development-secret-key-for-testing-only-256-bits",
    "Issuer": "ApiGateway",
    "Audience": "ApiGatewayUsers"
  },
  // Development overrides for MFA — use short expiry and relaxed limits for easier testing.
  // Secrets are still read from dotnet user-secrets or environment variables even in Development.
  "Mfa": {
    "CodeExpirySeconds": 600,
    "MaxVerificationAttempts": 10,
    "DefaultMethod": "Email",
    "Sms": {
      "ProviderUrl": "https://api.twilio.com/2010-04-01/Accounts/{AccountSid}/Messages.json",
      "FromNumber": "+10000000000"
    },
    "Email": {
      "SmtpHost": "localhost",
      "SmtpPort": 1025,
      "UseSsl": false,
      "FromAddress": "dev-no-reply@localhost",
      "FromName": "ApiGateway Dev"
    },
    "App": {
      "Issuer": "ApiGateway-Dev",
      "QrCodeProviderUrl": "https://chart.googleapis.com/chart?chs=200x200&chld=M|0&cht=qr&chl="
    }
  }
}
